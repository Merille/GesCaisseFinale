@model List<EasytransitCaisse.Models.Caisse>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>Écran cuisine / bar - GesCaisse</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/vendor/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cuisine.css" asp-append-version="true" />
</head>
<body class="cui-body">
    <div class="cui-choix">
        <h2><i class="fas fa-fire-burner"></i> Écran cuisine / bar</h2>
        @if (!Model.Any())
        {
            <p>Aucune caisse de type Restaurant ou Bar. Changez le type d'une caisse dans <a href="/Caisse/Index" style="display:inline;padding:0;border:0">Caisses</a>.</p>
        }
        else
        {
            <p>Choisissez la caisse dont vous préparez les commandes :</p>
            @foreach (var c in Model)
            {
                <a href="/Cuisine/Index?caisse=@c.ID"><i class="fas @(c.TypePointVente == "Bar" ? "fa-martini-glass" : "fa-utensils")"></i> @c.ChkCode · @c.ChkDescription</a>
            }
        }
        <a href="/Auth/Accueil"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
</body>
</html>
