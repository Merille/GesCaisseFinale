@model EasytransitCaisse.Models.Client
@{
    ViewData["Title"] = "Clients";
}
<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header bg-orange text-white">
            <h4>Modification d'un tiers</h4>
        </div>
        @* <div class="card-header bg-orange bg-warning">
            <h4>Modification d'un tiers</h4>
        </div> *@

        <div class="card-body">

            <form method="post">

                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label>Code tiers</label>
                        <input name="CodeClient" value="@Model.CodeClient" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Nom société</label>
                        <input name="NomSociete" value="@Model.NomSociete" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Adresse</label>
                        <input name="Adresse" value="@Model.Adresse" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Téléphone</label>
                        <input name="Telephone" value="@Model.Telephone" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Type</label>
                        <select asp-for="Type" class="form-select">
                            <option value="">-- Choisir un type --</option>
                            <option value="Client">Client</option>
                            <option value="Fournisseur">Fournisseur</option>
                            <option value="Salarié">Salarié</option>
                            <option value="Autre">Autre</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Compte Général</label>
                        <input name="CompteGeneral" value="@Model.CompteGeneral" class="form-control"
                               placeholder="Ex: 411000" />
                    </div>

                </div>

                <hr />

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label>Nom contact</label>
                        <input name="NomContact" value="@Model.NomContact" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Fonction</label>
                        <input name="FonctionContact" value="@Model.FonctionContact" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Téléphone contact</label>
                        <input name="TelephoneContact" value="@Model.TelephoneContact" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Email contact</label>
                        <input name="EmailContact" value="@Model.EmailContact" class="form-control" />
                    </div>

                </div>

                <div class="text-end">
                    <button class="btn btn-primary">
                        Modifier
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>