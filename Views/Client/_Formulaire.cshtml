@model EasytransitCaisse.Models.Client
@* Formulaire d'un tiers (création, aussi en fenêtre modale, et modification), comme la version PHP. *@
@{
    var edition = Model.Id > 0;
    var titre = edition ? "Modifier le tiers" : "Nouveau tiers";
}
<div class="card shadow-sm border-0" style="max-width: 900px;">
    <div class="card-header bg-brand text-white"><h5 class="mb-0">@titre</h5></div>
    <div class="card-body">
        <form method="post" action="@(edition ? "/Client/Edit/" + Model.Id : "/Client/Create")">
            @Html.AntiForgeryToken()
            <h6 class="text-muted text-uppercase small mb-3">Société</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-3"><label class="form-label" for="CodeClient">Code</label><input class="form-control" id="CodeClient" name="CodeClient" value="@Model.CodeClient" required /></div>
                <div class="col-md-5"><label class="form-label" for="NomSociete">Nom de la société</label><input class="form-control" id="NomSociete" name="NomSociete" value="@Model.NomSociete" required /></div>
                <div class="col-md-4">
                    <label class="form-label" for="Type">Type</label>
                    <select class="form-select" id="Type" name="Type">
                        <option value="">--</option>
                        @foreach (var t in new[] { "Client", "Fournisseur", "Salarié", "Autre" })
                        {
                            <option selected="@(Model.Type == t)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-6"><label class="form-label" for="Adresse">Adresse</label><input class="form-control" id="Adresse" name="Adresse" value="@Model.Adresse" /></div>
                <div class="col-md-3"><label class="form-label" for="Telephone">Téléphone</label><input class="form-control" id="Telephone" name="Telephone" value="@Model.Telephone" /></div>
                <div class="col-md-3"><label class="form-label" for="Email">Email</label><input class="form-control" id="Email" name="Email" value="@Model.Email" type="email" /></div>
                <div class="col-md-3"><label class="form-label" for="CompteGeneral">Compte général (Sage)</label><input class="form-control" id="CompteGeneral" name="CompteGeneral" value="@Model.CompteGeneral" placeholder="Ex : 411000" /></div>
            </div>
            <h6 class="text-muted text-uppercase small mb-3">Contact</h6>
            <div class="row g-3">
                <div class="col-md-3"><label class="form-label" for="NomContact">Nom</label><input class="form-control" id="NomContact" name="NomContact" value="@Model.NomContact" /></div>
                <div class="col-md-3"><label class="form-label" for="FonctionContact">Fonction</label><input class="form-control" id="FonctionContact" name="FonctionContact" value="@Model.FonctionContact" /></div>
                <div class="col-md-3"><label class="form-label" for="TelephoneContact">Téléphone</label><input class="form-control" id="TelephoneContact" name="TelephoneContact" value="@Model.TelephoneContact" /></div>
                <div class="col-md-3"><label class="form-label" for="EmailContact">Email</label><input class="form-control" id="EmailContact" name="EmailContact" value="@Model.EmailContact" type="email" /></div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a href="/Client/Index" class="btn btn-outline-secondary hors-modale">Annuler</a>
            </div>
        </form>
    </div>
</div>
