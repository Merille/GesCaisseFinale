
@model List<EasytransitCaisse.Models.Client>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        ✅ @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Formulaire import caché -->
<form method="post" asp-action="Import" enctype="multipart/form-data" id="importForm">
    <input type="file" name="file" accept=".xlsx" id="importFile" style="display:none"
           onchange="document.getElementById('importForm').submit()" />
</form>
<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h3>Liste des Tiers</h3>
    </div>
    <div class="d-flex justify-content-end gap-2">
        
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-primary"
                    onclick="document.getElementById('importFile').click()">
                📤 Importer Excel
            </button>
            <a href="@Url.Action("Export")" class="btn btn-success">
                📥 Exporter Excel
            </a>
            <a href="/Client/Create" class="btn btn-primary">
                + Nouveau client
            </a>
        </div>
    </div>
    <br />

    <!-- TABLEAU -->
    <div class="card shadow-sm">
        <div class="card-body">
            <table id="clientsTable" class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Code</th>
                        <th>Société</th>
                        <th>Adresse</th>
                        <th>Contact</th>
                        <th>Fonction</th>
                        <th>Téléphone</th>
                        <th style="text-align:center;">Type</th>
                        <th style="text-align:center;">Actions</th>
                        @* <th width="180">Actions</th> *@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.CodeClient</td>
                            <td class="fw-semibold">@c.NomSociete</td>
                            <td>@c.Adresse</td>
                            <td>@c.NomContact</td>
                            <td>@c.FonctionContact</td>
                            <td>@c.Telephone</td>
                            <td style="text-align:center;">
                                @{
                                    string badgeColor = c.Type switch
                                    {
                                        "Client" => "bg-primary",   // bleu
                                        "Fournisseur" => "bg-orange",    // orange
                                        "Salarié" => "bg-success",    // vert
                                        "Autre" => "bg-danger",     // rouge
                                        _ => "bg-secondary"   // gris par défaut
                                    };
                                }
                                <span class="badge @badgeColor">@c.Type</span>
                                @* @c.Type *@
                            </td>
                            <td style="padding-left:100px;">
                                <div class="d-flex gap-1">
                                    <a href="/Client/Edit/@c.Id" class="btn btn-warning btn-sm">Modifier</a>
                                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Supprimer ce client ?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#clientsTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json'
                },
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                order: [[1, 'asc']],
                columnDefs: [
                    { orderable: false, targets: 4 }
                ],
                dom: '<"d-flex justify-content-between align-items-center mb-3"lf>rtip'
            });
        });
    </script>
}

