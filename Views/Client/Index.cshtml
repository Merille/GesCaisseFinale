
@model List<EasytransitCaisse.Models.Client>
@{
    ViewData["Title"] = "Tiers";
    var soldes = ViewBag.Soldes as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();
}

<div class="d-flex flex-wrap justify-content-end align-items-end gap-2 mb-3">
    <div class="d-flex gap-2">
        <form method="post" asp-action="Import" enctype="multipart/form-data">
            <input type="file" name="file" accept=".xlsx" id="importFile" class="d-none" onchange="this.form.submit()" />
            <button type="button" class="btn btn-outline-primary" onclick="document.getElementById('importFile').click()"><i class="fas fa-file-import"></i> Importer Excel</button>
        </form>
        <a href="/Client/Export" class="btn btn-success"><i class="fas fa-file-excel"></i> Exporter Excel</a>
        <a href="/Client/Create" class="btn btn-primary" data-modale="modal-xl"><i class="fas fa-plus"></i> Nouveau tiers</a>
    </div>
</div>
<p class="small text-muted">Import : la première ligne du fichier est un en-tête ; colonnes dans l'ordre Code, Société, Contact, Téléphone, EmailContact, Adresse, Email, Type, FonctionContact, TelephoneContact, CompteGeneral, Genre (Entreprise ou Particulier ; vide = Entreprise), EnCompte (Oui ou Non), PlafondCredit (vide = sans plafond). Le plus simple est de partir d'un export.</p>
<div class="card shadow-sm border-0">
    <div class="card-body table-responsive">
        <table id="clientsTable" class="table table-hover align-middle mb-0">
            <thead class="table-dark"><tr><th>Code</th><th>Nom</th><th>Genre</th><th>Adresse</th><th>Contact</th><th>Téléphone</th><th class="text-center">Type</th><th class="text-end">Solde dû</th><th class="text-center">Actions</th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var badge = c.Type switch { "Client" => "bg-primary", "Fournisseur" => "bg-orange", "Salarié" => "bg-success", "Autre" => "bg-danger", _ => "bg-secondary" };
                    <tr>
                        <td>@c.CodeClient</td>
                        <td class="fw-semibold">@c.NomSociete</td>
                        <td class="text-nowrap"><i class="fas @(c.Genre == "Particulier" ? "fa-user" : "fa-building") text-muted me-1"></i>@c.Genre</td>
                        <td>@c.Adresse</td>
                        <td>@c.NomContact@if (!string.IsNullOrEmpty(c.FonctionContact))
                            {
                                <small class="d-block text-muted">@c.FonctionContact</small>
                            }</td>
                        <td>@c.Telephone</td>
                        <td class="text-center">@if (!string.IsNullOrEmpty(c.Type))
                            {
                                <span class="badge @badge">@c.Type</span>
                            }</td>
                        @{ var du = soldes.GetValueOrDefault(c.Id); }
                        <td class="text-end text-nowrap" data-order="@(c.EnCompte ? du.ToString(System.Globalization.CultureInfo.InvariantCulture) : "-1000000000000000")">@if (c.EnCompte)
                            {
                                <span class="badge text-bg-light border"><i class="fas fa-address-book"></i> En compte</span>
                                <div class="fw-semibold @(du > 0 ? "text-danger" : "")">@du.ToString("N0")</div>
                                @if (c.PlafondCredit.HasValue)
                                {
                                    <small class="text-muted">plafond @c.PlafondCredit.Value.ToString("N0")</small>
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }</td>
                        <td class="text-center table-actions">
                            <a href="/Client/Edit/@c.Id" class="btn btn-warning btn-sm" data-modale="modal-xl">Modifier</a>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" onsubmit="return confirm('Supprimer ce tiers ?');">
                                <button class="btn btn-danger btn-sm">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#clientsTable').DataTable({
                language: {
                    url: '/vendor/datatables/fr-FR.json'
                },
                pageLength: 20,
                lengthMenu: [20, 50, 100],
                order: [[1, 'asc']],
                columnDefs: [
                    { orderable: false, targets: 7 }  // colonne Actions
                ],
                dom: '<"d-flex justify-content-between align-items-center mb-3"lf>rtip'
            });
        });
    </script>
}

