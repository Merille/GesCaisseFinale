@model EasytransitCaisse.Models.Client
@{
    ViewData["Title"] = "Clients";
}
<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header bg-orange text-white">
            <h4>Création d'un Tiers</h4>
        </div>

        <div class="card-body">

            <form method="post" asp-action="Create" asp-controller="Client">

                <h5 class="mb-3">🏢 Société</h5>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label>Code tiers (*)</label>
                        <input name="CodeClient" class="form-control" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Nom société (*)</label>
                        <input name="NomSociete" class="form-control" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Adresse</label>
                        <input name="Adresse" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Téléphone</label>
                        <input name="Telephone" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Email</label>
                        <input name="Email" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Type</label>
                        <select name="Type" class="form-select">
                            <option value="">-- Choisir un type --</option>
                            <option value="Client">Client</option>
                            <option value="Fournisseur">Fournisseur</option>
                            <option value="Salarié">Salarié</option>
                            <option value="Autre">Autre</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Compte Général</label>
                        <input name="CompteGeneral" class="form-control" placeholder="Ex: 411000" />
                    </div>

                </div>

                <hr />

                <h5 class="mb-3">👤 Interlocuteur</h5>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label>Nom contact</label>
                        <input name="NomContact" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Fonction</label>
                        <input name="FonctionContact" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Téléphone contact</label>
                        <input name="TelephoneContact" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Email contact</label>
                        <input name="EmailContact" class="form-control" />
                    </div>

                </div>

                <div class="text-end">
                    <button class="btn btn-success">
                        Enregistrer
                    </button>
                    
                    @* <button class="btn btn-primary">
                        <a style="color:white;" href="/Client/Index"><i class="fas fa-users"></i> Liste des clients</a>
                    </button> *@
                    <br />
                    <a style="text-align: center;" class="nav-link" href="/Client/Index">
                        <i class="fas fa-users"></i>
                        Liste des Clients
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>