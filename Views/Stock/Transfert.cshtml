@model List<EasytransitCaisse.Models.Produit>
@using System.Globalization
@{
    ViewData["Title"] = "Transfert entre dépôts";
    var depots = (List<EasytransitCaisse.Models.Depot>)ViewBag.Depots;
    var depart = (int)ViewBag.Depart;
    var quantites = (Dictionary<int, decimal>)ViewBag.Quantites;
    var fr = CultureInfo.GetCultureInfo("fr-FR");
    var premier = true;
}

<partial name="_Onglets" model="@("Transfert")" />

@if (depots.Count < 2)
{
    <div class="alert alert-info">Un transfert demande au moins deux dépôts actifs. Créez-les dans <a href="/Depot/Index">Paramètres › Dépôts</a>.</div>
}
else if (!Model.Any())
{
    <div class="alert alert-info">Aucun produit avec suivi de stock. Cochez « Suivre le stock » dans la fiche d'un produit.</div>
}
else
{
    <form method="post" asp-action="Transfert" class="card border-0 shadow-sm">
        <div class="card-header bg-brand text-white">Marchandises transférées</div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-6"><label class="form-label" for="depart">Dépôt de départ</label>
                    <select class="form-select" id="depart" name="depart" required onchange="window.location.href = '/Stock/Transfert?depot=' + this.value">
                        @foreach (var d in depots)
                        {
                            <option value="@d.Id" selected="@(depart == d.Id)">@d.Code · @d.Nom</option>
                        }
                    </select></div>
                <div class="col-md-6"><label class="form-label" for="arrivee">Dépôt d'arrivée</label>
                    <select class="form-select" id="arrivee" name="arrivee" required>
                        @foreach (var d in depots.Where(d => d.Id != depart))
                        {
                            <option value="@d.Id" selected="@premier">@d.Code · @d.Nom</option>
                            premier = false;
                        }
                    </select></div>
                <div class="col-md-5"><label class="form-label" for="reference">Référence</label><input class="form-control" id="reference" name="reference" placeholder="Vide : TRF-date-heure" /></div>
                <div class="col-md-7"><label class="form-label" for="commentaire">Commentaire</label><input class="form-control" id="commentaire" name="commentaire" placeholder="Ex : réassort de la boutique" /></div>
            </div>
            <table class="table align-middle" id="lignesTransfert">
                <thead><tr><th>Produit</th><th style="width:160px">Quantité</th><th style="width:50px"></th></tr></thead>
                <tbody>
                    @for (var i = 0; i < 5; i++)
                    {
                        <tr>
                            <td>
                                <select class="form-select" name="produit" aria-label="Produit">
                                    <option value="0">-- Produit --</option>
                                    @foreach (var p in Model)
                                    {
                                        <option value="@p.Id">@p.Code · @p.Nom (dans le dépôt de départ : @quantites.GetValueOrDefault(p.Id).ToString("#,0.##", fr))</option>
                                    }
                                </select>
                            </td>
                            <td><input class="form-control text-end" name="qte" inputmode="decimal" aria-label="Quantité transférée" /></td>
                            <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('tr').remove()" aria-label="Retirer la ligne"><i class="fas fa-xmark"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="ajouterLigne"><i class="fas fa-plus"></i> Ajouter une ligne</button>
        </div>
        <div class="card-footer bg-white d-flex gap-2">
            <button class="btn btn-success"><i class="fas fa-check"></i> Enregistrer le transfert</button>
            <a href="/Stock/Index" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>
}

@section Scripts {
    <script>
        const bouton = document.getElementById('ajouterLigne');
        if (bouton) bouton.addEventListener('click', function () {
            const corps = document.querySelector('#lignesTransfert tbody');
            const ligne = corps.rows[0].cloneNode(true);
            ligne.querySelector('select').value = '0';
            ligne.querySelector('input').value = '';
            corps.appendChild(ligne);
        });
    </script>
}
