@model EasytransitCaisse.Models.Utilisateur
@{
    ViewData["Title"] = "Utilisateurs";
}
<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header bg-warning">
            <h4 class="mb-0">Modifier utilisateur</h4>
        </div>

        <div class="card-body">

            <form method="post">

                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nom utilisateur</label>
                        <input name="NomUtilisateur"
                               value="@Model.NomUtilisateur"
                               class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nom complet</label>
                        <input name="NomComplet"
                               value="@Model.NomComplet"
                               class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Profil</label>
                        <select name="Profil" class="form-select">
                            <option value="Admin" selected="@(Model.Profil == "Admin")">Admin</option>
                            <option value="Caissier" selected="@(Model.Profil == "Caissier")">Caissier</option>
                            <option value="Vendeur" selected="@(Model.Profil == "Vendeur")">Vendeur</option>
                            @if (Model.Profil == "SuperAdmin")
                            {
                                <option value="SuperAdmin" selected>SuperAdmin</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Mot de passe (optionnel)</label>
                        <input type="password" name="MotPasse" class="form-control" />
                    </div>

                    @if ((bool)(ViewBag.IsSuperAdmin ?? false))
                    {
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Société</label>
                            <select name="TenantId" class="form-select">
                                <option value="" selected="@(Model.TenantId == null)">-- Aucune (SuperAdmin) --</option>
                                @foreach (var t in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Tenants)
                                {
                                    <option value="@t.Value" selected="@(t.Value == Model.TenantId.ToString())">@t.Text</option>
                                }
                            </select>
                        </div>
                    }

                </div>

                <div class="mt-2 mb-3">
                    <label class="form-label fw-bold">Droits</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="true"
                               name="PeutValiderOperations" id="peutValiderEdit"
                               checked="@Model.PeutValiderOperations">
                        <label class="form-check-label" for="peutValiderEdit">
                            Peut valider / rejeter les opérations de caisse
                        </label>
                    </div>
                </div>

                <div class="text-end">
                    <button class="btn btn-primary">
                        Modifier
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>