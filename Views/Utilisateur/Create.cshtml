@model EasytransitCaisse.Models.Utilisateur
@{
    ViewData["Title"] = "Utilisateurs";
}
<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Créer un utilisateur</h4>
        </div>

        <div class="card-body">

            <form method="post">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nom utilisateur</label>
                        <input name="NomUtilisateur" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nom complet</label>
                        <input name="NomComplet" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Profil</label>
                        <select name="Profil" class="form-select">
                            <option value="Admin">Admin</option>
                            <option value="Caissier">Caissier</option>
                            <option value="Vendeur">Vendeur</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Mot de passe</label>
                        <input type="password" name="MotPasse" class="form-control" />
                    </div>

                    @if ((bool)(ViewBag.IsSuperAdmin ?? false))
                    {
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Société</label>
                            <select name="TenantId" class="form-select">
                                <option value="">-- Aucune (SuperAdmin) --</option>
                                @foreach (var t in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Tenants)
                                {
                                    <option value="@t.Value">@t.Text</option>
                                }
                            </select>
                        </div>
                    }

                </div>

                <div class="mt-2 mb-3">
                    <label class="form-label fw-bold">Droits</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="true"
                               name="PeutValiderOperations" id="peutValiderCreate">
                        <label class="form-check-label" for="peutValiderCreate">
                            Peut valider / rejeter les opérations de caisse
                        </label>
                    </div>
                </div>

                <div class="text-end">
                    <button class="btn btn-success">
                        Enregistrer
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>