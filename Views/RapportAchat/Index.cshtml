@model EasytransitCaisse.Models.ViewModels.RapportAchatVM
@using EasytransitCaisse.Models.ViewModels
@{
    ViewData["Title"] = "Rapport des achats";
    var f = Model.Filtres;
    var t = Model.Total;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string Fcfa(decimal n) => RapportAchatVM.Fcfa(n);
    string Qte(decimal n) => RapportAchatVM.Qte(n);
    var cartes = new (string Libelle, decimal Valeur, string Icone, bool Montant)[]
    {
        ("Achats", t.Nombre, "fa-cart-flatbed", false), ("Montant des achats", t.Montant, "fa-coins", true), ("Réglé", t.Regle, "fa-hand-holding-dollar", true),
        ("Reste à payer", t.Reste, "fa-hourglass-half", true), ("Valeur consommée", Model.ValeurConsommee, "fa-bottle-droplet", true)
    };
    string Badge(string s) => s switch { "Annulé" => "bg-secondary", "Non soldé" => "bg-warning text-dark", _ => "bg-success" };
}
<form method="get" action="/RapportAchat/Index" class="card shadow-sm border-0 mb-3">
    <div class="card-body d-flex flex-wrap align-items-end gap-3">
        <div><label class="form-label small fw-semibold text-muted mb-1" for="du">Achats du</label><input type="date" class="form-control" id="du" name="du" value="@f.Du.ToString("yyyy-MM-dd")"></div>
        <div><label class="form-label small fw-semibold text-muted mb-1" for="au">Au</label><input type="date" class="form-control" id="au" name="au" value="@f.Au.ToString("yyyy-MM-dd")"></div>
        <div>
            <label class="form-label small fw-semibold text-muted mb-1" for="fournisseur">Fournisseur</label>
            <select class="form-select" id="fournisseur" name="fournisseur">
                <option value="">Tous</option>
                @foreach (var fo in Model.Fournisseurs)
                {
                    <option value="@fo.Id" selected="@(f.Fournisseur == fo.Id)">@fo.NomSociete</option>
                }
            </select>
        </div>
        <button class="btn btn-primary"><i class="fa fa-search"></i> Filtrer</button>
        <div class="ms-auto d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary" href="/RapportAchat/Imprimer?@f.Requete" target="_blank"><i class="fa fa-print"></i> Imprimer / PDF</a>
            <a class="btn btn-success" href="/RapportAchat/Excel?@f.Requete"><i class="fa fa-file-excel"></i> Exporter Excel</a>
        </div>
    </div>
</form>
<p class="small text-muted">@f.Periode.</p>

<div class="row g-3 mb-3">
    @foreach (var c in cartes)
    {
        <div class="col-6 col-lg"><div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="small text-muted"><i class="fa @c.Icone"></i> @c.Libelle</div>
            <div class="fs-5 fw-bold@(c.Libelle == "Reste à payer" && c.Valeur > 0 ? " text-danger" : "")">@if (c.Montant) {<text>@Fcfa(c.Valeur) <small class="fs-6 fw-normal text-muted">FCFA</small></text>} else {@((int)c.Valeur)}</div>
        </div></div></div>
    }
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-header bg-white fw-semibold">Par fournisseur</div>
    <div class="card-body table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark"><tr><th>Fournisseur</th><th class="text-end">Achats</th><th class="text-end">Montant</th><th class="text-end">Réglé</th><th class="text-end">Reste à payer</th></tr></thead>
            <tbody>
                @foreach (var (nom, s) in Model.ParFournisseur)
                {
                    <tr><td>@nom</td><td class="text-end">@s.Nombre</td><td class="text-end text-nowrap">@Fcfa(s.Montant)</td>
                        <td class="text-end text-nowrap">@Fcfa(s.Regle)</td><td class="text-end text-nowrap fw-semibold@(s.Reste > 0 ? " text-danger" : "")">@Fcfa(s.Reste)</td></tr>
                }
                @if (!Model.ParFournisseur.Any())
                {
                    <tr><td colspan="5" class="text-muted">Aucun achat sur la période.</td></tr>
                }
            </tbody>
            <tfoot><tr class="table-light fw-bold"><td>Total (hors annulés)</td><td class="text-end">@t.Nombre</td><td class="text-end text-nowrap">@Fcfa(t.Montant)</td>
                <td class="text-end text-nowrap">@Fcfa(t.Regle)</td><td class="text-end text-nowrap">@Fcfa(t.Reste)</td></tr></tfoot>
        </table>
    </div>
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-header bg-white fw-semibold">Par produit : achats et consommations</div>
    <div class="card-body table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark"><tr><th>Produit</th><th class="text-end">Qté achetée</th><th class="text-end">Montant acheté</th><th class="text-end">Prix moyen</th>
                <th class="text-end">Qté consommée</th><th class="text-end">Valeur consommée</th><th class="text-end">Stock</th></tr></thead>
            <tbody>
                @foreach (var p in Model.Produits)
                {
                    <tr><td>@p.Code · @p.Nom</td>
                        <td class="text-end text-nowrap">@if (p.QteAchetee != 0) {@(Qte(p.QteAchetee) + " " + p.Unite)} else {<span class="text-muted">—</span>}</td>
                        <td class="text-end text-nowrap">@if (p.MontantAchete != 0) {@Fcfa(p.MontantAchete)} else {<span class="text-muted">—</span>}</td>
                        <td class="text-end text-nowrap">@if (p.PrixMoyen.HasValue) {@Qte(p.PrixMoyen.Value)} else {<span class="text-muted">—</span>}</td>
                        <td class="text-end text-nowrap">@if (p.QteConsommee != 0) {@(Qte(p.QteConsommee) + " " + p.Unite)} else {<span class="text-muted">—</span>}</td>
                        <td class="text-end text-nowrap">@if (p.ValeurConsommee != 0) {@Fcfa(p.ValeurConsommee)} else {<span class="text-muted">—</span>}</td>
                        <td class="text-end text-nowrap fw-semibold">@Qte(p.Stock) @p.Unite</td></tr>
                }
                @if (!Model.Produits.Any())
                {
                    <tr><td colspan="7" class="text-muted">Aucun achat ni consommation sur la période.</td></tr>
                }
            </tbody>
            <tfoot><tr class="table-light fw-bold"><td>Total</td><td></td><td class="text-end text-nowrap">@Fcfa(Model.MontantAchete)</td><td></td><td></td>
                <td class="text-end text-nowrap">@Fcfa(Model.ValeurConsommee)</td><td></td></tr></tfoot>
        </table>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white fw-semibold">Détail des achats</div>
    <div class="card-body table-responsive">
        <table id="rapportAchatsTable" class="table table-hover align-middle mb-0 small">
            <thead class="table-dark"><tr><th>N°</th><th>Date</th><th>Fournisseur</th><th>Référence</th><th class="text-end">Montant</th><th class="text-end">Réglé</th><th class="text-end">Reste</th><th>Statut</th></tr></thead>
            <tbody>
                @foreach (var l in Model.Achats)
                {
                    var a = l.Achat;
                    <tr class="@(l.Statut == "Annulé" ? "text-muted" : "")">
                        <td class="fw-semibold" data-order="@a.Numero"><a href="/Achat/Details/@a.Id">@a.Numero</a></td>
                        <td class="text-nowrap" data-order="@(a.DateAchat.ToString("yyyy-MM-dd") + a.Numero.ToString("D8"))">@a.DateAchat.ToString("dd/MM/yyyy")</td>
                        <td>@l.Fournisseur</td><td>@a.Reference</td>
                        <td class="text-end text-nowrap" data-order="@a.Total.ToString(inv)">@Fcfa(a.Total)</td>
                        <td class="text-end text-nowrap" data-order="@l.Regle.ToString(inv)">@Fcfa(l.Regle)</td>
                        <td class="text-end text-nowrap fw-semibold" data-order="@l.Reste.ToString(inv)">@if (l.Reste > 0) {@Fcfa(l.Reste)} else {<span class="text-muted">—</span>}</td>
                        <td><span class="badge @Badge(l.Statut)">@l.Statut</span></td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="small text-muted mt-2 mb-0">Les totaux ne comptent pas les achats annulés. Réglé : règlements de l'achat, quelle que soit leur date.
            Consommations : sorties de la période, valorisées au coût actuel du produit (coût moyen pondéré) ; avec un fournisseur choisi, seuls ses produits sont présentés.
            Stock : quantité actuelle dans le dépôt des achats.</p>
    </div>
</div>

@section Scripts {
    <script>
        $('#rapportAchatsTable').DataTable({
            language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json' },
            pageLength: 20,
            lengthMenu: [20, 50, 100],
            order: [[1, 'desc']],
            dom: '<"d-flex justify-content-between align-items-center mb-3"lf>rtip'
        });
    </script>
}
