@model List<EasytransitCaisse.Models.UniteVente>
@{
    ViewData["Title"] = "Unités de vente";
    var nbProduits = (Dictionary<(int, string), int>)ViewBag.NbProduits;
}

<partial name="_Messages" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Unités de vente</h4>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalUnite" data-id="" data-actif="1">
        <i class="fas fa-plus"></i> Nouvelle unité
    </button>
</div>
<p class="small text-muted">
    L'unité indique ce que représente le prix d'un produit (ex. 1 Kg, 1 Litre, 1 Carton) ; elle s'affiche sur le ticket.
    Une unité désactivée n'est plus proposée sur la fiche produit mais reste sur les produits qui l'utilisent. Renommer une unité met à jour ses produits.
</p>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <table id="unitesTable" class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Unité</th>
                    <th>Libellé</th>
                    <th class="text-center">Produits</th>
                    <th class="text-center">Statut</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr class="@(u.Actif ? "" : "text-muted")">
                        <td class="fw-semibold">@u.Nom</td>
                        <td>@u.Libelle</td>
                        <td class="text-center">@(nbProduits.TryGetValue((u.TenantId, u.Nom.ToLowerInvariant()), out var n) ? n : 0)</td>
                        <td class="text-center">
                            @if (u.Actif)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="d-inline-flex gap-1">
                                <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#modalUnite"
                                        data-id="@u.Id" data-nom="@u.Nom" data-libelle="@u.Libelle" data-actif="@(u.Actif ? "1" : "0")">Modifier</button>
                                <form asp-action="Basculer" asp-route-id="@u.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(u.Actif ? "btn-outline-secondary" : "btn-success")">@(u.Actif ? "Désactiver" : "Activer")</button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Supprimer cette unité ?')">
                                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalUnite" tabindex="-1" aria-labelledby="uniteTitre" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" method="post" asp-action="Save">
            <div class="modal-header bg-brand text-white">
                <h5 class="modal-title" id="uniteTitre">Unité</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="Id" id="uniteId" value="0" />
                <div class="row g-3">
                    <div class="col-5">
                        <label class="form-label" for="uniteNom">Unité</label>
                        <input id="uniteNom" name="Nom" class="form-control" placeholder="Ex : Kg" maxlength="20" required />
                    </div>
                    <div class="col-7">
                        <label class="form-label" for="uniteLibelle">Libellé</label>
                        <input id="uniteLibelle" name="Libelle" class="form-control" placeholder="Ex : Kilogramme" maxlength="100" />
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="true" name="Actif" id="uniteActif" />
                            <input type="hidden" name="Actif" value="false" />
                            <label class="form-check-label" for="uniteActif">Active (proposée sur la fiche produit)</label>
                        </div>
                    </div>
                </div>
                <div class="form-text mt-3">Le nom court (20 caractères au plus) s'affiche sur le ticket, ex. « 2 Kg x 1 500 ».</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Ordre du serveur conservé (actives d'abord) ; tri possible par colonne.
            $('#unitesTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json'
                },
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                order: [],
                columnDefs: [
                    { orderable: false, targets: 4 }
                ],
                dom: '<"d-flex justify-content-between align-items-center mb-3"lf>rtip'
            });
        });

        document.getElementById('modalUnite').addEventListener('show.bs.modal', function (e) {
            const d = e.relatedTarget ? e.relatedTarget.dataset : {};
            document.getElementById('uniteTitre').textContent = d.id ? "Modifier l'unité" : 'Nouvelle unité';
            document.getElementById('uniteId').value = d.id || '0';
            document.getElementById('uniteNom').value = d.nom || '';
            document.getElementById('uniteLibelle').value = d.libelle || '';
            document.getElementById('uniteActif').checked = d.actif === '1';
        });
    </script>
}
