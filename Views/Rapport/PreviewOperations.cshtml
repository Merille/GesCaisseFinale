@model EasytransitCaisse.Models.ViewModels.RapportOperationsVM
@using EasytransitCaisse.Data
@{
    Layout = "_ImpressionLayout";
    ViewData["Pdf"] = false;
    ViewData["TitreImpression"] = "Rapport des opérations";
}
<h1>Rapport des opérations</h1>
<p class="muted">
    Période : @(Model.DateDebut?.ToString("dd/MM/yyyy") ?? "début") au @(Model.DateFin?.ToString("dd/MM/yyyy") ?? "aujourd'hui")
    — Caisse : @(Model.CaisseLibelle ?? "toutes")
    — Type : @(string.IsNullOrEmpty(Model.TypeOperation) ? "tous" : Model.TypeOperation)
</p>
<table>
    <tr><th>Date</th><th>Journée</th><th>Type</th><th>Libellé</th><th>Tiers</th><th>Caissier</th><th class="r">Montant</th></tr>
    @foreach (var o in Model.Operations)
    {
        <tr>
            <td>@o.DateOperation.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@o.JourneeCaisse?.NumeroJournee</td>
            <td>@o.TypeOperation</td>
            <td>@o.Libelle</td>
            <td>@o.Client?.NomSociete</td>
            <td>@o.Utilisateur?.NomComplet</td>
            <td class="r">@if (o.StatutValidation == OperationCaisseQueries.StatutRejete)
            {<s>@o.Montant.ToString("N0")</s> @:(rejetée)
            }
            else
            {@o.Montant.ToString("N0")}</td>
        </tr>
    }
    <tr class="total"><td colspan="6">Total encaissements</td><td class="r">@Model.TotalEntrees.ToString("N0")</td></tr>
    <tr class="total"><td colspan="6">Total décaissements</td><td class="r">@Model.TotalSorties.ToString("N0")</td></tr>
    <tr class="total"><td colspan="6">Solde de la période</td><td class="r">@((Model.TotalEntrees - Model.TotalSorties).ToString("N0"))</td></tr>
    <tr class="total"><td colspan="6">Montant initial des journées</td><td class="r">@Model.MontantInitialJournees.ToString("N0")</td></tr>
    <tr class="total"><td colspan="6">Solde en caisse</td><td class="r">@((Model.MontantInitialJournees + Model.TotalEntrees - Model.TotalSorties).ToString("N0"))</td></tr>
</table>
<p class="muted">Les opérations rejetées sont listées mais exclues des totaux.</p>
