@model EasytransitCaisse.Models.ViewModels.RapportOperationsVM

@{
    ViewData["Title"] = "Rapport des opérations";
}

<div class="card shadow">

    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">
            Rapport des opérations
        </h4>
    </div>

    <div class="card-body">

        <form method="get">

            <div class="row">

                <div class="col-md-2">
                    <label>Date début</label>
                    <input type="date"
                           name="dateDebut"
                           value="@Model.DateDebut?.ToString("yyyy-MM-dd")"
                           class="form-control"/>
                </div>

                <div class="col-md-2">
                    <label>Date fin</label>
                    <input type="date"
                           name="dateFin"
                           value="@Model.DateFin?.ToString("yyyy-MM-dd")"
                           class="form-control"/>
                </div>

                <div class="col-md-3">
                    <label>Caisse</label>

                    <select class="form-select"
                            name="caisseId"
                            asp-items="ViewBag.Caisses">

                        <option value="">Toutes</option>

                    </select>

                </div>

                <div class="col-md-3">

                    <label>Type</label>

                    <select class="form-select"
                            name="typeOperation">

                        <option value="">Toutes</option>

                        <option value="Encaissement">
                            Encaissement
                        </option>

                        <option value="Décaissement">
                            Décaissement
                        </option>

                    </select>

                </div>

                <div class="col-md-2 d-grid">

                    <label>&nbsp;</label>

                    <button class="btn btn-primary">

                        Rechercher

                    </button>

                </div>

            </div>

        </form>

        <hr />

        <div class="mb-3">

            <a class="btn btn-success"
               target="_blank"
               asp-action="PreviewOperations"
               asp-route-dateDebut="@Model.DateDebut?.ToString("yyyy-MM-dd")"
               asp-route-dateFin="@Model.DateFin?.ToString("yyyy-MM-dd")"
               asp-route-caisseId="@Model.CaisseId"
               asp-route-typeOperation="@Model.TypeOperation">

                <i class="fa fa-print"></i>

                Aperçu / Imprimer

            </a>

            <a class="btn btn-outline-success"
               asp-action="ExportSage"
               asp-route-dateDebut="@Model.DateDebut?.ToString("yyyy-MM-dd")"
               asp-route-dateFin="@Model.DateFin?.ToString("yyyy-MM-dd")"
               asp-route-caisseId="@Model.CaisseId"
               asp-route-typeOperation="@Model.TypeOperation">

                <i class="fa fa-file-excel"></i>

                Exporter vers Sage (Excel)

            </a>

        </div>

        <table class="table table-bordered table-hover">

            <thead class="table-dark">

            <tr>

                <th>Date</th>

                <th>Journée</th>

                <th>Type</th>

                <th>Libellé</th>

                <th>Tiers</th>

                <th>Caissier</th>

                <th class="text-end">

                    Montant

                </th>

            </tr>

            </thead>

            <tbody>

            @foreach(var item in Model.Operations)
            {

                <tr>

                    <td>

                        @item.DateOperation.ToString("dd/MM/yyyy HH:mm")

                    </td>

                    <td>

                        @item.JourneeCaisse.NumeroJournee

                    </td>

                    <td>

                        @item.TypeOperation

                    </td>

                    <td>

                        @item.Libelle

                    </td>

                    <td>

                        @(item.Client?.NomSociete ?? "")

                    </td>

                    <td>

                        @item.Utilisateur.NomComplet

                    </td>

                    <td class="text-end">

                        @item.Montant.ToString("N0")

                    </td>

                </tr>

            }

            </tbody>

            <tfoot>

                <tr class="table-success">

                    <th colspan="6">

                        Total Encaissements

                    </th>

                    <th class="text-end">

                        @Model.TotalEntrees.ToString("N0")

                    </th>

                </tr>

                <tr class="table-danger">

                    <th colspan="6">

                        Total Décaissements

                    </th>

                    <th class="text-end">

                        @Model.TotalSorties.ToString("N0")

                    </th>

                </tr>

                <tr class="table-primary">

                    <th colspan="6">

                        Solde

                    </th>

                    <th class="text-end">

                        @((Model.TotalEntrees-Model.TotalSorties).ToString("N0"))

                    </th>

                </tr>

                <tr class="table-warning">

                    <th colspan="6">
                        Montant initial des journées
                    </th>

                    <th class="text-end">
                        @Model.MontantInitialJournees.ToString("N0")
                    </th>

                </tr>
                <tr class="table-info">

                    <th colspan="6">
                        Solde théorique
                    </th>

                    <th class="text-end">
                        @((Model.MontantInitialJournees + Model.TotalEntrees - Model.TotalSorties).ToString("N0"))
                    </th>

                </tr>
            </tfoot>

        </table>

    </div>

</div>