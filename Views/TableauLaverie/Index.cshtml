@model EasytransitCaisse.Models.ViewModels.TableauLaverieVM
@using EasytransitCaisse.Services
@{
    ViewData["Title"] = "Tableau de bord laverie";
    var fr = System.Globalization.CultureInfo.GetCultureInfo("fr-FR");
    string Fcfa(decimal n) => n.ToString("N0", fr);
    string Qte(decimal n) => n.ToString("0.##", fr);
    string S(decimal n) => n > 1 ? "s" : "";
    var admin = User.HasClaim(AppClaimTypes.Profil, "Admin") || User.HasClaim(AppClaimTypes.Profil, "SuperAdmin");
    var aujourdhui = DateTime.Today;
    var jour = aujourdhui.ToString("yyyy-MM-dd");
    var lundi = aujourdhui.AddDays(-(((int)aujourdhui.DayOfWeek + 6) % 7));
    var joursRetard = Model.PlusAncienRetard.HasValue ? (int)(aujourdhui - Model.PlusAncienRetard.Value.Date).TotalDays : 0;
    string Rapport(string requete) => "/RapportLinge/Index" + requete;
    var top = Model.TopArticles.Count > 0 ? Model.TopArticles[0] : default;
    var tuiles = new (string Couleur, string Icone, string Titre, Microsoft.AspNetCore.Html.IHtmlContent Corps, string? Href)[]
    {
        ("lav-bleu", "fa-shirt", "Dépôts", Html.Raw($"<div class=\"lav-grand\">{Model.DepotsJour} <small>aujourd'hui</small></div>"
            + $"<div class=\"lav-ligne\"><b>{Qte(Model.ArticlesJour)}</b> article{S(Model.ArticlesJour)} · <b>{Fcfa(Model.MontantJour)}</b> FCFA</div>"
            + $"<div class=\"lav-ligne\">Cette semaine : <b>{Model.DepotsSemaine}</b></div>"),
            admin ? Rapport($"?du={jour}&au={jour}") : "/Pos/Index"),
        ("lav-ciel", "fa-hand-holding", "Retraits", Html.Raw($"<div class=\"lav-grand\">{Model.RetraitsJour} <small>aujourd'hui</small></div>"
            + $"<div class=\"lav-ligne\">Encaissé : <b>{Fcfa(Model.MontantRetraitsJour)}</b> FCFA</div>"
            + $"<div class=\"lav-ligne\">Cette semaine : <b>{Model.RetraitsSemaine}</b></div>"),
            admin ? Rapport($"?du={lundi:yyyy-MM-dd}&au={jour}&statut={Uri.EscapeDataString("Retiré")}") : null),
        ("lav-indigo", "fa-box-open", "À retirer", Html.Raw($"<div class=\"lav-grand\">{Model.ARetirer} <small>dépôt{S(Model.ARetirer)}</small></div>"
            + $"<div class=\"lav-ligne\">dont <b>{Model.Prets}</b> prêt{S(Model.Prets)} à remettre</div>"
            + $"<div class=\"lav-ligne\">Reste à encaisser : <b>{Fcfa(Model.Reste)}</b> FCFA</div>"),
            admin ? Rapport($"?statut={Uri.EscapeDataString("À retirer")}") : "/Pos/Index"),
        (Model.Retard > 0 ? "lav-rouge" : "lav-ardoise", "fa-triangle-exclamation", "En retard", Html.Raw($"<div class=\"lav-grand\">{Model.Retard} <small>dépôt{S(Model.Retard)}</small></div>"
            + (Model.Retard > 0
                ? $"<div class=\"lav-ligne\">Le plus ancien : <b>{joursRetard} jour{S(joursRetard)}</b> de retard</div><div class=\"lav-ligne\">Reste à encaisser : <b>{Fcfa(Model.ResteRetard)}</b> FCFA</div>"
                : "<div class=\"lav-ligne\">Aucun linge en retard.</div>")),
            admin ? Rapport($"?statut={Uri.EscapeDataString("En retard")}") : null),
        ("lav-violet", "fa-users", "Clients", Html.Raw($"<div class=\"lav-grand\">{Model.ClientsMois} <small>servi{S(Model.ClientsMois)} ce mois</small></div>"
            + $"<div class=\"lav-ligne\">Fiches clients : <b>{Model.ClientsTotal}</b></div>"
            + $"<div class=\"lav-ligne\">Dû (clients en compte) : <b>{Fcfa(Model.Du)}</b> FCFA</div>"),
            "/Client/Index"),
        ("lav-vert", "fa-tags", "Articles", Html.Raw($"<div class=\"lav-grand\">{Model.Articles} <small>en vente</small></div>"
            + $"<div class=\"lav-ligne\"><b>{Model.Categories}</b> catégorie{S(Model.Categories)}</div>"
            + "<div class=\"lav-ligne\">" + (Model.TopArticles.Count > 0 ? $"Le plus déposé ce mois : <b>{System.Net.WebUtility.HtmlEncode(top.Nom)}</b> ({Qte(top.Qte)})" : "Aucun dépôt ce mois.") + "</div>"),
            admin ? "/Produit/Index" : null),
        ("lav-ambre", "fa-bottle-droplet", "Produits d'entretien", Html.Raw($"<div class=\"lav-grand\">{Model.ARacheter} <small>à racheter</small></div>"
            + $"<div class=\"lav-ligne\">Valeur du stock : <b>{Fcfa(Model.ValeurEntretien)}</b> FCFA</div>"
            + $"<div class=\"lav-ligne\">Achats du mois : <b>{Fcfa(Model.AchatsMois)}</b> FCFA</div>"),
            admin ? "/Achat/Stock" : null),
        ("lav-rose", "fa-cash-register", "Caisse", Html.Raw($"<div class=\"lav-grand\">{Fcfa(Model.Encaissements)} <small>FCFA encaissés</small></div>"
            + "<div class=\"lav-ligne\">aujourd'hui (ventes, retraits, acomptes)</div>"
            + "<div class=\"lav-ligne\">" + (Model.Journees.Count > 0 ? $"Journée ouverte : <b>{System.Net.WebUtility.HtmlEncode(string.Join(", ", Model.Journees.Select(j => j.Code)))}</b>" : "Aucune journée ouverte") + "</div>"),
            Model.Journees.Count > 0 ? $"/JourneeCaisse/Details/{Model.Journees[0].Id}" : "/Caisse/Index"),
    };
}
<link rel="stylesheet" href="~/css/laverie.css" asp-append-version="true" />

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div class="text-muted small">Laverie · @aujourdhui.ToString("dd/MM/yyyy") · semaine du @lundi.ToString("dd/MM/yyyy")</div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" href="/Pos/Index"><i class="fas fa-store"></i> Vendre / déposer</a>
        @if (admin)
        {
            <a class="btn btn-outline-primary" href="/RapportLinge/Index"><i class="fas fa-chart-line"></i> Rapport des dépôts</a>
        }
    </div>
</div>

<div class="lav-tuiles mb-4" id="lavTuiles">
    @foreach (var t in tuiles)
    {
        var contenu = Html.Raw($"<span class=\"lav-icone\"><i class=\"fas {t.Icone}\"></i></span>");
        if (t.Href != null)
        {
            <a href="@t.Href" class="lav-tuile @t.Couleur">@contenu<div><h3>@t.Titre</h3>@t.Corps</div></a>
        }
        else
        {
            <div class="lav-tuile @t.Couleur">@contenu<div><h3>@t.Titre</h3>@t.Corps</div></div>
        }
    }
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="lav-carte">
            <h4>Dépôts et retraits des 14 derniers jours</h4>
            <div style="height:260px"><canvas id="lavGraphique" aria-label="Dépôts et retraits par jour" role="img"></canvas></div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="lav-carte" id="lavPrets">
            <h4><i class="fas fa-check text-success"></i> Prêts à remettre</h4>
            @if (Model.PretsListe.Count == 0)
            {
                <div class="lav-vide">Aucun linge prêt en attente.</div>
            }
            else
            {
                <ul class="lav-liste">
                    @foreach (var d in Model.PretsListe)
                    {
                        <li><span><b>N° @d.Numero</b> · @d.NomClient<small>@d.TelephoneClient@(d.DatePret.HasValue ? " · prêt le " + d.DatePret.Value.ToString("dd/MM") : "")</small></span>
                            <span class="lav-montant">@Fcfa(Math.Max(0, d.Total - d.Acompte))</span></li>
                    }
                </ul>
            }
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="lav-carte" id="lavRetards">
            <h4><i class="fas fa-triangle-exclamation text-danger"></i> En retard</h4>
            @if (Model.RetardsListe.Count == 0)
            {
                <div class="lav-vide">Aucun linge en retard.</div>
            }
            else
            {
                <ul class="lav-liste">
                    @foreach (var d in Model.RetardsListe)
                    {
                        var prevue = d.DateRetraitPrevue!.Value.Date;
                        <li><span><b>N° @d.Numero</b> · @d.NomClient<small>@d.TelephoneClient · prévu le @prevue.ToString("dd/MM") (@((int)(aujourdhui - prevue).TotalDays) j)</small></span>
                            <span class="lav-montant">@Fcfa(Math.Max(0, d.Total - d.Acompte))</span></li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const jours = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Jours.Select(j => j.Jour.ToString("dd/MM"))));
            const valeurs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Jours.Select(j => new { depots = j.Depots, retraits = j.Retraits })));
            if (!window.Chart) return;
            new Chart(document.getElementById('lavGraphique'), {
                type: 'bar',
                data: { labels: jours, datasets: [
                    { label: 'Dépôts', data: valeurs.map(v => v.depots), backgroundColor: '#1d74c9', borderRadius: 4, borderSkipped: 'bottom', maxBarThickness: 18 },
                    { label: 'Retraits', data: valeurs.map(v => v.retraits), backgroundColor: '#e8890c', borderRadius: 4, borderSkipped: 'bottom', maxBarThickness: 18 }
                ] },
                options: { maintainAspectRatio: false, plugins: { legend: { position: 'top', align: 'end' } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: '#eef2f6' } }, x: { grid: { display: false } } } }
            });
        })();
    </script>
}
