@model List<EasytransitCaisse.Models.CaisseViewModel>

@{
    ViewData["Title"] = "Caisses";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h3 class="fw-bold">Gestion des Caisses</h3>
    </div>
    <div class="d-flex justify-content-end gap-2">
        @* <h3 class="fw-bold">Gestion des Caisses</h3> *@
        <a href="/Caisse/PrintCaisses"
           class="btn btn-outline-primary">
            Imprimer PDF
        </a>
        <a href="/Caisse/Create" class="btn btn-primary">
            + Nouvelle Caisse
        </a>
    </div>
    <br />

    <div class="card shadow-sm">

        <table id="caissesTable" class="table table-hover align-middle mb-0">

            <thead class="table-dark">
                <tr>
                    <th>Code</th>
                    <th>Description</th>
                    <th>StCode</th>
                    <th>Caissier par défaut</th>
                    <th style="text-align: center;" width="280">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.ChkCode</td>
                        <td>@item.ChkDescription</td>
                        <td>@item.StCode</td>
                        <td>
                            <span class="badge bg-info text-dark">
                                @item.CashierName
                            </span>
                        </td>
                        <td>
                            <a href="/Caisse/Details/@item.ID"
                                   class="btn btn-success btn-sm">
                                Ouvrir
                            </a>
                            <a href="/Caisse/Edit/@item.ID" class="btn btn-warning btn-sm">
                                Modifier
                            </a>

                            <form asp-action="Delete" asp-route-id="@item.ID" method="post" class="d-inline"
                                  onsubmit="return confirm('Supprimer cette caisse ?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">
                                    Supprimer
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#caissesTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json'
                },
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                order: [[1, 'asc']],
                columnDefs: [
                    { orderable: false, targets: 4 }
                ],
                dom: '<"d-flex justify-content-between align-items-center mb-3"lf>rtip'
            });
        });
    </script>
}