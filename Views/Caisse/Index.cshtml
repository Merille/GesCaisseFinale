@model List<EasytransitCaisse.Models.CaisseViewModel>
@inject EasytransitCaisse.Data.AppDbContext DbContext
@inject EasytransitCaisse.Services.ITenantProvider TenantProvider

@{
    ViewData["Title"] = "Caisses";
    var modulePointVente = await EasytransitCaisse.Services.ModulePointVenteFilter.ActifAsync(DbContext, TenantProvider.TenantId);
    var admin = Context.RequestServices.GetRequiredService<EasytransitCaisse.Services.DroitsUtilisateur>().Peut("config_pdv");   // éditeur du plan de salle
}
<div class="d-flex justify-content-end gap-2 mb-3">
    <a href="/Caisse/PrintCaisses" class="btn btn-outline-primary"><i class="fas fa-print"></i> Imprimer</a>
    <a href="/Caisse/Create" class="btn btn-primary" data-modale><i class="fas fa-plus"></i> Nouvelle caisse</a>
</div>
<div class="card shadow-sm border-0">
    <div class="card-body">
        <table id="caissesTable" class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr><th>Code</th><th>Description</th><th>Type</th><th>Caissier par défaut</th><th>Compte comptable</th>@if (modulePointVente) {<th>Dépôts</th>}<th class="text-center">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var type = item.TypePointVente ?? "Boutique";
                    <tr>
                        <td>
                            <span class="fw-semibold">@item.ChkCode</span>
                            @if (!string.IsNullOrEmpty(item.StCode))
                            {
                                <div class="small text-muted" title="StCode">@item.StCode</div>
                            }
                        </td>
                        <td>@item.ChkDescription</td>
                        <td>
                            <span class="badge @EasytransitCaisse.Controllers.CaisseController.Badge(type)">
                                <i class="fas @EasytransitCaisse.Controllers.CaisseController.Icone(type)"></i> @EasytransitCaisse.Controllers.CaisseController.Libelle(type)
                            </span>
                        </td>
                        <td>
                            @if (string.IsNullOrEmpty(item.CashierName))
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                @item.CashierName
                            }
                        </td>
                        <td>@item.CompteComptable</td>
                        @if (modulePointVente)
                        {
                            @* Dépôt de la caisse (sinon dépôt par défaut de la société), puis ses dépôts secondaires. *@
                            <td>
                                @item.DepotCode@if (item.DepotParDefaut) {<text> <span class="small text-muted text-nowrap">(par défaut)</span></text>}
                                @if (item.Secondaires.Any())
                                {
                                    <div class="small text-muted">+ @string.Join(", ", item.Secondaires)</div>
                                }
                            </td>
                        }
                        <td class="text-center table-actions">
                            <a href="/Caisse/Details/@item.ID" class="btn btn-primary btn-sm">Journées</a>
                            @if ((type is "Restaurant" or "Bar") && admin && modulePointVente)
                            {
                                <a href="/Salle/Index?caisse=@item.ID" class="btn btn-info btn-sm" title="Plan de salle" aria-label="Plan de salle"><i class="fas fa-chair"></i></a>
                            }
                            <a href="/Caisse/Edit/@item.ID" class="btn btn-warning btn-sm" data-modale>Modifier</a>
                            <form asp-action="Delete" asp-route-id="@item.ID" method="post" onsubmit="return confirm('Supprimer cette caisse ?');">
                                <button class="btn btn-danger btn-sm">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#caissesTable').DataTable({
                language: { url: '/vendor/datatables/fr-FR.json' },
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                order: [[1, 'asc']],
                columnDefs: [{ orderable: false, targets: -1 }],
                dom: '<"d-flex justify-content-between align-items-center mb-3"lf>rtip'
            });
        });
    </script>
}
