@model EasytransitCaisse.Models.Caisse
@inject EasytransitCaisse.Data.AppDbContext DbContext
@inject EasytransitCaisse.Services.ITenantProvider TenantProvider
@* Type de point de vente (Vente en détail, Restaurant, Bar, Laverie) et impression des bons de préparation ;
   masqués (valeurs conservées) quand la société n'a pas le module Point de vente. *@
@if (!await EasytransitCaisse.Services.ModulePointVenteFilter.ActifAsync(DbContext, Model.TenantId != 0 ? Model.TenantId : TenantProvider.TenantId))
{
    <input type="hidden" name="TypePointVente" value="@Model.TypePointVente" />
    <input type="hidden" name="ImprimerBons" value="@(Model.ImprimerBons ? "true" : "false")" />
    <input type="hidden" name="DepotId" value="@Model.DepotId" />
    return;
}
<div class="col-md-4">
    <label class="form-label" for="TypePointVente">Type de point de vente</label>
    <select class="form-select" id="TypePointVente" name="TypePointVente">
        @foreach (var t in EasytransitCaisse.Controllers.CaisseController.Types)
        {
            <option value="@t" selected="@(Model.TypePointVente == t)">@EasytransitCaisse.Controllers.CaisseController.Libelle(t)</option>
        }
    </select>
    <div class="form-text">Restaurant / Bar : plan de salle, commandes sur les tables, bons cuisine / bar. Laverie : vente au comptoir de prestations.</div>
</div>
@{
    // Dépôts actifs de la société ; une nouvelle caisse vend par défaut depuis le dépôt par défaut.
    var depots = DbContext.Depots.Where(d => d.Actif).OrderByDescending(d => d.ParDefaut).ThenBy(d => d.Code).ToList();
}
<div class="col-md-8">
    <label class="form-label" for="DepotId">Dépôt de stock</label>
    <select class="form-select" id="DepotId" name="DepotId">
        @foreach (var d in depots)
        {
            <option value="@d.Id" selected="@(Model.DepotId.HasValue ? Model.DepotId == d.Id : d.ParDefaut)">@(d.Code + " · " + d.Nom)</option>
        }
    </select>
    <div class="form-text">Les ventes et les retours de la caisse sortent du stock de ce dépôt (et y reviennent).</div>
</div>
<div class="col-12 d-flex align-items-center">
    <div class="form-check">
        <input class="form-check-input" type="checkbox" value="true" id="ImprimerBons" name="ImprimerBons" checked="@Model.ImprimerBons" />
        <input type="hidden" name="ImprimerBons" value="false" />
        <label class="form-check-label" for="ImprimerBons">
            Imprimer un bon de préparation à chaque envoi en cuisine / au bar
            <span class="d-block small text-muted">Les bons s'affichent aussi sur l'écran cuisine / bar.</span>
        </label>
    </div>
</div>
