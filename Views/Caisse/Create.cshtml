@model EasytransitCaisse.Models.Caisse
@{
    ViewData["Title"] = "Caisses";
}
<div class="container mt-4">

    <div class="card shadow-lg">
        <div class="card-header text-white bg-orange">
            <h4 class="mb-0">Créer une Caisse</h4>
        </div>

        <div class="card-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p class="mb-0">@error.ErrorMessage</p>
                    }
                </div>
            }

            <form method="post" asp-action="Create" asp-controller="Caisse">
                @Html.AntiForgeryToken()
                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Code Caisse (*)</label>
                        <input name="ChkCode" class="form-control" placeholder="Ex: CASH01" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">StCode (*)</label>
                        <input name="StCode" class="form-control" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Libellé (*)</label>
                        <input name="ChkDescription" class="form-control" placeholder="Caisse principale" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Compte comptable (caisse)</label>
                        <input name="CompteComptable" class="form-control" placeholder="Ex: 571000" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Caissier par défaut</label>
                        <select name="CashierDefault" class="form-select">
                            <option value="">-- Choisir un caissier --</option>
                            @foreach (var user in ViewBag.Users)
                            {
                                <option value="@user.Value">@user.Text</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="/Caisse/Index" class="btn btn-outline-secondary">Annuler</a>
                    <button type="submit" class="btn btn-success">Enregistrer</button>
                </div>

            </form>

        </div>
    </div>

</div>