@model List<EasytransitCaisse.Models.ViewModels.CaisseImpressionVM>
@{
    Layout = "_ImpressionLayout";
    ViewData["Pdf"] = true;
    ViewData["Republique"] = true;
    ViewData["TitreImpression"] = "Liste des caisses";
}
<h1>Liste des caisses</h1>
<table>
    <tr><th>Code</th><th>Description</th><th>StCode</th><th>Caissier par défaut</th><th>Compte comptable</th></tr>
    @foreach (var l in Model)
    {
        <tr>
            <td>@l.Caisse.ChkCode</td>
            <td>@l.Caisse.ChkDescription</td>
            <td>@l.Caisse.StCode</td>
            <td>@l.Caissier</td>
            <td>@l.Caisse.CompteComptable</td>
        </tr>
    }
</table>
