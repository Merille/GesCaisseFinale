@model List<EasytransitCaisse.Models.Caisse>

    @{
    Layout = "_PdfLayout";
}

<style>
    body { font-family: Arial; }
    table { border-collapse: collapse; }
    th { background: #333; color: white; }
</style>

<div style="display:flex; justify-content:space-between; margin-bottom:20px;">

    <!-- Gauche : logo et coordonnées de la société -->
    <partial name="_EnTeteSociete" model="(int?)null" />

    <!-- Droite -->
    <div style="text-align:right;">
        <h4 style="margin:0;">
            RÉPUBLIQUE GABONAISE
        </h4>
        <p style="margin:0;">Union - Travail - Justice</p>
    </div>

</div>

<hr />
<h2>Liste des Caisses</h2>

<table border="1" width="100%" cellpadding="5">

    <tr>
        <th>Code</th>
        <th>Description</th>
        <th>Caissier</th>
    </tr>

    @foreach (var c in Model)
    {
        <tr>
            <td>@c.ChkCode</td>
            <td>@c.ChkDescription</td>
            <td>@c.CashierDefault</td>
        </tr>
    }

</table>