@model EasytransitCaisse.Models.Caisse

@{
    ViewData["Title"] = "Caisses";
}
<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header bg-warning">
            <h4 class="mb-0">Modifier Caisse</h4>
        </div>

        <div class="card-body">

            <form method="post">

                <input type="hidden" name="ID" value="@Model.ID" />

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label>Code</label>
                        <input name="ChkCode" value="@Model.ChkCode" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Description</label>
                        <input name="ChkDescription" value="@Model.ChkDescription" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>StCode</label>
                        <input name="StCode" value="@Model.StCode" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Compte comptable (caisse)</label>
                        <input name="CompteComptable" value="@Model.CompteComptable" class="form-control"
                               placeholder="Ex: 571000" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Caissier par défaut</label>

                        <select name="CashierDefault" class="form-select">
                            <option value="">-- Choisir un caissier --</option>

                            @if (ViewBag.Users != null)
                            {
                                foreach (var user in ViewBag.Users)
                                {
                                    <option value="@user.Value"
                                            selected="@(Model.CashierDefault?.ToString() == user.Value ? "selected" : null)">
                                        @user.Text
                                    </option>
                                }
                            }
                        </select>
                    </div>

                </div>

                <div class="d-flex justify-content-end">
                    <button class="btn btn-primary">
                        Modifier
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>