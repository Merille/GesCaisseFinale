@model EasytransitCaisse.Models.Caisse

@{
    ViewData["Title"] = "Caisses";
}
<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <div class="d-flex justify-content-between">

                <h4>
                    @Model.ChkCode - @Model.ChkDescription
                </h4>
            </div>
            <div class="d-flex justify-content-end gap-2">
                <a href="/JourneeCaisse/PrintJournees?caisseId=@Model.ID"
                   class="btn btn-dark">
                    Imprimer PDF
                </a>

                <a href="/Caisse/Index"
                   class="btn btn-secondary">
                    Retour
                </a>

                <a href="/JourneeCaisse/Create/@Model.ID" data-modale
                   class="btn btn-success">
                    Nouvelle journée
                </a>
            </div>

        </div>

        <div class="card-body p-0">

            <table id="journeesTable" class="table table-hover mb-0">

                <thead class="table-dark">

                    <tr>
                        <th>Date</th>
                        <th>Initial</th>
                        <th>Encaisse</th>
                        <th>Décaisse</th>
                        <th>Solde</th>
                        <th>Statut</th>
                        <th width="180">Action</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var j in ViewBag.Journees)
                    {
                        <tr>

                            <td data-order="@j.DateJournee.ToString("yyyy-MM-dd")">
                                @j.DateJournee.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @j.Initial.ToString("N0")
                            </td>

                            <td class="text-success fw-bold">
                                @j.Encaisse.ToString("N0")
                            </td>

                            <td class="text-danger fw-bold">
                                @j.Decaisse.ToString("N0")
                            </td>

                            <td class="fw-bold">
                                @j.Solde.ToString("N0")
                            </td>
                            <td>
                                @if (j.Statut == "Ouverte")
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-lock-open"></i> Ouverte
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="fas fa-lock"></i> Clôturée
                                    </span>
                                }
                            </td>
                            <td>

                                <a href="/JourneeCaisse/Details/@j.JourneeId"
                                       class="btn btn-primary btn-sm">

                                    Consulter

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#journeesTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json'
                },
                pageLength: 20,
                lengthMenu: [20, 50, 100],
                order: [[0, 'desc']],
                columnDefs: [{ orderable: false, targets: 6 }],  // colonne Action
                dom: '<"d-flex justify-content-between align-items-center mb-3"lf>rtip'
            });
        });
    </script>
}
