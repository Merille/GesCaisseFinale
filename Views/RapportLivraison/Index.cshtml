@model EasytransitCaisse.Models.ViewModels.RapportLivraisonVM
@{
    ViewData["Title"] = "Rapport des livraisons";
    var f = Model.Filtres;
    var requete = f.Requete();
    var t = Model.Total;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var cartes = new (string Libelle, decimal Valeur, string Icone, bool Montant)[]
    {
        ("Livraisons", t.Livraisons, "fa-truck-fast", false), ("Livrées", t.Livrees, "fa-circle-check", false),
        ("En cours", t.ALivrer + t.AEncaisser, "fa-hourglass-half", false),
        ("Montant des ventes", t.Montant, "fa-cart-shopping", true), ("Frais de livraison", t.Frais, "fa-coins", true)
    };
    string Badge(string s) => s switch { "Livrée" => "bg-success", "À livrer" => "bg-warning text-dark", "À encaisser" => "bg-info text-dark", _ => "bg-secondary" };
}
<form method="get" action="/RapportLivraison/Index" class="card shadow-sm border-0 mb-3">
    <div class="card-body d-flex flex-wrap align-items-end gap-3">
        <div><label class="form-label small fw-semibold text-muted mb-1" for="du">Du</label><input type="date" class="form-control" id="du" name="du" value="@f.Du.ToString("yyyy-MM-dd")"></div>
        <div><label class="form-label small fw-semibold text-muted mb-1" for="au">Au</label><input type="date" class="form-control" id="au" name="au" value="@f.Au.ToString("yyyy-MM-dd")"></div>
        <div>
            <label class="form-label small fw-semibold text-muted mb-1" for="livreur">Livreur</label>
            <select class="form-select" id="livreur" name="livreur">
                <option value="">Tous</option>
                @foreach (var l in Model.Livreurs)
                {
                    <option value="@l.Id" selected="@(f.Livreur == l.Id)">@l.Nom</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label small fw-semibold text-muted mb-1" for="statut">Statut</label>
            <select class="form-select" id="statut" name="statut">
                <option value="">Tous</option>
                @foreach (var s in EasytransitCaisse.Models.ViewModels.FiltresRapportLivraison.Statuts)
                {
                    <option selected="@(f.Statut == s)">@s</option>
                }
            </select>
        </div>
        <button class="btn btn-primary"><i class="fas fa-search"></i> Filtrer</button>
        <div class="ms-auto d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary" href="/RapportLivraison/Imprimer?@requete" target="_blank"><i class="fas fa-print"></i> Imprimer / PDF</a>
            <a class="btn btn-success" href="/RapportLivraison/Excel?@requete"><i class="fas fa-file-excel"></i> Exporter Excel</a>
        </div>
    </div>
</form>

<div class="row g-3 mb-3">
    @foreach (var c in cartes)
    {
        <div class="col-6 col-lg"><div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="small text-muted"><i class="fas @c.Icone"></i> @c.Libelle</div>
            <div class="fs-5 fw-bold">@if (c.Montant)
                {
                    @c.Valeur.ToString("N0") <small class="fs-6 fw-normal text-muted">FCFA</small>
                }
                else
                {
                    @c.Valeur.ToString("0")
                }</div>
        </div></div></div>
    }
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-header bg-white fw-semibold">Par livreur</div>
    <div class="card-body table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark"><tr><th>Livreur</th><th>Moyen</th><th class="text-end">Livraisons</th><th class="text-end">Livrées</th><th class="text-end">À livrer</th>
                <th class="text-end">À encaisser</th><th class="text-end">Montant des ventes</th><th class="text-end">Frais de livraison</th></tr></thead>
            <tbody>
                @foreach (var l in Model.ParLivreur)
                {
                    <tr>
                        <td class="fw-semibold">@l.Livreur</td>
                        <td><i class="fas @EasytransitCaisse.Models.Livreur.Icone(l.Moyen) text-muted me-1"></i>@l.Moyen</td>
                        <td class="text-end">@l.Livraisons</td>
                        <td class="text-end">@l.Livrees</td>
                        <td class="text-end">@l.ALivrer</td>
                        <td class="text-end">@l.AEncaisser</td>
                        <td class="text-end text-nowrap">@l.Montant.ToString("N0")</td>
                        <td class="text-end text-nowrap fw-semibold">@l.Frais.ToString("N0")</td>
                    </tr>
                }
                @if (!Model.ParLivreur.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted">Aucune livraison sur la période.</td></tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light fw-bold"><td colspan="2">Total</td><td class="text-end">@t.Livraisons</td><td class="text-end">@t.Livrees</td>
                    <td class="text-end">@t.ALivrer</td><td class="text-end">@t.AEncaisser</td>
                    <td class="text-end text-nowrap">@t.Montant.ToString("N0")</td><td class="text-end text-nowrap">@t.Frais.ToString("N0")</td></tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white fw-semibold">Détail des livraisons</div>
    <div class="card-body table-responsive">
        <table id="livraisonsTable" class="table table-hover align-middle mb-0 small">
            <thead class="table-dark"><tr><th>Date</th><th>N°</th><th>Livreur</th><th>Destinataire</th><th>Adresse</th><th class="text-end">Montant</th><th class="text-end">Frais</th><th>Statut</th><th>Livrée le</th></tr></thead>
            <tbody>
                @foreach (var (l, i) in Model.Lignes.Select((l, i) => (l, i)))
                {
                    <tr>
                        <td class="text-nowrap" data-order="@i.ToString("D6")">@l.Date.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-nowrap">@if (l.Vente)
                            {
                                <a href="/Vente/Details/@l.Id">@l.Numero</a>
                            }
                            else
                            {
                                @l.Numero
                            }</td>
                        <td class="text-nowrap"><i class="fas @EasytransitCaisse.Models.Livreur.Icone(l.Moyen) text-muted me-1" title="@l.Moyen"></i>@l.Livreur</td>
                        <td>@(string.IsNullOrEmpty(l.Destinataire) ? l.Client : l.Destinataire)@if (!string.IsNullOrEmpty(l.Telephone))
                            {
                                <small class="d-block text-muted">@l.Telephone</small>
                            }</td>
                        <td>@l.Adresse</td>
                        <td class="text-end text-nowrap" data-order="@l.Montant.ToString(inv)">@l.Montant.ToString("N0")</td>
                        <td class="text-end text-nowrap" data-order="@l.Frais.ToString(inv)">@l.Frais.ToString("N0")</td>
                        <td><span class="badge @Badge(l.Statut)">@l.Statut</span></td>
                        <td class="text-nowrap" data-order="@(l.DateLivraison?.ToString("yyyy-MM-dd HH:mm:ss") ?? "")">@if (l.DateLivraison.HasValue)
                            {
                                @l.DateLivraison.Value.ToString("dd/MM/yyyy HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="small text-muted mt-2 mb-0">Montant : articles de la vente (TTC), frais de livraison en plus. « À encaisser » : commande confiée au livreur, encaissée à son retour.
            Les ventes annulées ne sont pas comptées.</p>
    </div>
</div>

@section Scripts {
    <script>
        $('#livraisonsTable').DataTable({
            language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json' },
            pageLength: 20,
            lengthMenu: [20, 50, 100],
            order: [[0, 'desc']],
            dom: '<"d-flex justify-content-between align-items-center mb-3"lf>rtip'
        });
    </script>
}
