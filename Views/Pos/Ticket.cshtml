@model EasytransitCaisse.Models.CommandePos
@using System.Globalization
@{
    Layout = null;
    var c = Model;
    var caisse = c.JourneeCaisse?.Caisse;
    string Fcfa(decimal n) => n.ToString("N0", CultureInfo.GetCultureInfo("fr-FR"));
    string Qte(decimal n) => n == Math.Round(n) ? n.ToString("0", CultureInfo.InvariantCulture) : n.ToString("0.##", CultureInfo.GetCultureInfo("fr-FR"));
    var taxes = EasytransitCaisse.Data.TaxesProduits.Regrouper(c.Lignes);
    var unites = (Dictionary<int, string>)ViewBag.Unites;
    string Unite(EasytransitCaisse.Models.LigneCommandePos l) => l.ProduitId.HasValue && unites.TryGetValue(l.ProduitId.Value, out var u) ? u : "Unité";
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>Ticket @c.Numero</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/css/ticket.css" asp-append-version="true" />
</head>
<body>
    <div class="ticket">
        @if (ViewBag.Logo != null)
        {
            <div class="c"><img src="@ViewBag.Logo" alt="" class="logo" /></div>
        }
        <div class="c b grand">@ViewBag.Societe</div>
        @foreach (var ligne in (List<string>)ViewBag.Coordonnees)
        {
            <div class="c petit">@ligne</div>
        }
        <div class="c">@caisse?.ChkDescription</div>
        @if (c.CommandeOrigineId.HasValue)
        {
            <div class="c b grand">RETOUR / REMBOURSEMENT</div>
        }
        else if (c.Statut == "Annulée")
        {
            <div class="c b grand">*** VENTE ANNULÉE ***</div>
        }
        <hr />
        <div>Ticket : @c.Numero</div>
        @if (ViewBag.NumeroOrigine != null)
        {
            <div>Vente  : @ViewBag.NumeroOrigine</div>
        }
        <div>Date   : @c.DateCommande.ToString("dd/MM/yyyy HH:mm")</div>
        <div>Caisse : @caisse?.ChkCode · Vendeur : @ViewBag.Vendeur</div>
        @if (ViewBag.Client != null)
        {
            <div>Client : @ViewBag.Client</div>
        }
        <hr />
        @foreach (var l in c.Lignes.OrderBy(x => x.Id))
        {
            <div class="b">@l.Libelle</div>
            <div class="r ind">
                <span>@Qte(l.Quantite)@(Unite(l) != "Unité" ? " " + Unite(l) : "") x @Fcfa(l.PrixUnitaire)@(l.Remise > 0 ? " -" + Qte(l.Remise) + "%" : "")</span>
                <span>@Fcfa(l.TotalTTC + l.RemiseGlobale)</span>
            </div>
        }
        <hr />
        @if (c.RemiseGlobale != 0)
        {
            <div class="r"><span>Sous-total</span><span>@Fcfa(c.TotalTTC + c.RemiseGlobale)</span></div>
            <div class="r"><span>Remise globale@(c.RemiseGlobaleTaux.HasValue ? " " + Qte(c.RemiseGlobaleTaux.Value) + " %" : "")</span><span>-@Fcfa(c.RemiseGlobale)</span></div>
        }
        <div class="r b grand"><span>TOTAL TTC</span><span>@Fcfa(c.TotalTTC) FCFA</span></div>
        <div class="r"><span>Total HT</span><span>@Fcfa(c.TotalHT)</span></div>
        @foreach (var t in taxes)
        {
            <div class="r"><span>@t.Key</span><span>@Fcfa(t.Value)</span></div>
        }
        <hr />
        @foreach (var p in c.Paiements.OrderBy(x => x.Id))
        {
            <div class="r"><span>@(c.CommandeOrigineId.HasValue ? "Remboursé · " : "")@p.Libelle</span><span>@Fcfa(p.MontantRecu)</span></div>
        }
        @if (c.MonnaieRendue > 0)
        {
            <div class="r b"><span>Monnaie rendue</span><span>@Fcfa(c.MonnaieRendue)</span></div>
        }
        <hr />
        @if (!string.IsNullOrEmpty(c.Motif))
        {
            <div>Motif : @c.Motif</div>
            <hr />
        }
        <div class="c">Merci de votre visite !</div>
        <div class="c petit">@c.Numero</div>
    </div>
    @if ((bool)ViewBag.Imprimer)
    {
        <script>window.addEventListener('load', function () { window.print(); });</script>
    }
</body>
</html>
