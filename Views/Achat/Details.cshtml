@model EasytransitCaisse.Models.Achat
@using EasytransitCaisse.Models
@{
    ViewData["Title"] = "Achat n° " + Model.Numero;
    var fr = System.Globalization.CultureInfo.GetCultureInfo("fr-FR");
    string Fcfa(decimal n) => n.ToString("N0", fr);
    string Qte(decimal n) => n.ToString(n == Math.Round(n) ? "#,0" : "#,0.00", fr);
    string QteBrute(decimal n) => n.ToString(n == Math.Round(n) ? "0" : "0.00", fr);
    var produits = (Dictionary<int, Produit>)ViewBag.Produits;
    var noms = (Dictionary<int, string>)ViewBag.Noms;
    var modesReglements = (Dictionary<int, string>)ViewBag.ModesReglements;
    var caisses = (Dictionary<int, string>)ViewBag.Caisses;
    var journees = (List<JourneeCaisse>)ViewBag.Journees;
    var modes = (List<ModePaiement>)ViewBag.Modes;
    var regle = Model.Reglements.Sum(r => r.Montant);
    var reste = Model.Statut == Achat.Valide ? Math.Max(0, Math.Round(Model.Total - regle, 2)) : 0;
    var annule = Model.Statut == Achat.Annule;
    string Nom(int? id) => id is int u && noms.TryGetValue(u, out var n) ? n : "";
}
<partial name="_Onglets" model="@("Index")" />
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h2 class="h5 mb-0">Achat n° @Model.Numero du @Model.DateAchat.ToString("dd/MM/yyyy")</h2>
    <span class="badge @(annule ? "bg-secondary" : reste > 0 ? "bg-warning text-dark" : "bg-success")">@(annule ? "Annulé" : reste > 0 ? "Non soldé" : "Soldé")</span>
    <a class="btn btn-sm btn-outline-secondary ms-auto" href="/Achat/Index"><i class="fa fa-arrow-left"></i> Retour à la liste</a>
    @if (!annule)
    {
        <form method="post" asp-action="Annuler" onsubmit="return confirm('Annuler cet achat ? Les quantités sortiront du stock et les paiements par la caisse seront remboursés.')">
            <input type="hidden" name="id" value="@Model.Id">
            <button class="btn btn-sm btn-outline-danger"><i class="fa fa-ban"></i> Annuler l'achat</button>
        </form>
    }
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 h-100"><div class="card-body">
            <dl class="row mb-0 small">
                <dt class="col-sm-3">Fournisseur</dt><dd class="col-sm-9">@(ViewBag.Fournisseur ?? "—")</dd>
                <dt class="col-sm-3">Dépôt</dt><dd class="col-sm-9">@ViewBag.Depot</dd>
                <dt class="col-sm-3">Référence</dt><dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Reference) ? "—" : Model.Reference)</dd>
                <dt class="col-sm-3">Saisi par</dt><dd class="col-sm-9">@Nom(Model.UtilisateurId), le @Model.DateCreation.ToString("dd/MM/yyyy HH:mm")</dd>
                @if (Model.DateAnnulation.HasValue)
                {
                    <dt class="col-sm-3">Annulé le</dt><dd class="col-sm-9">@Model.DateAnnulation.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                }
                @if (!string.IsNullOrEmpty(Model.Commentaire))
                {
                    <dt class="col-sm-3">Commentaire</dt><dd class="col-sm-9">@Model.Commentaire</dd>
                }
            </dl>
        </div></div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 h-100"><div class="card-body">
            <div class="d-flex justify-content-between"><span>Total</span><strong>@Fcfa(Model.Total) FCFA</strong></div>
            <div class="d-flex justify-content-between"><span>Réglé</span><strong>@Fcfa(regle) FCFA</strong></div>
            <div class="d-flex justify-content-between fs-5 @(reste > 0 ? "text-danger" : "")"><span>Reste à payer</span><strong>@Fcfa(reste) FCFA</strong></div>
        </div></div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-header bg-white fw-semibold">Produits achetés</div>
    <div class="card-body table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-dark"><tr><th>Code</th><th>Produit</th><th class="text-end">Quantité</th><th class="text-end">Prix unitaire</th><th class="text-end">Montant</th></tr></thead>
            <tbody>
                @foreach (var l in Model.Lignes.OrderBy(x => x.Id))
                {
                    var p = produits.GetValueOrDefault(l.ProduitId);
                    <tr><td>@p?.Code</td><td>@p?.Nom</td><td class="text-end">@Qte(l.Quantite) @p?.Unite</td>
                        <td class="text-end text-nowrap">@Qte(l.PrixUnitaire)</td><td class="text-end text-nowrap">@Fcfa(l.Montant)</td></tr>
                }
            </tbody>
            <tfoot><tr class="fw-bold"><td colspan="4" class="text-end">Total</td><td class="text-end text-nowrap">@Fcfa(Model.Total) FCFA</td></tr></tfoot>
        </table>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white fw-semibold">Règlements</div>
    <div class="card-body">
        @if (Model.Reglements.Any())
        {
            <div class="table-responsive"><table class="table align-middle small">
                <thead><tr><th>Date</th><th>Mode</th><th>Payé par</th><th>Saisi par</th><th class="text-end">Montant</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.Reglements.OrderBy(x => x.Id))
                    {
                        <tr><td class="text-nowrap">@r.DateReglement.ToString("dd/MM/yyyy HH:mm")</td><td>@(r.ModePaiementId is int m && modesReglements.TryGetValue(m, out var lib) ? lib : "")</td>
                            <td>@(r.OperationCaisseId is int o && caisses.TryGetValue(o, out var c) ? "Caisse " + c : "Hors caisse")</td>
                            <td>@Nom(r.UtilisateurId)</td><td class="text-end text-nowrap">@Fcfa(r.Montant)</td></tr>
                    }
                </tbody>
            </table></div>
        }
        else
        {
            <p class="text-muted">Aucun règlement : achat à crédit.</p>
        }
        @if (reste > 0)
        {
            <form method="post" asp-action="Reglement" class="row g-2 align-items-end border-top pt-3">
                <input type="hidden" name="id" value="@Model.Id">
                <div class="col-md-3"><label class="form-label small" for="paiement">Payé</label>
                    <select class="form-select" id="paiement" name="paiement" onchange="document.getElementById('blocJournee').classList.toggle('d-none', this.value !== 'caisse')">
                        <option value="caisse">Par la caisse (décaissement)</option><option value="hors">Hors caisse (virement, chèque…)</option>
                    </select></div>
                <div class="col-md-2"><label class="form-label small" for="montant">Montant</label><input class="form-control text-end" id="montant" name="montant" inputmode="decimal" value="@QteBrute(reste)" required></div>
                <div class="col-md-2"><label class="form-label small" for="mode">Mode de paiement</label>
                    <select class="form-select" id="mode" name="mode">
                        @foreach (var m in modes)
                        {
                            <option value="@m.Id">@m.Libelle</option>
                        }
                    </select></div>
                <div class="col-md-3" id="blocJournee"><label class="form-label small" for="journee">Journée de caisse</label>
                    <select class="form-select" id="journee" name="journee">
                        @if (!journees.Any())
                        {
                            <option value="0">Aucune journée ouverte</option>
                        }
                        @foreach (var j in journees)
                        {
                            <option value="@j.Id">@j.Caisse.ChkCode · @j.NumeroJournee</option>
                        }
                    </select></div>
                <div class="col-md-2"><button class="btn btn-success w-100"><i class="fa fa-check"></i> Régler</button></div>
            </form>
        }
    </div>
</div>
