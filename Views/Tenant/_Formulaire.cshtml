@model EasytransitCaisse.Models.Tenant
@* Formulaire d'une société (création, aussi en fenêtre modale, et modification), comme la version PHP. *@
@{
    var edition = Model.Id > 0;
    var titre = edition ? "Modifier la société" : "Nouvelle société";
    var logo = EasytransitCaisse.Data.Images.UrlLogo(Model);
}
<div class="card shadow-sm border-0" style="max-width: 720px;">
    <div class="card-header bg-brand text-white"><h5 class="mb-0">@titre</h5></div>
    <div class="card-body">
        <form method="post" action="@(edition ? "/Tenant/Edit/" + Model.Id : "/Tenant/Create")" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            @if (edition)
            {
                <input type="hidden" name="Id" value="@Model.Id" />
            }
            <div class="row g-3">
                <div class="col-md-8"><label class="form-label" for="Nom">Nom</label><input class="form-control" id="Nom" name="Nom" value="@Model.Nom" required /></div>
                <div class="col-md-4"><label class="form-label" for="Code">Code</label><input class="form-control" id="Code" name="Code" value="@Model.Code" required /></div>
                <div class="col-md-4">
                    <label class="form-label" for="ModeAcces">Mode d'accès</label>
                    <select class="form-select" id="ModeAcces" name="ModeAcces">
                        @foreach (var m in new[] { "Licence", "Abonnement" })
                        {
                            <option selected="@(Model.ModeAcces == m)">@m</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="DateExpiration">Date d'expiration</label>
                    <input class="form-control" type="date" id="DateExpiration" name="DateExpiration" value="@Model.DateExpiration?.ToString("yyyy-MM-dd")" />
                    <div class="form-text">Vide = sans limite.</div>
                </div>
                <div class="col-md-4 d-flex align-items-center">
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" value="true" id="Actif" name="Actif" checked="@Model.Actif" />
                        <input type="hidden" name="Actif" value="false" />
                        <label class="form-check-label" for="Actif">Société active</label>
                    </div>
                </div>
            </div>
            <h6 class="text-muted text-uppercase small mt-4 mb-3">Modules</h6>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" value="true" id="ModulePointVente" name="ModulePointVente" checked="@Model.ModulePointVente" />
                <input type="hidden" name="ModulePointVente" value="false" />
                <label class="form-check-label" for="ModulePointVente"><strong>Point de vente</strong>
                    <span class="d-block small text-muted">Vente au comptoir, catalogue (catégories, produits, combos), stock, restaurant et bar, rapports de ventes,
                        taxes et unités de vente. Sans ce module, la société n'a que la gestion de caisse (journées, opérations, tiers, factures, rapports).</span></label>
            </div>
            <h6 class="text-muted text-uppercase small mt-4 mb-3">Coordonnées (en-tête des tickets, factures et impressions)</h6>
            <div class="row g-3">
                <div class="col-12"><label class="form-label" for="Adresse">Adresse</label><input class="form-control" id="Adresse" name="Adresse" value="@Model.Adresse" placeholder="Ex : Boulevard Triomphal, BP 1234" maxlength="250" /></div>
                <div class="col-md-6"><label class="form-label" for="Ville">Ville</label><input class="form-control" id="Ville" name="Ville" value="@Model.Ville" placeholder="Ex : Libreville" maxlength="100" /></div>
                <div class="col-md-6"><label class="form-label" for="Pays">Pays</label><input class="form-control" id="Pays" name="Pays" value="@Model.Pays" placeholder="Ex : Gabon" maxlength="100" /></div>
                <div class="col-md-6"><label class="form-label" for="Email">E-mail</label><input class="form-control" type="email" id="Email" name="Email" value="@Model.Email" placeholder="contact@societe.ga" maxlength="150" /></div>
                <div class="col-md-6"><label class="form-label" for="Telephone">Téléphone</label><input class="form-control" type="tel" id="Telephone" name="Telephone" value="@Model.Telephone" placeholder="+241 01 23 45 67" maxlength="50" /></div>
                <div class="col-md-6"><label class="form-label" for="NIF">NIF</label><input class="form-control" id="NIF" name="NIF" value="@Model.NIF" placeholder="Numéro d'identification fiscale" maxlength="50" /></div>
                <div class="col-md-6">
                    <label class="form-label" for="Logo">Logo</label>
                    <div class="d-flex align-items-center gap-3">
                        @if (logo != null)
                        {
                            <img src="@logo" alt="Logo actuel" class="vignette-image" />
                        }
                        <input class="form-control" type="file" id="Logo" name="Logo" accept="image/png,image/jpeg,image/webp,image/gif" />
                    </div>
                    <div class="form-text">JPG, PNG, WEBP ou GIF, 1 Mo au plus.</div>
                    @if (logo != null)
                    {
                        <div class="form-check mt-1"><input class="form-check-input" type="checkbox" value="true" id="SupprimerLogo" name="SupprimerLogo" /><label class="form-check-label" for="SupprimerLogo">Retirer le logo</label></div>
                    }
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a href="/Tenant/Index" class="btn btn-outline-secondary hors-modale">Annuler</a>
            </div>
        </form>
    </div>
</div>
