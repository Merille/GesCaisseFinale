@model EasytransitCaisse.Models.Tenant
@{
    ViewData["Title"] = "Sociétés";
}
<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header bg-warning">
            <h4 class="mb-0">Modifier la société</h4>
        </div>

        <div class="card-body">

            <form method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="Id" value="@Model.Id" />
                <input type="hidden" name="DateCreation" value="@Model.DateCreation.ToString("o")" />

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Code</label>
                        <input name="Code" value="@Model.Code" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nom</label>
                        <input name="Nom" value="@Model.Nom" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Mode d'accès</label>
                        <select name="ModeAcces" class="form-select">
                            <option value="Licence" selected="@(Model.ModeAcces == "Licence")">Licence</option>
                            <option value="Abonnement" selected="@(Model.ModeAcces == "Abonnement")">Abonnement</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Date d'expiration</label>
                        <input type="date" name="DateExpiration" class="form-control"
                               value="@Model.DateExpiration?.ToString("yyyy-MM-dd")" />
                        <div class="form-text">Vide = illimitée (licence perpétuelle).</div>
                    </div>

                    <div class="col-md-6 mb-3 form-check mt-4">
                        <input type="checkbox" name="Actif" value="true" class="form-check-input" checked="@Model.Actif" />
                        <input type="hidden" name="Actif" value="false" />
                        <label class="form-check-label">Société active</label>
                    </div>

                </div>

                <div class="text-end">
                    <button class="btn btn-primary">
                        Modifier
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>
