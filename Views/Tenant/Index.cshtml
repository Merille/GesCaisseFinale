@model List<EasytransitCaisse.Models.Tenant>
@{
    ViewData["Title"] = "Sociétés";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Sociétés</h4>
    <a href="/Tenant/Create" class="btn btn-primary" data-modale><i class="fas fa-plus"></i> Nouvelle société</a>
</div>
<div class="card shadow-sm border-0">
    <div class="card-body table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark"><tr><th>Code</th><th>Nom</th><th>Mode d'accès</th><th>Expiration</th><th>Statut</th><th>Créée le</th><th class="text-center">Actions</th></tr></thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.Code</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (EasytransitCaisse.Data.Images.UrlLogo(t) is string logo)
                                {
                                    <img src="@logo" alt="" class="vignette-image vignette-petite" />
                                }
                                <div>
                                    <div class="fw-semibold">@t.Nom</div>
                                    <div class="small text-muted">@string.Join(" · ", new[] { t.Ville, t.Telephone, string.IsNullOrEmpty(t.NIF) ? null : "NIF " + t.NIF }.Where(x => !string.IsNullOrEmpty(x)))</div>
                                </div>
                            </div>
                        </td>
                        <td>@t.ModeAcces@if (t.ModulePointVente) { <span class="badge text-bg-light border"><i class="fas fa-store"></i> Point de vente</span> }</td>
                        <td>
                            @if (t.DateExpiration.HasValue)
                            {
                                @t.DateExpiration.Value.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="text-muted">Illimitée</span>
                            }
                        </td>
                        <td>
                            @if (!t.Actif)
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                            else if (t.EstBloque)
                            {
                                <span class="badge bg-danger">Expirée</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td>@t.DateCreation.ToString("dd/MM/yyyy")</td>
                        <td class="text-center table-actions">
                            <div class="d-inline-flex gap-1">
                                <a href="/Tenant/Edit/@t.Id" class="btn btn-warning btn-sm">
                                    Modifier
                                </a>
                                <form asp-action="Prolonger" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <input type="hidden" name="mois" value="1" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm">+1 mois</button>
                                </form>
                                <form asp-action="Prolonger" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <input type="hidden" name="mois" value="12" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm">+1 an</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>
</div>
