@model List<EasytransitCaisse.Models.Tenant>
@{
    ViewData["Title"] = "Sociétés (Tenants)";
}
<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">
        <h3>Sociétés</h3>

        <a href="/Tenant/Create" class="btn btn-primary">
            + Nouvelle société
        </a>
    </div>

    <div class="card shadow-sm">

        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Code</th>
                    <th>Nom</th>
                    <th>Mode d'accès</th>
                    <th>Expiration</th>
                    <th>Statut</th>
                    <th>Créée le</th>
                    <th width="260">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.Code</td>
                        <td>@t.Nom</td>
                        <td>@t.ModeAcces</td>
                        <td>
                            @(t.DateExpiration?.ToString("dd/MM/yyyy") ?? "Illimitée")
                        </td>
                        <td>
                            @if (t.EstBloque)
                            {
                                <span class="badge bg-danger">
                                    @(!t.Actif ? "Inactive" : "Expirée")
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td>@t.DateCreation.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a href="/Tenant/Edit/@t.Id" class="btn btn-warning btn-sm">
                                    Modifier
                                </a>
                                <form asp-action="Prolonger" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <input type="hidden" name="mois" value="1" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm">+1 mois</button>
                                </form>
                                <form asp-action="Prolonger" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <input type="hidden" name="mois" value="12" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm">+1 an</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>
</div>
