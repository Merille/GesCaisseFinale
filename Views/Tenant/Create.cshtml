@model EasytransitCaisse.Models.Tenant
@{
    ViewData["Title"] = "Sociétés";
}
<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Créer une société</h4>
        </div>

        <div class="card-body">

            <form method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">@string.Join(" ", ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage))</div>
                }

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Code</label>
                        <input name="Code" value="@Model?.Code" class="form-control" placeholder="Ex: ACME" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nom</label>
                        <input name="Nom" value="@Model?.Nom" class="form-control" placeholder="Ex: Acme SARL" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Mode d'accès</label>
                        <select name="ModeAcces" class="form-select">
                            <option value="Licence">Licence</option>
                            <option value="Abonnement">Abonnement</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Date d'expiration</label>
                        <input type="date" name="DateExpiration" class="form-control" />
                        <div class="form-text">Vide = illimitée (licence perpétuelle).</div>
                    </div>

                </div>


                <h6 class="text-muted text-uppercase small mt-2 mb-3">Modules</h6>
                <div class="form-check mb-3">
                    <input type="checkbox" name="ModulePointVente" value="true" id="ModulePointVente" class="form-check-input" checked="@(Model?.ModulePointVente ?? true)" />
                    <input type="hidden" name="ModulePointVente" value="false" />
                    <label class="form-check-label" for="ModulePointVente">
                        <strong>Point de vente</strong>
                        <span class="d-block small text-muted">Vente au comptoir, catalogue (catégories, produits, combos), stock, restaurant et bar, rapports de ventes,
                            taxes et unités de vente. Sans ce module, la société n'a que la gestion de caisse (journées, opérations, tiers, factures, rapports).</span>
                    </label>
                </div>

                <partial name="_Coordonnees" model="Model ?? new EasytransitCaisse.Models.Tenant()" />

                <div class="text-end">
                    <button class="btn btn-success">
                        Enregistrer
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>
