@model EasytransitCaisse.Models.ViewModels.SynchroVM
@using EasytransitCaisse.Models.ViewModels
@using EasytransitCaisse.Controllers
@{
    ViewData["Title"] = "Synchronisation";
    var f = Model.Filtres;
    var fr = System.Globalization.CultureInfo.GetCultureInfo("fr-FR");
    string Fcfa(decimal n) => n.ToString("N0", fr);
    var typeLibelle = new Dictionary<string, string> { ["vente"] = "Vente", ["depot"] = "Dépôt de linge", ["table"] = "Commande de table", ["attente"] = "Mise en attente" };
    var postesEnAttente = Model.Postes.Count(p => p.Poste.EnAttente > 0);
    var enAttente = Model.Postes.Sum(p => p.Poste.EnAttente);
    var cartes = new (string Libelle, decimal Valeur, string Icone, bool Montant, bool Alerte)[]
    {
        ("Postes suivis", Model.Postes.Count, "fa-desktop", false, false),
        ("Postes avec envois en attente", postesEnAttente, "fa-cloud-arrow-up", false, postesEnAttente > 0),
        ("Opérations à envoyer", enAttente, "fa-hourglass-half", false, enAttente > 0),
        ("Montant à envoyer", Model.Postes.Sum(p => p.Poste.MontantEnAttente), "fa-coins", true, false),
        ("Ventes hors ligne (période)", Model.NbVentes, "fa-receipt", false, false),
        ("Ventes à vérifier", Model.AVerifier, "fa-triangle-exclamation", false, Model.AVerifier > 0)
    };
    var aVerifierFiltre = f.Etat == "à vérifier";
    var libelleEtat = FiltresSynchro.Etats.First(e => e.Valeur == f.Etat).Libelle;
}
<p class="text-muted small mb-3">Les postes travaillent sans connexion quand le réseau tombe : leurs ventes, dépôts, commandes de table et mises en attente
    sont gardés sur le poste puis envoyés au retour de la connexion. Chaque poste connecté indique ici ce qu'il lui reste à envoyer.</p>

<div class="row g-3 mb-3">
    @foreach (var c in cartes)
    {
        <div class="col-6 col-lg"><div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="small text-muted"><i class="fa @c.Icone"></i> @c.Libelle</div>
            <div class="fs-5 fw-bold@(c.Alerte ? " text-danger" : "")">@if (c.Montant) {@Fcfa(c.Valeur) <small class="fs-6 fw-normal text-muted">FCFA</small>} else {@((int)c.Valeur)}</div>
        </div></div></div>
    }
</div>

<div class="card shadow-sm border-0 mb-3" id="synchroPostes">
    <div class="card-header bg-white fw-semibold"><i class="fa fa-desktop"></i> Postes</div>
    <div class="card-body table-responsive">
        @if (!Model.Postes.Any())
        {
            <div class="text-muted">Aucun poste ne s'est encore signalé. Un poste apparaît ici dès qu'il ouvre GesCaisse avec la connexion.</div>
        }
        else
        {
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark"><tr><th>Poste</th><th>Dernier utilisateur</th><th>Dernier contact</th><th class="text-end">À envoyer</th>
                    <th class="text-end">Montant</th><th>Plus ancienne</th><th>Dernier envoi</th><th>État</th><th></th></tr></thead>
                <tbody>
                @foreach (var l in Model.Postes)
                {
                    var p = l.Poste;
                    <tr>
                        <td class="fw-semibold">H-@p.Code<div class="small text-muted text-truncate" style="max-width:220px" title="@p.Navigateur">@p.Navigateur</div></td>
                        <td>@l.Utilisateur</td>
                        <td class="text-nowrap">@p.DernierRapport.ToString("dd/MM/yyyy HH:mm")<div class="small text-muted">@SynchroController.Depuis(p.DernierRapport)</div></td>
                        <td class="text-end fw-semibold">@p.EnAttente@if (p.Refusees > 0) {<text> </text><span class="badge bg-danger">@p.Refusees refusée@(p.Refusees > 1 ? "s" : "")</span>}</td>
                        <td class="text-end text-nowrap">@(p.EnAttente > 0 ? Fcfa(p.MontantEnAttente) : "")</td>
                        <td class="text-nowrap small">@p.PlusAncien?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td class="text-nowrap small">@p.DernierEnvoi?.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge @l.Badge">@l.Etat</span></td>
                        <td class="text-end text-nowrap">
                            @if (l.Elements.Any())
                            {
                                <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#poste@(p.Id)" aria-expanded="false">Détail</button>
                            }
                            <form method="post" action="/Synchro/Oublier" class="d-inline" onsubmit="return confirm('Retirer le poste H-@p.Code de la liste ?@(p.EnAttente > 0 ? "\\nIl a encore des opérations à envoyer : elles restent sur le poste." : "")')">
                                @Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id">
                                <button class="btn btn-sm btn-outline-secondary" title="Retirer de la liste (poste qui ne sert plus)" aria-label="Retirer le poste H-@p.Code"><i class="fa fa-xmark"></i></button>
                            </form>
                        </td>
                    </tr>
                    @if (l.Elements.Any())
                    {
                        <tr class="collapse" id="poste@(p.Id)"><td colspan="9" class="bg-light">
                            <table class="table table-sm mb-0 small">
                                <thead><tr><th>N° provisoire</th><th>Opération</th><th>Faite le</th><th class="text-end">Montant</th><th>Refus</th></tr></thead>
                                <tbody>
                                @foreach (var e in l.Elements)
                                {
                                    <tr><td class="fw-semibold">@e.Numero</td><td>@(e.Libelle != "" ? e.Libelle : typeLibelle.GetValueOrDefault(e.Type, e.Type))</td>
                                        <td class="text-nowrap">@e.Cree?.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end text-nowrap">@(e.Montant.HasValue ? Fcfa(e.Montant.Value) : "")</td>
                                        <td class="text-danger">@e.Erreur</td></tr>
                                }
                                </tbody>
                            </table>
                        </td></tr>
                    }
                }
                </tbody>
            </table>
            <div class="small text-muted mt-2">Un poste « sans nouvelles » a des opérations à envoyer et ne s'est plus signalé depuis plus d'une heure : vérifiez sa connexion,
                puis ouvrez GesCaisse sur ce poste pour lancer l'envoi. Les opérations restent dans le navigateur du poste : ne videz pas ses données.</div>
        }
    </div>
</div>

<form method="get" action="/Synchro/Index" class="card shadow-sm border-0 mb-3">
    <div class="card-body d-flex flex-wrap align-items-end gap-3">
        <div>
            <label class="form-label small fw-semibold text-muted mb-1" for="etat">Ventes hors ligne</label>
            <select class="form-select" id="etat" name="etat" onchange="['du', 'au'].forEach(i => document.getElementById(i).disabled = this.value === 'à vérifier')">
                @foreach (var (v, lib) in FiltresSynchro.Etats)
                {
                    <option value="@v" selected="@(f.Etat == v)">@lib</option>
                }
            </select>
        </div>
        <div><label class="form-label small fw-semibold text-muted mb-1" for="du">Du</label><input type="date" class="form-control" id="du" name="du" value="@f.Du.ToString("yyyy-MM-dd")" disabled="@aVerifierFiltre"></div>
        <div><label class="form-label small fw-semibold text-muted mb-1" for="au">Au</label><input type="date" class="form-control" id="au" name="au" value="@f.Au.ToString("yyyy-MM-dd")" disabled="@aVerifierFiltre"></div>
        <button class="btn btn-primary"><i class="fa fa-search"></i> Filtrer</button>
    </div>
</form>

<form method="post" action="/Synchro/Verifier" class="card shadow-sm border-0 mb-3" id="synchroVentes">
    @Html.AntiForgeryToken()
    <input type="hidden" name="etat" value="@f.Etat"><input type="hidden" name="du" value="@f.Du.ToString("yyyy-MM-dd")"><input type="hidden" name="au" value="@f.Au.ToString("yyyy-MM-dd")">
    <div class="card-header bg-white d-flex flex-wrap align-items-center gap-2">
        <span class="fw-semibold"><i class="fa fa-receipt"></i> Ventes enregistrées hors ligne
            <span class="text-muted fw-normal small">· @(aVerifierFiltre ? "à vérifier, toutes dates" : libelleEtat + " du " + f.Du.ToString("dd/MM/yyyy") + " au " + f.Au.ToString("dd/MM/yyyy")) (@Model.Ventes.Count)</span></span>
        @if (Model.Ventes.Any(v => v.Vente.AlerteHorsLigne != null && v.Vente.AlerteHorsLigneVue == null))
        {
            <button class="btn btn-sm btn-warning ms-auto"><i class="fa fa-check"></i> Marquer les ventes cochées vérifiées</button>
        }
    </div>
    <div class="card-body table-responsive">
        @if (!Model.Ventes.Any())
        {
            <div class="text-muted">@(aVerifierFiltre ? "Aucune vente hors ligne à vérifier." : "Aucune vente hors ligne sur cette période.")</div>
        }
        else
        {
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark"><tr><th style="width:32px"><input type="checkbox" class="form-check-input" aria-label="Tout cocher"
                    onclick="document.querySelectorAll('#synchroVentes [name=&quot;ids&quot;]').forEach(c => c.checked = this.checked)"></th>
                    <th>Ticket</th><th>Provisoire</th><th>Date</th><th>Caisse</th><th>Vendeur</th><th class="text-end">Total TTC</th><th>Vérification</th></tr></thead>
                <tbody>
                @foreach (var l in Model.Ventes)
                {
                    var v = l.Vente;
                    var aVerifier = v.AlerteHorsLigne != null && v.AlerteHorsLigneVue == null;
                    <tr class="@(v.Statut == "Annulée" ? "text-muted" : "")">
                        <td>@if (aVerifier) {<input type="checkbox" class="form-check-input" name="ids" value="@v.Id" aria-label="Cocher la vente @v.Numero">}</td>
                        <td class="fw-semibold"><a href="/Vente/Details/@v.Id">@v.Numero</a>@if (v.Statut == "Annulée") {<text> </text><span class="badge bg-secondary">Annulée</span>}</td>
                        <td>@v.NumeroHorsLigne</td>
                        <td class="text-nowrap">@v.DateCommande.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@l.Caisse</td>
                        <td>@l.Vendeur</td>
                        <td class="text-end text-nowrap">@Fcfa(v.TotalTTC)</td>
                        <td class="small">
                            @if (aVerifier)
                            {
                                <span class="badge text-bg-warning">À vérifier</span> @v.AlerteHorsLigne
                            }
                            else if (v.AlerteHorsLigne != null)
                            {
                                <span class="badge bg-success">Vérifiée</span> <text>le @v.AlerteHorsLigneVue?.ToString("dd/MM/yyyy HH:mm")</text>
                                <div class="text-muted">@v.AlerteHorsLigne</div>
                            }
                            else
                            {
                                <span class="badge text-bg-light border">Sans écart</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</form>

@if (Model.Depots != null)
{
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white fw-semibold"><i class="fa fa-shirt"></i> Dépôts de linge enregistrés hors ligne <span class="text-muted fw-normal small">· du @f.Du.ToString("dd/MM/yyyy") au @f.Au.ToString("dd/MM/yyyy") (@Model.Depots.Count)</span></div>
        <div class="card-body table-responsive">
            @if (!Model.Depots.Any())
            {
                <div class="text-muted">Aucun dépôt de linge enregistré hors ligne sur cette période.</div>
            }
            else
            {
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark"><tr><th>Dépôt</th><th>Provisoire</th><th>Déposé le</th><th>Caisse</th><th>Client</th><th class="text-end">Total</th><th>Statut</th></tr></thead>
                    <tbody>
                    @foreach (var (d, caisse) in Model.Depots)
                    {
                        <tr><td class="fw-semibold">N° @d.Numero</td><td>@d.NumeroHorsLigne</td><td class="text-nowrap">@d.DateDepot.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@caisse</td><td>@d.NomClient<div class="small text-muted">@d.TelephoneClient</div></td>
                            <td class="text-end text-nowrap">@Fcfa(d.Total)</td><td>@d.Statut</td></tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </div>
}
