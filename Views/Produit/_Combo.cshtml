@model EasytransitCaisse.Models.Produit
@* Produit combo : liste ordonnée des combos (Configuration › Combos) qui le composent, éditée par combo.js. *@
@{
    var disponibles = ViewBag.CombosDisponibles ?? new List<object>();
    var choisis = (List<int>?)ViewBag.CombosChoisis ?? new List<int>();
}
<div class="card shadow-sm border-0" id="combo">
    <div class="card-header bg-brand text-white d-flex align-items-center gap-2">
        <h5 class="mb-0 flex-grow-1">Combo (menu, formule)</h5>
        @if (Model.EstCombo)
        {
            <span class="badge bg-light text-dark">@choisis.Count combo(s)</span>
        }
    </div>
    <div class="card-body">
        <p class="small text-muted">
            Comme dans Odoo, un produit combo (ex. <strong>Menu midi</strong>) se compose de combos créés dans
            <a href="/Combo/Index">Configuration › Combos</a> (ex. <strong>Plats</strong>, <strong>Boissons</strong>). À la caisse, le serveur
            choisit un article dans chaque combo ; le prix est celui du produit plus les suppléments. Le produit combo n'a pas de stock propre.
        </p>
        <form method="post" action="/Produit/Combo">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="combos" id="produit-combos-json" />
            <div id="produit-combos"></div>
            <script id="produit-combos-donnees" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { combos = disponibles, choisis }))</script>
            <div class="mt-3"><button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-floppy-disk"></i> Enregistrer</button></div>
        </form>
    </div>
</div>
<script src="~/js/combo.js" asp-append-version="true"></script>
