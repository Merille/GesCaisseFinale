@model EasytransitCaisse.Models.Produit
@using System.Globalization
@* Champs de la fiche produit (création et modification). *@
@{
    var categories = (List<EasytransitCaisse.Models.Categorie>)ViewBag.Categories;
    string Nombre(decimal? n) => n.HasValue ? n.Value.ToString("0.##", CultureInfo.InvariantCulture) : "";
    var taxes = (List<EasytransitCaisse.Models.Taxe>)ViewBag.Taxes;
    var cochees = (int[])(ViewBag.TaxesCochees ?? Array.Empty<int>());
    var totalTaxes = taxes.Where(t => cochees.Contains(t.Id)).Sum(t => t.Taux);
}
@if (ViewBag.Erreur != null)
{
    <div class="alert alert-danger">@ViewBag.Erreur</div>
}
<div class="row g-3">
    <div class="col-md-3">
        <label class="form-label" for="Code">Code</label>
        <input class="form-control" id="Code" name="Code" value="@Model.Code" placeholder="Ex : RIZ5" required />
    </div>
    <div class="col-md-5">
        <label class="form-label" for="Nom">Nom</label>
        <input class="form-control" id="Nom" name="Nom" value="@Model.Nom" placeholder="Ex : Riz parfumé 5 kg" required />
    </div>
    <div class="col-md-4">
        <label class="form-label" for="CategorieId">Catégorie</label>
        <select class="form-select" id="CategorieId" name="CategorieId">
            <option value="">-- Sans catégorie --</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id" selected="@(Model.CategorieId == c.Id)">@c.Nom</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label" for="CodeBarres">Code-barres</label>
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-barcode"></i></span>
            <input class="form-control" id="CodeBarres" name="CodeBarres" value="@Model.CodeBarres" placeholder="Scannez ou saisissez"
                   onkeydown="if (event.key === 'Enter') event.preventDefault();" />
        </div>
    </div>
    <div class="col-md-4">
        <label class="form-label" for="PrixVente">Prix de vente TTC (FCFA)</label>
        <input class="form-control" id="PrixVente" name="PrixVente" inputmode="decimal" value="@Nombre(Model.Id == 0 && Model.PrixVente == 0 ? null : Model.PrixVente)" required />
    </div>
    <div class="col-md-4">
        <label class="form-label" for="Unite">Unité de vente</label>
        <input class="form-control" id="Unite" name="Unite" value="@(string.IsNullOrEmpty(Model.Unite) ? "Unité" : Model.Unite)" list="unites" maxlength="20" placeholder="Ex : Kg, Litre, Carton" />
        <datalist id="unites">
            @foreach (var u in EasytransitCaisse.Controllers.ProduitController.Unites)
            {
                <option value="@u"></option>
            }
        </datalist>
        <div class="form-text">Le prix TTC s'entend pour une unité.</div>
    </div>
    <div class="col-md-4">
        <label class="form-label" for="Cout">Coût d'achat HT (FCFA)</label>
        <input class="form-control" id="Cout" name="Cout" inputmode="decimal" value="@Nombre(Model.Cout)" placeholder="Facultatif" />
        @if (Model.Cout.HasValue && Model.PrixVente > 0)
        {
            var ht = Model.PrixVente / (1 + Model.TauxTVA / 100);
            var marge = ht - Model.Cout.Value;
            <div class="form-text">Marge : <strong class="@(marge < 0 ? "text-danger" : "")">@marge.ToString("N0", new CultureInfo("fr-FR")) FCFA</strong> par unité (@(ht > 0 ? Math.Round(marge * 100 / ht, 1).ToString("0.#", new CultureInfo("fr-FR")) : "0") % du prix HT).</div>
        }
        else
        {
            <div class="form-text">Sert au calcul de la marge.</div>
        }
    </div>
    <div class="col-md-4">
        <label class="form-label" for="Image">Image du produit</label>
        <div class="d-flex align-items-center gap-2">
            @if (EasytransitCaisse.Data.Images.UrlImage(Model) is string image)
            {
                <img src="@image" alt="Image actuelle" class="vignette-image" />
            }
            <input class="form-control" type="file" id="Image" name="Image" accept="image/png,image/jpeg,image/webp,image/gif" />
        </div>
        @if (Model.ImageMaj.HasValue)
        {
            <div class="form-check mt-1">
                <input class="form-check-input" type="checkbox" value="true" id="SupprimerImage" name="SupprimerImage" />
                <label class="form-check-label" for="SupprimerImage">Retirer l'image</label>
            </div>
        }
        else
        {
            <div class="form-text">JPG, PNG, WEBP ou GIF, 1 Mo au plus.</div>
        }
    </div>
    <div class="col-md-4">
        <div class="form-label">Taxes</div>
        <div class="d-flex flex-wrap gap-2" role="group" aria-label="Taxes du produit">
            @foreach (var t in taxes)
            {
                <input type="checkbox" class="btn-check" name="Taxes" value="@t.Id" id="taxe@(t.Id)" data-taux="@t.Taux.ToString(CultureInfo.InvariantCulture)"
                       checked="@cochees.Contains(t.Id)" autocomplete="off"
                       onchange="let t = 0; this.closest('form').querySelectorAll('[name=Taxes]:checked').forEach((c) => t += +c.dataset.taux); this.closest('form').querySelector('.taux-total').textContent = t.toLocaleString('fr-FR');" />
                <label class="btn btn-outline-primary btn-sm" for="taxe@(t.Id)" title="@t.Libelle">@EasytransitCaisse.Data.TaxesProduits.Libelle(t.Code, t.Taux)</label>
            }
        </div>
        <div class="form-text">
            @if (!taxes.Any())
            {
                <text>Aucune taxe : créez-en dans Paramètres &gt; Taxes.</text>
            }
            else
            {
                <text>Total <strong class="taux-total">@totalTaxes.ToString("0.##", new CultureInfo("fr-FR"))</strong> %, compris dans le prix TTC.</text>
            }
        </div>
    </div>
</div>

<h6 class="text-muted text-uppercase small mt-4 mb-3">Stock</h6>
<div class="row g-3 align-items-end">
    <div class="col-md-4">
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" value="true" id="SuiviStock" name="SuiviStock" checked="@Model.SuiviStock" />
            <input type="hidden" name="SuiviStock" value="false" />
            <label class="form-check-label" for="SuiviStock">Suivre le stock de ce produit</label>
        </div>
        <div class="form-text mt-0">Décochez pour un service (photocopie, recharge…).</div>
    </div>
    @if (Model.Id == 0)
    {
        <div class="col-md-4">
            <label class="form-label" for="StockActuel">Stock initial</label>
            <input class="form-control" id="StockActuel" name="StockActuel" inputmode="decimal" value="@Nombre(Model.StockActuel)" />
        </div>
    }
    else if (Model.EstModele)
    {
        var variantesModele = (List<EasytransitCaisse.Models.Produit>?)ViewBag.Variantes ?? new List<EasytransitCaisse.Models.Produit>();
        <div class="col-md-4">
            <div class="form-label">Quantité en stock</div>
            <div class="form-control-plaintext fw-bold py-1">@variantesModele.Where(v => v.Actif).Sum(v => v.StockActuel).ToString("0.##")
                <a class="small fw-normal ms-2" href="#variantes">par variante</a></div>
            <div class="form-text mt-0">Total des variantes actives : le stock se gère sur chaque variante.</div>
        </div>
    }
    else
    {
        <div class="col-md-4">
            <div class="form-label">Quantité en stock</div>
            <div class="form-control-plaintext fw-bold py-1">@Model.StockActuel.ToString("0.##")
                <a class="small fw-normal ms-2" href="/Stock/Index?produit=@Model.Id">Historique</a></div>
            <div class="form-text mt-0">Modifiée par les entrées, inventaires et ventes (menu Stock).</div>
        </div>
    }
    <div class="col-md-4">
        <label class="form-label" for="SeuilAlerte">Seuil d'alerte</label>
        <input class="form-control" id="SeuilAlerte" name="SeuilAlerte" inputmode="decimal" value="@Nombre(Model.SeuilAlerte)" placeholder="Ex : 5" />
    </div>
    <div class="col-12">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" value="true" id="Actif" name="Actif" checked="@Model.Actif" />
            <input type="hidden" name="Actif" value="false" />
            <label class="form-check-label" for="Actif">Produit actif (proposé à la vente)</label>
        </div>
    </div>
</div>
