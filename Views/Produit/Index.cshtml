@model List<EasytransitCaisse.Models.Produit>
@{
    ViewData["Title"] = "Produits";
    var categories = (List<EasytransitCaisse.Models.Categorie>)ViewBag.Categories;
    var categorieChoisie = (int)ViewBag.Categorie;
    var nbAlertes = (int)ViewBag.NbAlertes;
    string Qte(decimal n) => n == Math.Round(n) ? n.ToString("N0") : n.ToString("N2");
}

<partial name="_Messages" />

<form method="post" asp-action="Import" enctype="multipart/form-data" id="importProduitsForm">
    <input type="file" name="file" accept=".xlsx" id="importProduits" class="d-none"
           onchange="document.getElementById('importProduitsForm').submit()" />
</form>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <form method="get" asp-action="Index" class="d-flex gap-2">
        <select name="categorie" class="form-select" style="width:auto;" onchange="this.form.submit()" aria-label="Catégorie">
            <option value="0">Toutes les catégories</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id" selected="@(categorieChoisie == c.Id)">@c.Nom</option>
            }
        </select>
    </form>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary" onclick="document.getElementById('importProduits').click()">
            <i class="fas fa-file-import"></i> Importer Excel
        </button>
        <a href="/Produit/Export?categorie=@categorieChoisie" class="btn btn-success">
            <i class="fas fa-file-excel"></i> Exporter Excel
        </a>
        <a href="/Produit/Create" class="btn btn-primary" data-modale>
            <i class="fas fa-plus"></i> Nouveau produit
        </a>
    </div>
</div>

<p class="small text-muted mb-2">
    Import : un produit dont le code existe déjà est mis à jour, sinon il est créé ; une catégorie inconnue est créée.
    Colonnes dans l'ordre : @string.Join(", ", EasytransitCaisse.Controllers.ProduitController.ColonnesExcel)
    (le plus simple est de partir d'un export).
</p>

@if (nbAlertes > 0)
{
    <div class="alert alert-warning py-2"><i class="fas fa-triangle-exclamation"></i> @nbAlertes produit(s) au niveau ou sous le seuil d'alerte de stock.</div>
}

<div class="card shadow-sm border-0">
    <div class="card-body table-responsive">
        <table id="produitsTable" class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Code</th>
                    <th>Produit</th>
                    <th>Catégorie</th>
                    <th>Code-barres</th>
                    <th class="text-end">Prix TTC</th>
                    <th class="text-end">TVA</th>
                    <th class="text-end">Stock</th>
                    <th class="text-center">Statut</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-semibold">@p.Code</td>
                        <td>@p.Nom</td>
                        <td>
                            @if (p.Categorie != null)
                            {
                                <span class="pastille-categorie" style="background: @p.Categorie.Couleur"></span> @p.Categorie.Nom
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-muted small">@p.CodeBarres</td>
                        <td class="text-end fw-semibold text-nowrap" data-order="@p.PrixVente.ToString(System.Globalization.CultureInfo.InvariantCulture)">@p.PrixVente.ToString("N0")</td>
                        <td class="text-end">@Qte(p.TauxTVA) %</td>
                        <td class="text-end text-nowrap" data-order="@(p.SuiviStock ? p.StockActuel.ToString(System.Globalization.CultureInfo.InvariantCulture) : "-1")">
                            @if (!p.SuiviStock)
                            {
                                <span class="text-muted small">Non suivi</span>
                            }
                            else if (p.EnAlerteStock)
                            {
                                <span class="badge bg-danger" title="Stock au niveau ou sous le seuil d'alerte">@Qte(p.StockActuel)</span>
                            }
                            else
                            {
                                @Qte(p.StockActuel)
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge @(p.Actif ? "bg-success" : "bg-secondary")">@(p.Actif ? "Actif" : "Inactif")</span>
                        </td>
                        <td class="text-center text-nowrap">
                            <div class="d-inline-flex gap-1">
                                <a href="/Produit/Edit/@p.Id" class="btn btn-warning btn-sm">Modifier</a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Supprimer ce produit ?')">
                                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#produitsTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json'
                },
                pageLength: 20,
                lengthMenu: [20, 50, 100],
                order: [[1, 'asc']],
                columnDefs: [{ orderable: false, targets: 8 }],  // colonne Actions
                dom: '<"d-flex justify-content-between align-items-center mb-3"lf>rtip'
            });
        });
    </script>
}
