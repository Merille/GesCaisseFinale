@model List<EasytransitCaisse.Models.Produit>
@{
    ViewData["Title"] = "Produits";
    var categories = (List<EasytransitCaisse.Models.Categorie>)ViewBag.Categories;
    var categorieChoisie = (int)ViewBag.Categorie;
    var nbAlertes = (int)ViewBag.NbAlertes;
    string Qte(decimal n) => n == Math.Round(n) ? n.ToString("N0") : n.ToString("N2");
    var taxesProduits = (Dictionary<int, List<EasytransitCaisse.Models.Taxe>>)ViewBag.TaxesProduits;
    string Taxes(EasytransitCaisse.Models.Produit p) => EasytransitCaisse.Data.TaxesProduits.Codes(taxesProduits.GetValueOrDefault(p.Id));
}

<partial name="_Messages" />

<form method="post" asp-action="Import" enctype="multipart/form-data" id="importProduitsForm">
    <input type="file" name="file" accept=".xlsx" id="importProduits" class="d-none"
           onchange="document.getElementById('importProduitsForm').submit()" />
</form>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
    <form method="get" asp-action="Index" class="d-flex gap-2">
        <select name="categorie" class="form-select" style="width:auto;" onchange="this.form.submit()" aria-label="Catégorie">
            <option value="0">Toutes les catégories</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id" selected="@(categorieChoisie == c.Id)">@c.Nom</option>
            }
        </select>
    </form>
    <div class="d-flex flex-wrap gap-2">
        <div class="btn-group" role="group" aria-label="Affichage" data-vues="produits">
            <button type="button" class="btn btn-outline-secondary" data-vue="liste" title="Affichage en liste"><i class="fas fa-list"></i> Liste</button>
            <button type="button" class="btn btn-outline-secondary" data-vue="cartes" title="Affichage en cartes"><i class="fas fa-grip"></i> Cartes</button>
        </div>
        <button type="button" class="btn btn-outline-primary" onclick="document.getElementById('importProduits').click()">
            <i class="fas fa-file-import"></i> Importer Excel
        </button>
        <a href="/Produit/Export?categorie=@categorieChoisie" class="btn btn-success">
            <i class="fas fa-file-excel"></i> Exporter Excel
        </a>
        <a href="/Produit/Create" class="btn btn-primary" data-modale>
            <i class="fas fa-plus"></i> Nouveau produit
        </a>
    </div>
</div>

<p class="small text-muted mb-2">
    Import : un produit dont le code existe déjà est mis à jour, sinon il est créé ; une catégorie inconnue est créée ; la colonne Taxes contient les codes séparés par « + » (ex. TVA + CSS), vide = taxes par défaut ; la colonne Stock ne sert qu'à la création (stock initial).
    Colonnes dans l'ordre : @string.Join(", ", EasytransitCaisse.Controllers.ProduitController.ColonnesExcel)
    (le plus simple est de partir d'un export).
</p>

@if (nbAlertes > 0)
{
    <div class="alert alert-warning py-2"><i class="fas fa-triangle-exclamation"></i> @nbAlertes produit(s) au niveau ou sous le seuil d'alerte de stock. <a href="/Stock/Index">Voir le stock</a></div>
}

<div class="card shadow-sm border-0">
    <div class="card-body table-responsive">
        <table id="produitsTable" class="table table-hover align-middle mb-0" data-vue-de="produits" data-vue="liste">
            <thead class="table-dark">
                <tr>
                    <th>Code</th>
                    <th>Produit</th>
                    <th>Catégorie</th>
                    <th>Code-barres</th>
                    <th class="text-end">Prix TTC</th>
                    <th>Taxes</th>
                    <th class="text-end">Stock</th>
                    <th class="text-center">Statut</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr data-id="@p.Id">
                        <td class="fw-semibold">@p.Code</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (EasytransitCaisse.Data.Images.UrlImage(p) is string img)
                                {
                                    <img src="@img" alt="" class="vignette-image vignette-petite" loading="lazy" />
                                }
                                <span>@p.Nom</span>
                            </div>
                        </td>
                        <td>
                            @if (p.Categorie != null)
                            {
                                <span class="pastille-categorie" style="background: @p.Categorie.Couleur"></span> @p.Categorie.Nom
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-muted small">@p.CodeBarres</td>
                        <td class="text-end fw-semibold text-nowrap" data-order="@p.PrixVente.ToString(System.Globalization.CultureInfo.InvariantCulture)">@p.PrixVente.ToString("N0")@if (p.Unite != "Unité")
                            {
                                <span class="small fw-normal text-muted"> / @p.Unite</span>
                            }</td>
                        <td class="text-nowrap">
                            @if (Taxes(p) != "")
                            {
                                @Taxes(p) <span class="text-muted small">· @Qte(p.TauxTVA) %</span>
                            }
                            else
                            {
                                <span class="text-muted">Aucune</span>
                            }
                        </td>
                        <td class="text-end text-nowrap" data-order="@(p.SuiviStock ? p.StockActuel.ToString(System.Globalization.CultureInfo.InvariantCulture) : "-1")">
                            @if (!p.SuiviStock)
                            {
                                <span class="text-muted small">Non suivi</span>
                            }
                            else if (p.EnAlerteStock)
                            {
                                <span class="badge bg-danger" title="Stock au niveau ou sous le seuil d'alerte">@Qte(p.StockActuel)</span>
                            }
                            else
                            {
                                @Qte(p.StockActuel)
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge @(p.Actif ? "bg-success" : "bg-secondary")">@(p.Actif ? "Actif" : "Inactif")</span>
                        </td>
                        <td class="text-center text-nowrap">
                            <div class="d-inline-flex gap-1">
                                <a href="/Produit/Edit/@p.Id" class="btn btn-warning btn-sm">Modifier</a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Supprimer ce produit ?')">
                                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @* Cartes : mêmes produits, page et ordre que le tableau (synchronisés après chaque tri ou recherche). *@
        <div id="produitsCartes" class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xxl-4 g-3 d-none" data-vue-de="produits" data-vue="cartes">
            @foreach (var p in Model)
            {
                <div class="col" data-id="@p.Id">
                    <article class="carte-liste h-100 d-flex flex-column" style="--couleur: @(p.Categorie?.Couleur ?? "#999997")">
                        <div class="p-3 d-flex flex-column gap-2 flex-grow-1">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <h3 class="h6 fw-bold mb-1">@p.Nom</h3>
                                    <div class="small text-muted">@p.Code
                                        @if (!string.IsNullOrEmpty(p.CodeBarres))
                                        {
                                            <text> · <i class="fas fa-barcode"></i> @p.CodeBarres</text>
                                        }
                                    </div>
                                </div>
                                <span class="badge @(p.Actif ? "bg-success" : "bg-secondary")">@(p.Actif ? "Actif" : "Inactif")</span>
                            </div>
                            <div class="small">
                                @if (p.Categorie != null)
                                {
                                    <span class="pastille-categorie" style="background: @p.Categorie.Couleur"></span> @p.Categorie.Nom
                                }
                                else
                                {
                                    <span class="text-muted">Sans catégorie</span>
                                }
                            </div>
                            <div class="d-flex justify-content-between align-items-end gap-2 mt-auto">
                                <div>
                                    <div class="carte-prix">@p.PrixVente.ToString("N0") <span class="small fw-normal text-muted">FCFA TTC@(p.Unite != "Unité" ? " / " + p.Unite : "")</span></div>
                                    <div class="small text-muted">@(Taxes(p) != "" ? Taxes(p) + " · " + Qte(p.TauxTVA) + " %" : "Sans taxe")@(p.Cout.HasValue ? " · coût " + p.Cout.Value.ToString("N0") : "")</div>
                                </div>
                                <div class="text-end small">
                                    @if (!p.SuiviStock)
                                    {
                                        <span class="text-muted">Stock non suivi</span>
                                    }
                                    else
                                    {
                                        <div class="text-muted">Stock</div>
                                        <span class="fw-bold @(p.EnAlerteStock ? "badge bg-danger" : "")" title="@(p.EnAlerteStock ? "Stock au niveau ou sous le seuil d'alerte" : null)">@Qte(p.StockActuel)</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="carte-actions px-3 py-2 d-flex gap-2 justify-content-end">
                            <a href="/Produit/Edit/@p.Id" class="btn btn-warning btn-sm">Modifier</a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Supprimer ce produit ?')">
                                <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                            </form>
                        </div>
                    </article>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const cartes = document.getElementById('produitsCartes');
            $('#produitsTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json'
                },
                pageLength: 20,
                lengthMenu: [20, 50, 100],
                order: [[1, 'asc']],
                columnDefs: [{ orderable: false, targets: 8 }],  // colonne Actions
                dom: '<"d-flex justify-content-between align-items-center mb-3"lf>rtip',
                // Cartes placées juste après le tableau, avant le pied (infos et pagination).
                initComplete: function () {
                    document.getElementById('produitsTable').after(cartes);
                    synchroniserCartes(this.api());
                },
                drawCallback: function () { synchroniserCartes(this.api()); }
            });

            // Affichage en cartes : la recherche, le tri et la pagination du tableau s'appliquent aussi aux cartes.
            function synchroniserCartes(tableau) {
                const parId = {};
                cartes.querySelectorAll(':scope > [data-id]').forEach(function (c) { parId[c.dataset.id] = c; c.classList.add('d-none'); });
                tableau.rows({ page: 'current' }).nodes().each(function (tr) {
                    const carte = parId[tr.dataset.id];
                    if (carte) { carte.classList.remove('d-none'); cartes.appendChild(carte); }
                });
            }
        });
    </script>
}
