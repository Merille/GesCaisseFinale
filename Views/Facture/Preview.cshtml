@model EasytransitCaisse.Models.ViewModels.FacturePrintViewModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Facture</title>

    <style>
            body {
                font-family: Arial;
                font-size: 13px;
            }

            .header {
                text-align: center;
                margin-bottom: 20px;
            }

            .info {
                margin-bottom: 20px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            th {
                background: #333;
                color: white;
                padding: 8px;
            }

            td {
                padding: 6px;
                border-bottom: 1px solid #ddd;
            }

            .total {
                text-align: right;
                font-weight: bold;
            }
    </style>
</head>

<body>

    <div class="container-fluid">

        <!-- Barre d'actions -->
        <div class="mb-3 no-print">
            <a asp-action="Edit"
               asp-route-id="@Model.Facture.Id"
               class="btn btn-secondary">
                Retour
            </a>

            <button onclick="window.print()" class="btn btn-primary">
                <i class="fa fa-print"></i>
                Imprimer
            </button>
        </div>

        <!-- Facture -->
        <div id="facture">

    <div style="display:flex; justify-content:space-between; margin-bottom:20px;">
        <partial name="_EnTeteSociete" model="(int?)Model.Facture.TenantId" />
        <div style="text-align:right;">
            <h4 style="margin:0;">RÉPUBLIQUE GABONAISE</h4>
            <p style="margin:0;">Union - Travail - Justice</p>
        </div>
    </div>
    <hr />
    <div class="header">
        <h2>FACTURE</h2>
        <h4>N° @Model.Facture.Numero</h4>
    </div>

    <div class="info">
        <p><b>Date :</b> @Model.Facture.DateFacture.ToString("dd/MM/yyyy")</p>
        <p><b>Statut :</b> @Model.Facture.Statut</p>
        <p><b>Client :</b> @Model.Facture.ClientId</p>
    </div>

    <table>

        <thead>
            <tr>
                <th>Désignation</th>
                <th>Qté</th>
                <th>PU</th>
                <th>Total</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var l in Model.Lignes)
            {
                <tr>
                    <td>@l.Designation</td>
                    <td class="text-end">@l.Quantite</td>
                    <td class="text-end">@l.PrixUnitaire.ToString("N2")</td>
                    <td class="text-end">@l.TotalLigne.ToString("N2")</td>
                </tr>
            }

        </tbody>

    </table>

    <br />

    <div class="total">
        <p>HT : @Model.Facture.MontantHT.ToString("N2")</p>
        <p>TVA : @Model.Facture.MontantTVA.ToString("N2")</p>
        <p>TTC : @Model.Facture.MontantTTC.ToString("N2")</p>
    </div>
        </div>

    </div>

</body>
</html>