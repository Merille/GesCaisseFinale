@model EasytransitCaisse.Models.Facture
@{
    ViewData["Title"] = "Factures";
}
<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header bg-brand text-white">
            Nouvelle facture
        </div>

        <div class="card-body">

            <form method="post">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label>Numéro (*)</label>
                        <input name="Numero"
                               class="form-control" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label>Client (*)</label>

                        <select name="ClientId"
                                class="form-select" required>

                            @foreach (var client in ViewBag.Clients)
                            {
                                <option value="@client.Id">
                                    @client.NomSociete
                                </option>
                            }

                        </select>
                    </div>
                   
                    <div class="col-md-4 mb-3">
                        <label>TVA (%)</label>
                        <input name="TauxTVA"
                               value="0"
                               class="form-control" />
                    </div>

                </div>

                <div class="text-end">

                    <button class="btn btn-success">
                        Enregistrer
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>