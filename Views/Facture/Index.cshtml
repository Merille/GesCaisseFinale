@model List<EasytransitCaisse.Models.Facture>

@{
    ViewData["Title"] = "Factures";
}
<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">
        <h3>Liste des factures</h3>

        <a href="/Facture/Create"
               class="btn btn-primary">
            Nouvelle facture
        </a>
    </div>

    <div class="card shadow-sm">

        <table id="facturesTable" class="table table-hover mb-0">

            <thead class="table-dark">
                <tr>
                    <th>Numéro</th>
                    <th>Date</th>
                    <th>Montant TTC</th>
                    <th>Statut</th>
                    <th width="120">Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Numero</td>
                        <td data-order="@item.DateFacture.ToString("yyyy-MM-dd")">@item.DateFacture.ToShortDateString()</td>
                        <td>@item.MontantTTC.ToString("N0")</td>
                        <td>@item.Statut</td>
                        <td>
                            <a href="/Facture/Edit/@item.Id"
                                   class="btn btn-primary btn-sm">
                                Ouvrir
                            </a>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#facturesTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json'
                },
                pageLength: 20,
                lengthMenu: [20, 50, 100],
                order: [[1, 'desc']],
                columnDefs: [{ orderable: false, targets: 4 }],  // colonne Actions
                dom: '<"d-flex justify-content-between align-items-center mb-3"lf>rtip'
            });
        });
    </script>
}
