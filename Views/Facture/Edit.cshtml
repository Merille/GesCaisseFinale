@model EasytransitCaisse.Models.Facture
@{
    ViewData["Title"] = "Factures";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h3>Détail facture</h3>

    </div>
    @* <a href="/Facture/Print/@Model.Id"
           class="btn btn-dark">
        Imprimer PDF
    </a> *@
    <a asp-action="Preview"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        <i class="fa fa-eye"></i> Aperçu
    </a>
    <a href="/Facture/Index">
        <button class="btn btn-outline-primary">
            Liste des factures
        </button>
    </a>
    
    <br /><br />
    <div class="card shadow-lg">
        
        <div class="card-header bg-primary text-white">
            Facture @Model.Numero
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-3">
                    <label>Montant HT</label>
                    <input class="form-control"
                           readonly
                           value="@Model.MontantHT.ToString("N0")" />
                </div>

                <div class="col-md-3">
                    <label>TVA</label>
                    <input class="form-control"
                           readonly
                           value="@Model.TauxTVA.ToString("N0")" />
                </div>

                <div class="col-md-3">
                    <label>TTC</label>
                    <input class="form-control"
                           readonly
                           value="@Model.MontantTTC.ToString("N0")" />
                </div>

                <div class="col-md-3">
                    <label>Statut</label>
                    <input class="form-control"
                           readonly
                           value="@Model.Statut" />
                </div>

            </div>

        </div>

    </div>

    <div class="card shadow-lg mt-4">

        <div class="card-header bg-success text-white">
            Ajouter une ligne
        </div>

        <div class="card-body">

            <form method="post"
                  asp-action="AjouterLigne">

                <input type="hidden"
                       name="factureId"
                       value="@Model.Id" />

                <div class="row">

                    <div class="col-md-5">
                        <label>Désignation</label>
                        <input name="designation"
                               class="form-control" />
                    </div>

                    <div class="col-md-2">
                        <label>Qté</label>
                        <input name="quantite"
                               class="form-control" />
                    </div>

                    <div class="col-md-2">
                        <label>PU</label>
                        <input name="prixUnitaire"
                               class="form-control" />
                    </div>

                    <div class="col-md-3 d-flex align-items-end">

                        <button class="btn btn-success w-100">
                            Ajouter
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="card shadow-lg mt-4">

        <div class="card-header bg-brand text-white">
            Lignes de facture
        </div>

        <div class="card-body p-0">

            <table class="table table-hover mb-0">

                <thead>
                    <tr>
                        <th>Désignation</th>
                        <th>Qté</th>
                        <th>PU</th>
                        <th>Total</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var ligne in ViewBag.Lignes)
                    {
                        <tr>
                            <td>@ligne.Designation</td>
                            <td>@ligne.Quantite</td>
                            <td>@ligne.PrixUnitaire.ToString("N0")</td>
                            <td>@ligne.TotalLigne.ToString("N0")</td>
                            <td>
                                <form asp-action="SupprimerLigne" asp-route-id="@ligne.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Voulez-vous supprimer cette ligne ?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
    <br />
    <form method="post"
          asp-action="ValiderFacture">

        <input type="hidden"
               name="factureId"
               value="@Model.Id" />

        <button class="btn btn-primary">
            Valider la facture
        </button>

    </form>
</div>