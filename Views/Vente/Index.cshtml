@model List<EasytransitCaisse.Models.CommandePos>
@{
    ViewData["Title"] = "Ventes";
    var clients = (Dictionary<int, string>)ViewBag.Clients;
    var vendeurs = (Dictionary<int, string>)ViewBag.Vendeurs;
    var journee = (EasytransitCaisse.Models.JourneeCaisse?)ViewBag.Journee;
}

<partial name="_Messages" />

@if (journee != null)
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <span class="text-muted">Journée @journee.Caisse?.ChkCode du @journee.DateJournee.ToString("dd/MM/yyyy")</span>
        <a class="btn btn-sm btn-outline-secondary" href="/Vente/Index">Toutes les ventes</a>
        @if (journee.Statut == "Ouverte")
        {
            <a class="btn btn-sm btn-success" href="/Pos/Index?journee=@journee.Id"><i class="fas fa-store"></i> Retour au POS</a>
        }
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body table-responsive">
        <table id="ventesTable" class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Ticket</th>
                    <th>Date</th>
                    <th>Caisse</th>
                    <th>Client</th>
                    <th>Vendeur</th>
                    <th class="text-end">Total TTC</th>
                    <th class="text-center">Statut</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td class="fw-semibold">@v.Numero</td>
                        <td class="text-nowrap" data-order="@v.DateCommande.ToString("yyyy-MM-ddTHH:mm:ss")">@v.DateCommande.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@v.JourneeCaisse?.Caisse?.ChkCode</td>
                        <td>@(v.ClientId.HasValue && clients.TryGetValue(v.ClientId.Value, out var c) ? c : "—")</td>
                        <td>@(vendeurs.TryGetValue(v.UtilisateurId, out var u) ? u : "")</td>
                        <td class="text-end fw-semibold text-nowrap @(v.TotalTTC < 0 ? "text-danger" : "")" data-order="@v.TotalTTC.ToString(System.Globalization.CultureInfo.InvariantCulture)">@v.TotalTTC.ToString("N0")</td>
                        <td class="text-center"><partial name="_Statut" model="v.Statut" /></td>
                        <td class="text-center text-nowrap">
                            <a href="/Vente/Details/@v.Id" class="btn btn-primary btn-sm">Ouvrir</a>
                            <a href="/Pos/Ticket/@v.Id" target="_blank" class="btn btn-outline-primary btn-sm" title="Ticket"><i class="fas fa-print"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#ventesTable').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json' },
                pageLength: 20,
                lengthMenu: [20, 50, 100],
                order: [[1, 'desc']],
                columnDefs: [{ orderable: false, targets: 7 }],
                dom: '<"d-flex justify-content-between align-items-center mb-3"lf>rtip'
            });
        });
    </script>
}
