@model EasytransitCaisse.Models.ViewModels.RapportLingeVM
@using EasytransitCaisse.Models.ViewModels
@{
    ViewData["Title"] = "Rapport des dépôts de linge";
    var f = Model.Filtres;
    var requete = "du=" + f.Du.ToString("yyyy-MM-dd") + "&au=" + f.Au.ToString("yyyy-MM-dd") + (f.Statut != "" ? "&statut=" + Uri.EscapeDataString(f.Statut) : "");
    var t = Model.Total;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var cartes = new (string Libelle, decimal Valeur, string Icone, bool Montant)[]
    {
        ("Dépôts", t.Nombre, "fa-shirt", false), ("À retirer", Model.ParStatut["En cours"].Nombre + Model.ParStatut["Prêt"].Nombre, "fa-hourglass-half", false),
        ("En retard", t.EnRetard, "fa-triangle-exclamation", false), ("Montant des dépôts", t.Montant, "fa-cart-shopping", true),
        ("Acomptes versés", t.Acomptes, "fa-hand-holding-dollar", true), ("Reste à encaisser", t.Reste, "fa-coins", true)
    };
    string Badge(string s) => s switch { "En cours" => "bg-warning text-dark", "Prêt" => "bg-info text-dark", "Retiré" => "bg-success", _ => "bg-secondary" };
}
<form method="get" action="/RapportLinge/Index" class="card shadow-sm border-0 mb-3">
    <div class="card-body d-flex flex-wrap align-items-end gap-3">
        <div><label class="form-label small fw-semibold text-muted mb-1" for="du">Déposés du</label><input type="date" class="form-control" id="du" name="du" value="@f.Du.ToString("yyyy-MM-dd")" disabled="@f.SansPeriode"></div>
        <div><label class="form-label small fw-semibold text-muted mb-1" for="au">Au</label><input type="date" class="form-control" id="au" name="au" value="@f.Au.ToString("yyyy-MM-dd")" disabled="@f.SansPeriode"></div>
        <div>
            <label class="form-label small fw-semibold text-muted mb-1" for="statut">Statut</label>
            <select class="form-select" id="statut" name="statut" onchange="['du', 'au'].forEach(i => document.getElementById(i).disabled = this.value === 'À retirer' || this.value === 'En retard')">
                <option value="">Tous</option>
                @foreach (var s in FiltresRapportLinge.Choix)
                {
                    <option selected="@(f.Statut == s)">@s</option>
                }
            </select>
        </div>
        <button class="btn btn-primary"><i class="fas fa-search"></i> Filtrer</button>
        <div class="ms-auto d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary" href="/RapportLinge/Imprimer?@requete" target="_blank"><i class="fas fa-print"></i> Imprimer / PDF</a>
            <a class="btn btn-success" href="/RapportLinge/Excel?@requete"><i class="fas fa-file-excel"></i> Exporter Excel</a>
        </div>
    </div>
</form>
<p class="small text-muted">@f.Periode.</p>

<div class="row g-3 mb-3">
    @foreach (var c in cartes)
    {
        <div class="col-6 col-lg"><div class="card border-0 shadow-sm h-100"><div class="card-body">
            <div class="small text-muted"><i class="fas @c.Icone"></i> @c.Libelle</div>
            <div class="fs-5 fw-bold@(c.Libelle == "En retard" && c.Valeur > 0 ? " text-danger" : "")">
                @if (c.Montant)
                {
                    @RapportLingeVM.Fcfa(c.Valeur) <small class="fs-6 fw-normal text-muted">FCFA</small>
                }
                else
                {
                    @c.Valeur.ToString("0")
                }
            </div>
        </div></div></div>
    }
</div>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-header bg-white fw-semibold">Par statut</div>
    <div class="card-body table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark"><tr><th>Statut</th><th class="text-end">Dépôts</th><th class="text-end">Articles</th><th class="text-end">Montant</th>
                <th class="text-end">Acomptes</th><th class="text-end">Reste à encaisser</th><th class="text-end">En retard</th></tr></thead>
            <tbody>
                @foreach (var (statut, s) in Model.ParStatut)
                {
                    <tr class="@(statut == "Annulé" ? "text-muted" : "")">
                        <td><span class="badge @Badge(statut)">@statut</span></td>
                        <td class="text-end">@s.Nombre</td>
                        <td class="text-end">@RapportLingeVM.Qte(s.Articles)</td>
                        <td class="text-end text-nowrap">@RapportLingeVM.Fcfa(s.Montant)</td>
                        <td class="text-end text-nowrap">@RapportLingeVM.Fcfa(s.Acomptes)</td>
                        <td class="text-end text-nowrap fw-semibold">@RapportLingeVM.Fcfa(s.Reste)</td>
                        <td class="text-end">@s.EnRetard</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light fw-bold"><td>Total (hors annulés)</td><td class="text-end">@t.Nombre</td><td class="text-end">@RapportLingeVM.Qte(t.Articles)</td>
                    <td class="text-end text-nowrap">@RapportLingeVM.Fcfa(t.Montant)</td><td class="text-end text-nowrap">@RapportLingeVM.Fcfa(t.Acomptes)</td>
                    <td class="text-end text-nowrap">@RapportLingeVM.Fcfa(t.Reste)</td><td class="text-end">@t.EnRetard</td></tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white fw-semibold">Détail des dépôts</div>
    <div class="card-body table-responsive">
        <table id="depotsLingeTable" class="table table-hover align-middle mb-0 small">
            <thead class="table-dark"><tr><th>N°</th><th>Déposé le</th><th>Client</th><th class="text-end">Articles</th><th class="text-end">Montant</th><th class="text-end">Acompte</th>
                <th class="text-end">Reste</th><th>Retrait prévu</th><th>Statut</th></tr></thead>
            <tbody>
                @for (var i = 0; i < Model.Lignes.Count; i++)
                {
                    var l = Model.Lignes[i];
                    var d = l.Depot;
                    <tr>
                        <td class="fw-semibold" data-order="@d.Numero">@d.Numero</td>
                        <td class="text-nowrap" data-order="@i.ToString("000000")">@d.DateDepot.ToString("dd/MM/yyyy HH:mm")<small class="d-block text-muted">@l.Caisse</small></td>
                        <td>@d.NomClient@if (!string.IsNullOrEmpty(d.TelephoneClient)) {<small class="d-block text-muted">@d.TelephoneClient</small>}</td>
                        <td class="text-end">@RapportLingeVM.Qte(d.NbArticles)</td>
                        <td class="text-end text-nowrap" data-order="@d.Total.ToString(inv)">@RapportLingeVM.Fcfa(d.Total)</td>
                        <td class="text-end text-nowrap" data-order="@d.Acompte.ToString(inv)">@if (d.Acompte > 0) {@RapportLingeVM.Fcfa(d.Acompte)} else {<span class="text-muted">—</span>}</td>
                        <td class="text-end text-nowrap fw-semibold" data-order="@l.Reste.ToString(inv)">@if (l.Reste > 0) {@RapportLingeVM.Fcfa(l.Reste)} else {<span class="text-muted">—</span>}</td>
                        <td class="text-nowrap@(l.EnRetard ? " text-danger fw-semibold" : "")" data-order="@(d.DateRetraitPrevue?.ToString("yyyy-MM-dd") ?? "")">@if (d.DateRetraitPrevue.HasValue) {@(d.DateRetraitPrevue.Value.ToString("dd/MM/yyyy") + (l.EnRetard ? " (en retard)" : ""))} else {<span class="text-muted">—</span>}</td>
                        <td class="text-nowrap"><span class="badge @Badge(d.Statut)">@d.Statut</span>@if (l.Fin.HasValue) {<small class="d-block text-muted">le @l.Fin.Value.ToString("dd/MM/yyyy HH:mm")</small>}
                            @if (d.CommandePosId.HasValue) {<a class="small" href="/Vente/Details/@d.CommandePosId" title="@l.NumeroVente"><i class="fas fa-receipt"></i> voir la vente</a>}</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="small text-muted mt-2 mb-0">Montant : articles du dépôt (TTC). Acompte : versé au dépôt, encaissé dans la journée du dépôt (remboursé si le dépôt est annulé).
            Reste à encaisser : montant moins acompte, pour les dépôts en cours ou prêts. Les totaux ne comptent pas les dépôts annulés.</p>
    </div>
</div>

@section Scripts {
    <script>
        $('#depotsLingeTable').DataTable({
            language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json' },
            pageLength: 20,
            lengthMenu: [20, 50, 100],
            order: [[1, 'desc']],
            dom: '<"d-flex justify-content-between align-items-center mb-3"lf>rtip'
        });
    </script>
}
