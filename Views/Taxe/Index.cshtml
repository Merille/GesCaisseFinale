@model List<EasytransitCaisse.Models.Taxe>
@using System.Globalization
@{
    ViewData["Title"] = "Taxes";
    var nbProduits = (Dictionary<int, int>)ViewBag.NbProduits;
    string Taux(decimal t) => t == Math.Floor(t) ? t.ToString("N0", new CultureInfo("fr-FR")) : t.ToString("N2", new CultureInfo("fr-FR"));
}

<partial name="_Messages" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Taxes des produits</h4>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalTaxe" data-id="">
        <i class="fas fa-plus"></i> Nouvelle taxe
    </button>
</div>
<p class="small text-muted">
    Un produit peut porter plusieurs taxes (ex. TVA 18 % + CSS 1 %) : elles s'additionnent sur le prix HT
    et sont comprises dans le prix de vente TTC. Les taxes « par défaut » sont cochées sur un nouveau produit.
</p>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Code</th>
                    <th>Libellé</th>
                    <th class="text-end">Taux</th>
                    <th class="text-center">Par défaut</th>
                    <th class="text-center">Produits</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Aucune taxe.</td></tr>
                }
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="fw-semibold">@t.Code</td>
                        <td>@t.Libelle</td>
                        <td class="text-end">@Taux(t.Taux) %</td>
                        <td class="text-center">
                            @if (t.ParDefaut)
                            {
                                <span class="badge bg-success">Oui</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-center">@(nbProduits.TryGetValue(t.Id, out var n) ? n : 0)</td>
                        <td class="text-center">
                            <div class="d-inline-flex gap-1">
                                <button class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#modalTaxe"
                                        data-id="@t.Id" data-code="@t.Code" data-libelle="@t.Libelle"
                                        data-taux="@t.Taux.ToString("0.##", CultureInfo.InvariantCulture)" data-defaut="@(t.ParDefaut ? "1" : "0")">Modifier</button>
                                <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Supprimer cette taxe ?')">
                                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalTaxe" tabindex="-1" aria-labelledby="taxeTitre" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form class="modal-content" method="post" asp-action="Save">
            <div class="modal-header bg-brand text-white">
                <h5 class="modal-title" id="taxeTitre">Taxe</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="Id" id="taxeId" value="0" />
                <div class="row g-3">
                    <div class="col-5">
                        <label class="form-label" for="taxeCode">Code</label>
                        <input id="taxeCode" name="Code" class="form-control" placeholder="Ex : CSS" maxlength="20" required />
                    </div>
                    <div class="col-7">
                        <label class="form-label" for="taxeTaux">Taux (%)</label>
                        <input id="taxeTaux" name="Taux" class="form-control" inputmode="decimal" placeholder="Ex : 1" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="taxeLibelle">Libellé</label>
                        <input id="taxeLibelle" name="Libelle" class="form-control" placeholder="Ex : Contribution spéciale de solidarité" required />
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="true" name="ParDefaut" id="taxeDefaut" />
                            <input type="hidden" name="ParDefaut" value="false" />
                            <label class="form-check-label" for="taxeDefaut">Cochée par défaut sur un nouveau produit</label>
                        </div>
                    </div>
                </div>
                <div class="form-text mt-3">Modifier un taux met à jour les produits qui portent cette taxe ; les ventes déjà enregistrées gardent leur taux.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalTaxe').addEventListener('show.bs.modal', function (e) {
            const d = e.relatedTarget ? e.relatedTarget.dataset : {};
            document.getElementById('taxeTitre').textContent = d.id ? 'Modifier la taxe' : 'Nouvelle taxe';
            document.getElementById('taxeId').value = d.id || '0';
            document.getElementById('taxeCode').value = d.code || '';
            document.getElementById('taxeLibelle').value = d.libelle || '';
            document.getElementById('taxeTaux').value = d.taux || '';
            document.getElementById('taxeDefaut').checked = d.defaut === '1';
        });
    </script>
}
