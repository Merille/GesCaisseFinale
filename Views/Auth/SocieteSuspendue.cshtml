@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Société suspendue</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            min-height: 100vh;
            background: #1a1a2e;
        }

        .container {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .box {
            width: 440px;
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            text-align: center;
        }

        h2 {
            color: #dc3545;
            margin-bottom: 15px;
        }

        p {
            color: #333;
            font-size: 15px;
            line-height: 1.5;
        }

        a {
            display: inline-block;
            margin-top: 20px;
            padding: 10px 20px;
            background: #195d84;
            color: white;
            border-radius: 6px;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <div class="container">
        <div class="box">
            <h2>⛔ Société suspendue</h2>
            <p>
                L'accès de votre société à EasyCaisse est actuellement suspendu
                (licence désactivée ou abonnement expiré).
            </p>
            <p>
                Merci de contacter votre administrateur pour régulariser la situation.
            </p>
            <a href="/Auth/Logout">Se déconnecter</a>
        </div>
    </div>

</body>
</html>
