@model EasytransitCaisse.Models.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Connexion</title>

    <style>
            body {
                margin: 0;
                font-family: Arial;
                min-height: 100vh;
                /* Image de fond */
                background-image: url('/Images/login.jpg');
                /* background-image: url('https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=1920'); */
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
            }

                /* Overlay sombre */
                body::before {
                    content: '';
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: rgba(0, 0, 0, 0.55);
                    z-index: 0;
                }

            .container {
                height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                position: relative;
                z-index: 1;
            }

            .login-box {
                width: 380px;
                background: #195d84; /* bleu du logo M-ITECH AFRICA */
                /* background: rgba(255, 255, 255, 0.95); */
                padding: 40px;
                border-radius: 12px;
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            }

            h2 {
                text-align: center;
                margin-bottom: 25px;
                color: white;
                /* color: #1a1a2e; */
                font-size: 30px;
                letter-spacing: 1px;
            }

            .form-group {
                margin-bottom: 18px;
            }

            label {
                display: block;
                margin-bottom: 6px;
                color: white;
                /* color: #333; */
                font-size: 14px;
            }

            input {
                width: 100%;
                padding: 11px;
                border: 1px solid #ddd;
                border-radius: 6px;
                box-sizing: border-box;
                font-size: 14px;
                transition: border-color 0.2s;
            }

                input:focus {
                    outline: none;
                    border-color: #999997;
                    box-shadow: 0 0 0 3px rgba(153, 153, 151, 0.35);
                }

            button {
                width: 100%;
                padding: 12px;
                border: none;
                background: #0b2f44;
                /* background: #0d6efd; */
                color: white;
                border-radius: 6px;
                cursor: pointer;
                font-size: 15px;
                margin-top: 5px;
                transition: background 0.2s;
            }

                button:hover {
                    background: #12445f;
                }

            .error-msg {
                background: #fff3f3;
                color: #dc3545;
                border: 1px solid #f5c6cb;
                border-radius: 6px;
                padding: 10px;
                margin-bottom: 15px;
                font-size: 14px;
            }
    </style>

</head>

<body>

    <div class="container">

        <div class="login-box">

            <h2>GESTION CAISSE</h2>

            <form method="post">

                @if (ViewBag.Error != null)
                {
                    <div style="color:red;margin-bottom:10px;">
                        @ViewBag.Error
                    </div>
                }

                <div class="form-group">
                    <label>Utilisateur</label>

                    <input asp-for="Username" />
                </div>

                <div class="form-group">
                    <label>Mot de passe</label>

                    <input asp-for="Password" type="password" />
                </div>

                <button type="submit">
                    Se connecter
                </button>

            </form>

        </div>

    </div>

</body>
</html>