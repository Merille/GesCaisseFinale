@using Microsoft.AspNetCore.Mvc.Rendering
@using EasytransitCaisse.Data
@using EasytransitCaisse.Services
@inject AppDbContext DbContext
@inject ITenantProvider TenantProvider

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isSuperAdmin = User.HasClaim(AppClaimTypes.Profil, "SuperAdmin");
    var nomUtilisateur = User.Identity?.Name;
    var nomSociete = User.FindFirst(AppClaimTypes.TenantName)?.Value;

    // Sociétés disponibles pour le sélecteur du SuperAdmin, et nom de celle
    // actuellement consultée (le cas échéant) pour l'affichage.
    List<Tenant> societesDisponibles = new();
    string? societeConsultee = null;

    if (isSuperAdmin)
    {
        societesDisponibles = DbContext.Tenants.OrderBy(t => t.Nom).ToList();
        societeConsultee = TenantProvider.TenantId != 0
            ? societesDisponibles.FirstOrDefault(t => t.Id == TenantProvider.TenantId)?.Nom
            : null;
    }

    // Journées encore ouvertes (badge du menu "Caisses"), dans le périmètre
    // de la société consultée grâce au filtre multi-société du contexte.
    var nbJourneesOuvertes = DbContext.JourneesCaisses.Count(j => j.Statut == "Ouverte");

    // Rubrique du fil d'Ariane de la barre du haut.
    var rubrique = controller switch
    {
        "Dashboard" or "Caisse" or "JourneeCaisse" or "Client" => "Activité",
        "Rapport" => "Analyse",
        "Utilisateur" or "Motif" or "ModePaiement" or "Tenant" => "Administration",
        _ => null
    };

    // Titre affiché dans la barre du haut : celui de la page, sinon celui de la rubrique.
    var titrePage = ViewData["Title"]?.ToString();
    if (string.IsNullOrWhiteSpace(titrePage))
    {
        titrePage = controller switch
        {
            "Client" => "Tiers",
            "Motif" => "Motifs",
            "ModePaiement" => "Modes de paiement",
            "Utilisateur" => "Utilisateurs",
            "Tenant" => "Sociétés",
            "Caisse" => "Caisses",
            "Rapport" => "Rapports",
            _ => "GesCaisse"
        };
    }

    var initiales = string.IsNullOrEmpty(nomUtilisateur) ? "?" : nomUtilisateur.Substring(0, Math.Min(2, nomUtilisateur.Length));
    var libelleProfil = isSuperAdmin ? "Super administrateur" : (User.FindFirst(AppClaimTypes.Profil)?.Value ?? "Utilisateur");
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@titrePage - GesCaisse</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <script>
        // Applique l'état replié du menu avant l'affichage (pas de saut visuel).
        try { if (localStorage.getItem('sidebarReplie') === '1') document.documentElement.classList.add('sidebar-replie'); } catch (e) { }
    </script>
    <style>
            body {
                margin: 0;
                background: #f5f7fb;
                font-family: 'Segoe UI', sans-serif;
            }

            .card-stat {
                border: none;
                border-radius: 20px;
                box-shadow: 0 2px 20px rgba(0,0,0,.05);
            }

            .icon-circle {
                width: 65px;
                height: 65px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 24px;
            }

            .bg-blue {
                background: var(--brand);
            }

            /* Couleur de catégorie (badges "Fournisseur"), pas une couleur de marque */
            .bg-orange {
                background: #ff7300;
            }
    </style>
</head>
<body>

    <aside class="sidebar">

        <div class="sb-brand">
            <span class="sb-logo">GC</span>
            <div class="sb-brand-text">
                <strong>GesCaisse</strong>
                <small>par M-ITECH AFRICA</small>
            </div>
        </div>

        @if (isSuperAdmin)
        {
            <form class="sb-societe" method="post" asp-controller="Tenant" asp-action="Consulter">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path)@(Context.Request.QueryString)" />
                <label for="sbSociete">Société consultée</label>
                <select id="sbSociete" name="tenantId" class="form-select form-select-sm"
                        onchange="this.form.submit()" title="Consulter les données d'une société">
                    <option value="">Toutes les sociétés</option>
                    @foreach (var s in societesDisponibles)
                    {
                        <option value="@s.Id" selected="@(s.Id == TenantProvider.TenantId)">@s.Nom</option>
                    }
                </select>
            </form>
        }
        else if (!string.IsNullOrEmpty(nomSociete))
        {
            <div class="sb-societe">
                <label>Société</label>
                <div class="sb-societe-nom" title="@nomSociete">@nomSociete</div>
            </div>
        }

        <nav class="sb-nav" aria-label="Menu principal">

            <div class="sb-section">
                <div class="sb-section-title">Activité</div>
                <a class="sb-link @(controller == "Dashboard" ? "active" : "")" href="/Dashboard/Index" title="Tableau de bord">
                    <i class="fas fa-house"></i>
                    <span class="sb-label">Tableau de bord</span>
                </a>
                <a class="sb-link @(controller == "Caisse" || controller == "JourneeCaisse" ? "active" : "")" href="/Caisse/Index" title="Caisses">
                    <i class="fas fa-cash-register"></i>
                    <span class="sb-label">Caisses</span>
                    @if (nbJourneesOuvertes > 0)
                    {
                        <span class="sb-badge">@nbJourneesOuvertes ouverte@(nbJourneesOuvertes > 1 ? "s" : "")</span>
                    }
                </a>
                <a class="sb-link @(controller == "Client" ? "active" : "")" href="/Client/Index" title="Tiers">
                    <i class="fas fa-address-book"></i>
                    <span class="sb-label">Tiers</span>
                </a>
            </div>

            <div class="sb-section">
                <div class="sb-section-title">Analyse</div>
                <a class="sb-link @(controller == "Rapport" ? "active" : "")" href="/Rapport/Operations" title="Rapports">
                    <i class="fas fa-chart-column"></i>
                    <span class="sb-label">Rapports</span>
                </a>
            </div>

            <div class="sb-section">
                <div class="sb-section-title">Administration</div>
                <a class="sb-link @(controller == "Utilisateur" ? "active" : "")" href="/Utilisateur/Index" title="Utilisateurs">
                    <i class="fas fa-user-shield"></i>
                    <span class="sb-label">Utilisateurs</span>
                </a>
                <a class="sb-link @(controller == "Motif" ? "active" : "")" href="/Motif/Index" title="Motifs">
                    <i class="fas fa-list-ul"></i>
                    <span class="sb-label">Motifs</span>
                </a>
                <a class="sb-link @(controller == "ModePaiement" ? "active" : "")" href="/ModePaiement/Index" title="Modes de paiement">
                    <i class="fas fa-money-check-dollar"></i>
                    <span class="sb-label">Modes de paiement</span>
                </a>
                @if (isSuperAdmin)
                {
                    <a class="sb-link @(controller == "Tenant" ? "active" : "")" href="/Tenant/Index" title="Sociétés">
                    <i class="fas fa-building"></i>
                    <span class="sb-label">Sociétés</span>
                </a>
                }
            </div>

        </nav>

        <div class="sb-footer">
            <div class="sb-user">
                <span class="sb-avatar" title="@nomUtilisateur">@initiales</span>
                <div class="sb-user-text">
                    <strong>@nomUtilisateur</strong>
                    <small>@libelleProfil</small>
                </div>
                <a class="sb-logout" href="/Auth/Logout" title="Se déconnecter" aria-label="Se déconnecter">
                    <i class="fas fa-right-from-bracket"></i>
                </a>
            </div>
            <button type="button" class="sb-toggle" onclick="basculerMenu()" aria-label="Réduire ou agrandir le menu">
                <i class="fas fa-angles-left" id="sbToggleIcone"></i>
                <span class="sb-toggle-texte">Réduire le menu</span>
            </button>
        </div>

    </aside>

    <div class="content">

        <header class="topbar">
            <div class="topbar-titre">
                @if (rubrique != null)
                {
                    <div class="topbar-fil">@rubrique › <strong>@titrePage</strong></div>
                }
                <h1>@titrePage</h1>
            </div>
            @if (isSuperAdmin && societeConsultee != null)
            {
                <div class="topbar-societe">Consultation : <strong>@societeConsultee</strong></div>
            }
            <span class="topbar-icone" title="Notifications"><i class="fas fa-bell"></i></span>
        </header>

        <div class="page-content">
            @RenderBody()
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
            // Menu latéral replié / déplié, mémorisé dans le navigateur.
            function basculerMenu() {
                const replie = document.documentElement.classList.toggle('sidebar-replie');
                try { localStorage.setItem('sidebarReplie', replie ? '1' : '0'); } catch (e) { }
                majIconeMenu();
            }

            function majIconeMenu() {
                const icone = document.getElementById('sbToggleIcone');
                if (!icone) return;
                const replie = document.documentElement.classList.contains('sidebar-replie');
                icone.className = 'fas ' + (replie ? 'fa-angles-right' : 'fa-angles-left');
            }

            majIconeMenu();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>