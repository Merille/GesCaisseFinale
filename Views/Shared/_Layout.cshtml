@using Microsoft.AspNetCore.Mvc.Rendering
@using EasytransitCaisse.Data
@using EasytransitCaisse.Services
@inject AppDbContext DbContext
@inject ITenantProvider TenantProvider

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isSuperAdmin = User.HasClaim(AppClaimTypes.Profil, "SuperAdmin");
    var nomUtilisateur = User.Identity?.Name;
    var nomSociete = User.FindFirst(AppClaimTypes.TenantName)?.Value;

    // Sociétés disponibles pour le sélecteur du SuperAdmin, et nom de celle
    // actuellement consultée (le cas échéant) pour l'affichage.
    List<Tenant> societesDisponibles = new();
    string? societeConsultee = null;

    if (isSuperAdmin)
    {
        societesDisponibles = DbContext.Tenants.OrderBy(t => t.Nom).ToList();
        societeConsultee = TenantProvider.TenantId != 0
            ? societesDisponibles.FirstOrDefault(t => t.Id == TenantProvider.TenantId)?.Nom
            : null;
    }
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - EasyCaisse</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" />
    <style>
            body {
                margin: 0;
                background: #f5f7fb;
                font-family: 'Segoe UI', sans-serif;
            }

            .sidebar {
                position: fixed;
                top: 0;
                left: 0;
                width: 280px;
                height: 100vh;
                background: linear-gradient(180deg, var(--brand-darker) 0%, var(--brand-dark) 45%, var(--brand) 100%);
                color: white;
                overflow-y: auto;
            }

            .logo-area {
                padding: 20px;
                text-align: center;
            }

                .logo-area img {
                    width: 100%;
                    max-width: 220px;
                    background: white;
                    padding: 10px;
                    border-radius: 10px;
                }

                .societe-connectee {
                    margin-top: 8px;
                    font-size: 13px;
                    font-weight: 600;
                    color: white;
                    background: rgba(255,255,255,.15);
                    border-radius: 20px;
                    padding: 4px 14px;
                    display: inline-block;
                }

            .menu-title {
                padding: 10px 25px;
                font-size: 12px;
                opacity: .8;
                text-transform: uppercase;
            }

            .sidebar .nav-link {
                color: white;
                padding: 15px 25px;
                margin: 5px 15px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                gap: 15px;
                font-size: 18px;
                transition: .3s;
                cursor: pointer;
            }

                .sidebar .nav-link:hover {
                    background: rgba(255,255,255,.12);
                    transform: translateX(5px);
                }

                .sidebar .nav-link.active {
                    background: #fff;
                    color: var(--brand);
                    box-shadow: 0 5px 20px rgba(0,0,0,.15);
                }

            /* Sous-menu */
            .submenu {
                display: none;
                flex-direction: column;
                padding-left: 20px;
            }

                .submenu.open {
                    display: flex;
                }

                .submenu .nav-link {
                    font-size: 15px;
                    padding: 10px 20px;
                    margin: 2px 15px;
                }

                    .submenu .nav-link i {
                        font-size: 14px;
                    }

            .arrow {
                margin-left: auto;
                font-size: 12px;
                transition: transform .3s;
            }

                .arrow.open {
                    transform: rotate(180deg);
                }

            .content {
                margin-left: 280px;
                min-height: 100vh;
            }

            .topbar {
                background: white;
                height: 80px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 30px;
                box-shadow: 0 2px 15px rgba(0,0,0,.05);
            }

            .page-content {
                padding: 30px;
            }

            .card-stat {
                border: none;
                border-radius: 20px;
                box-shadow: 0 2px 20px rgba(0,0,0,.05);
            }

            .icon-circle {
                width: 65px;
                height: 65px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 24px;
            }

            .bg-blue {
                background: var(--brand);
            }

            /* Couleur de catégorie (badges "Fournisseur"), pas une couleur de marque */
            .bg-orange {
                background: #ff7300;
            }

            .logout {
                margin: 20px;
                border: 1px solid rgba(255,255,255,.5);
                border-radius: 12px;
            }

                .logout a {
                    color: white;
                    display: block;
                    text-align: center;
                    padding: 15px;
                    text-decoration: none;
                }
    </style>
</head>
<body>

    <div class="sidebar">

        <div class="logo-area">
            <h2 class="mb-0">EasyCaisse</h2>
            @if (!string.IsNullOrEmpty(nomSociete))
            {
                <div class="societe-connectee">@nomSociete</div>
            }
            else if (isSuperAdmin)
            {
                <div class="societe-connectee">@(societeConsultee ?? "Toutes les sociétés")</div>
            }
        </div>

        @if (isSuperAdmin)
        {
            <div class="px-3 mb-3">
                <form method="post" asp-controller="Tenant" asp-action="Consulter">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path)@(Context.Request.QueryString)" />
                    <select name="tenantId" class="form-select form-select-sm"
                            onchange="this.form.submit()" title="Consulter les données d'une société">
                        <option value="">-- Toutes les sociétés --</option>
                        @foreach (var s in societesDisponibles)
                        {
                            <option value="@s.Id" selected="@(s.Id == TenantProvider.TenantId)">@s.Nom</option>
                        }
                    </select>
                </form>
            </div>
        }

        <div class="menu-title">Menu Principal</div>

        <nav class="nav flex-column">

            <a class="nav-link @(controller == "Dashboard" ? "active" : "")" href="/Dashboard/Index">
                <i class="fas fa-home"></i>
                Tableau de bord
            </a>

            @* <a class="nav-link @(controller == "Facture" ? "active" : "")" href="/Facture/Index">
                <i class="fas fa-file-invoice"></i>
                Factures
            </a> *@

            <a class="nav-link @(controller == "Caisse" ? "active" : "")" href="/Caisse/Index">
                <i class="fas fa-cash-register"></i>
                Caisse
            </a>


            <a class="nav-link @(controller == "Rapport" ? "active" : "")" href="/Rapport/Operations">
                <i class="fas fa-chart-column"></i>
                Rapports
            </a>

            <a class="nav-link @(controller == "Client" ? "active" : "")" href="/Client/Index">
                <i class="fas fa-users"></i>
                Tiers
            </a>

            @* Menu Paramètres avec sous-menu *@
            @{
                bool parametreActif = controller == "Utilisateur" || controller == "Motif"
                    || controller == "ModePaiement" || controller == "Tenant";
            }
            <a class="nav-link @(parametreActif ? "active" : "")"
               onclick="toggleSubmenu()" id="parametreMenu">
                <i class="fas fa-gear"></i>
                Paramètres
                <i class="fas fa-chevron-down arrow @(parametreActif ? "open" : "")" id="parametreArrow"></i>
            </a>

            <div class="submenu @(parametreActif ? "open" : "")" id="parametreSubmenu">
                <a class="nav-link @(controller == "Utilisateur" ? "active" : "")" href="/Utilisateur/Index">
                    <i class="fas fa-user-shield"></i>
                    Utilisateurs
                </a>
                <a class="nav-link @(controller == "Motif" ? "active" : "")" href="/Motif/Index">
                    <i class="fas fa-file-invoice"></i>
                    Motifs
                </a>
                <a class="nav-link @(controller == "ModePaiement" ? "active" : "")" href="/ModePaiement/Index">
                    <i class="fas fa-money-check-dollar"></i>
                    Modes de paiement
                </a>
                @if (isSuperAdmin)
                {
                    <a class="nav-link @(controller == "Tenant" ? "active" : "")" href="/Tenant/Index">
                        <i class="fas fa-building"></i>
                        Sociétés
                    </a>
                }

                @* <a class="nav-link @(controller == "Facture" ? "active" : "")" href="/Facture/Index">
                    <i class="fas fa-file-invoice"></i>
                    Factures
                </a> *@
            </div>

        </nav>

        <div class="logout">
            <a href="/Auth/login">
                <i class="fas fa-power-off"></i>
                Déconnexion
            </a>
        </div>

    </div>

    <div class="content">

        <div class="topbar bg-brand" style="color: white;">
            <h4 class="mb-0">@ViewData["Title"]</h4>
            <div>
                <i class="fas fa-bell me-4"></i>
                <span>
                    @nomUtilisateur
                    @if (!string.IsNullOrEmpty(nomSociete))
                    {
                        <text> — @nomSociete</text>
                    }
                    else if (isSuperAdmin && societeConsultee != null)
                    {
                        <text> — Consultation : @societeConsultee</text>
                    }
                </span>
            </div>
        </div>

        <div class="page-content">
            @RenderBody()
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
            function toggleSubmenu() {
                const submenu = document.getElementById('parametreSubmenu');
                const arrow = document.getElementById('parametreArrow');
                submenu.classList.toggle('open');
                arrow.classList.toggle('open');
            }
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>