@using Microsoft.AspNetCore.Mvc.Rendering
@using EasytransitCaisse.Data
@using EasytransitCaisse.Services
@inject AppDbContext DbContext
@inject ITenantProvider TenantProvider

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isSuperAdmin = User.HasClaim(AppClaimTypes.Profil, "SuperAdmin");
    var isAdmin = isSuperAdmin || User.HasClaim(AppClaimTypes.Profil, "Admin");
    // Module Point de vente de la société consultée (toujours oui pour « toutes les sociétés »).
    var modulePointVente = await EasytransitCaisse.Services.ModulePointVenteFilter.ActifAsync(DbContext, TenantProvider.TenantId);
    var nomUtilisateur = User.Identity?.Name;
    var nomSociete = User.FindFirst(AppClaimTypes.TenantName)?.Value;

    // Sociétés disponibles pour le sélecteur du SuperAdmin, et nom de celle
    // actuellement consultée (le cas échéant) pour l'affichage.
    List<Tenant> societesDisponibles = new();
    string? societeConsultee = null;

    if (isSuperAdmin)
    {
        societesDisponibles = DbContext.Tenants.OrderBy(t => t.Nom).ToList();
        societeConsultee = TenantProvider.TenantId != 0
            ? societesDisponibles.FirstOrDefault(t => t.Id == TenantProvider.TenantId)?.Nom
            : null;
    }

    // Journées encore ouvertes (badge du menu "Caisses"), dans le périmètre
    // de la société consultée grâce au filtre multi-société du contexte.
    var nbJourneesOuvertes = DbContext.JourneesCaisses.Count(j => j.Statut == "Ouverte");

    // Rubrique du fil d'Ariane de la barre du haut.
    var rubrique = controller switch
    {
        "Dashboard" or "TableauLaverie" or "Caisse" or "JourneeCaisse" or "Client" => "Activité",
        "Rapport" or "RapportTiers" => "Analyse",
        "Pos" or "Vente" or "Stock" or "PosRapport" or "RapportLivraison" or "RapportLinge" or "RapportAchat" or "Achat" or "Cuisine" or "Synchro" => "Point de vente",
        "Salle" => "Activité",
        "Produit" or "Categorie" or "Combo" => "Configuration",
        "Utilisateur" or "Motif" or "ModePaiement" or "Taxe" or "Unite" or "Depot" or "Livreur" or "Societe" => "Paramètres",
        "Tenant" => "Administration",
        _ => null
    };

    // Titre affiché dans la barre du haut : celui de la page, sinon celui de la rubrique.
    var titrePage = ViewData["Title"]?.ToString();
    if (string.IsNullOrWhiteSpace(titrePage))
    {
        titrePage = controller switch
        {
            "Client" => "Tiers",
            "Motif" => "Motifs",
            "ModePaiement" => "Modes de paiement",
            "Taxe" => "Taxes",
            "Unite" => "Unités de vente",
            "Depot" => "Dépôts",
            "Livreur" => "Livreurs",
            "Salle" => "Plan de salle",
            "Cuisine" => "Écran cuisine / bar",
            "Utilisateur" => "Utilisateurs",
            "Tenant" => "Sociétés",
            "Caisse" => "Caisses",
            "Rapport" => "Rapports",
            "RapportTiers" => "Rapport des tiers",
            "Pos" => "Vendre",
            "Vente" => "Ventes",
            "Produit" => "Produits",
            "Categorie" => "Catégories",
            "Combo" => "Combos",
            "Stock" => "Stock",
            "PosRapport" => "Rapports ventes",
            "RapportLivraison" => "Rapport des livraisons",
            "RapportLinge" => "Rapport des dépôts de linge",
            "Achat" => "Achats",
            "Synchro" => "Synchronisation",
            "RapportAchat" => "Rapport des achats",
            _ => "GesCaisse"
        };
    }

    var initiales = string.IsNullOrEmpty(nomUtilisateur) ? "?" : nomUtilisateur.Substring(0, Math.Min(2, nomUtilisateur.Length));
    var libelleProfil = isSuperAdmin ? "Super administrateur" : (User.FindFirst(AppClaimTypes.Profil)?.Value ?? "Utilisateur");
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@titrePage - GesCaisse</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/vendor/bootstrap/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#1b5e84" />
    <link rel="apple-touch-icon" href="/icones/icone-192.png" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <script>
        // Applique l'état replié du menu avant l'affichage (pas de saut visuel).
        try { if (localStorage.getItem('sidebarReplie') === '1') document.documentElement.classList.add('sidebar-replie'); } catch (e) { }
    </script>
    <style>
            body {
                margin: 0;
                background: #f5f7fb;
                font-family: 'Segoe UI', sans-serif;
            }

            .card-stat {
                border: none;
                border-radius: 20px;
                box-shadow: 0 2px 20px rgba(0,0,0,.05);
            }

            .icon-circle {
                width: 65px;
                height: 65px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 24px;
            }

            .bg-blue {
                background: var(--brand);
            }

            /* Couleur de catégorie (badges "Fournisseur"), pas une couleur de marque */
            .bg-orange {
                background: #ff7300;
            }
    </style>
</head>
<body>

    <aside class="sidebar">

        <div class="sb-brand">
            <span class="sb-logo">GC</span>
            <div class="sb-brand-text">
                <strong>GesCaisse</strong>
                <small>par M-ITECH AFRICA</small>
            </div>
        </div>

        @if (isSuperAdmin)
        {
            <form class="sb-societe" method="post" asp-controller="Tenant" asp-action="Consulter">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path)@(Context.Request.QueryString)" />
                <label for="sbSociete">Société consultée</label>
                <select id="sbSociete" name="tenantId" class="form-select form-select-sm"
                        onchange="this.form.submit()" title="Consulter les données d'une société">
                    <option value="">Toutes les sociétés</option>
                    @foreach (var s in societesDisponibles)
                    {
                        <option value="@s.Id" selected="@(s.Id == TenantProvider.TenantId)">@s.Nom</option>
                    }
                </select>
            </form>
        }
        else if (!string.IsNullOrEmpty(nomSociete))
        {
            <div class="sb-societe">
                <label>Société</label>
                <div class="sb-societe-nom" title="@nomSociete">@nomSociete</div>
            </div>
        }

        <nav class="sb-nav" aria-label="Menu principal">

            <div class="sb-section">
                <div class="sb-section-title">Activité</div>
                <a class="sb-link @(controller == "Dashboard" ? "active" : "")" href="/Dashboard/Index" title="Tableau de bord">
                    <i class="fas fa-house"></i>
                    <span class="sb-label">Tableau de bord</span>
                </a>
                @if (modulePointVente && DbContext.Caisses.Any(c => c.TypePointVente == "Laverie"))
                {
                    <a class="sb-link @(controller == "TableauLaverie" ? "active" : "")" href="/TableauLaverie/Index" title="Tableau de bord laverie">
                        <i class="fas fa-shirt"></i>
                        <span class="sb-label">Tableau de bord laverie</span>
                    </a>
                }
                <a class="sb-link @(controller == "Caisse" || controller == "JourneeCaisse" ? "active" : "")" href="/Caisse/Index" title="Caisses">
                    <i class="fas fa-cash-register"></i>
                    <span class="sb-label">Caisses</span>
                    @if (nbJourneesOuvertes > 0)
                    {
                        <span class="sb-badge">@nbJourneesOuvertes ouverte@(nbJourneesOuvertes > 1 ? "s" : "")</span>
                    }
                </a>
                <a class="sb-link @(controller == "Client" ? "active" : "")" href="/Client/Index" title="Tiers">
                    <i class="fas fa-address-book"></i>
                    <span class="sb-label">Tiers</span>
                </a>
            </div>

            <div class="sb-section">
                <div class="sb-section-title">Analyse</div>
                <a class="sb-link @(controller == "Rapport" ? "active" : "")" href="/Rapport/Operations" title="Rapports">
                    <i class="fas fa-chart-column"></i>
                    <span class="sb-label">Rapports</span>
                </a>
                <a class="sb-link @(controller == "RapportTiers" ? "active" : "")" href="/RapportTiers/Index" title="Rapport des tiers">
                    <i class="fas fa-users-viewfinder"></i>
                    <span class="sb-label">Rapport des tiers</span>
                </a>
            </div>

            @if (modulePointVente)
            {
            <div class="sb-section">
                <div class="sb-section-title">Point de vente</div>
                <a class="sb-link @(controller == "Pos" ? "active" : "")" href="/Pos/Index" title="Vendre">
                    <i class="fas fa-store"></i>
                    <span class="sb-label">Vendre</span>
                </a>
                <a class="sb-link @(controller == "Vente" ? "active" : "")" href="/Vente/Index" title="Ventes">
                    <i class="fas fa-receipt"></i>
                    <span class="sb-label">Ventes</span>
                </a>
                @if (EasytransitCaisse.Data.Restaurant.Actif(DbContext))
                {
                    <a class="sb-link @(controller == "Cuisine" ? "active" : "")" href="/Cuisine/Index" title="Écran cuisine / bar">
                        <i class="fas fa-fire-burner"></i>
                        <span class="sb-label">Écran cuisine / bar</span>
                    </a>
                }
                @if (isAdmin)
                {
                    @if (DbContext.Caisses.Any(c => c.TypePointVente == "Laverie"))
                    {
                        <a class="sb-link @(controller == "Achat" ? "active" : "")" href="/Achat/Index" title="Achats">
                            <i class="fas fa-cart-flatbed"></i>
                            <span class="sb-label">Achats</span>
                        </a>
                    }
                    <a class="sb-link @(controller == "Stock" ? "active" : "")" href="/Stock/Index" title="Stock">
                        <i class="fas fa-warehouse"></i>
                        <span class="sb-label">Stock</span>
                    </a>
                    @* Rapports du point de vente, regroupés (titre complet en infobulle). *@
                    var rapportsActif = controller is "PosRapport" or "RapportLivraison" or "RapportLinge" or "RapportAchat";
                    <button type="button" class="sb-link sb-parent @(rapportsActif ? "parent-actif" : "")" title="Rapports"
                            aria-expanded="@(rapportsActif ? "true" : "false")" aria-controls="sbRapportsPos" onclick="basculerSousMenu(this)">
                        <i class="fas fa-chart-line"></i>
                        <span class="sb-label">Rapports</span>
                        <i class="fas fa-chevron-down sb-chevron"></i>
                    </button>
                    <div class="sb-sub @(rapportsActif ? "open" : "")" id="sbRapportsPos">
                        <a class="sb-link @(controller == "PosRapport" ? "active" : "")" href="/PosRapport/Index" title="Rapports ventes">
                            <i class="fas fa-chart-pie"></i>
                            <span class="sb-label">Ventes</span>
                        </a>
                        <a class="sb-link @(controller == "RapportLivraison" ? "active" : "")" href="/RapportLivraison/Index" title="Rapport des livraisons">
                            <i class="fas fa-truck-fast"></i>
                            <span class="sb-label">Livraisons</span>
                        </a>
                        @if (DbContext.Caisses.Any(c => c.TypePointVente == "Laverie"))
                        {
                            <a class="sb-link @(controller == "RapportLinge" ? "active" : "")" href="/RapportLinge/Index" title="Rapport des dépôts de linge">
                                <i class="fas fa-shirt"></i>
                                <span class="sb-label">Dépôts de linge</span>
                            </a>
                            <a class="sb-link @(controller == "RapportAchat" ? "active" : "")" href="/RapportAchat/Index" title="Rapport des achats et consommations">
                                <i class="fas fa-chart-bar"></i>
                                <span class="sb-label">Achats</span>
                            </a>
                        }
                    </div>
                    var configurationActif = controller is "Categorie" or "Produit" or "Combo";
                    <button type="button" class="sb-link sb-parent @(configurationActif ? "parent-actif" : "")" title="Configuration"
                            aria-expanded="@(configurationActif ? "true" : "false")" aria-controls="sbConfiguration" onclick="basculerSousMenu(this)">
                        <i class="fas fa-sliders"></i>
                        <span class="sb-label">Configuration</span>
                        <i class="fas fa-chevron-down sb-chevron"></i>
                    </button>
                    <div class="sb-sub @(configurationActif ? "open" : "")" id="sbConfiguration">
                        <a class="sb-link @(controller == "Categorie" ? "active" : "")" href="/Categorie/Index" title="Catégories">
                            <i class="fas fa-tags"></i>
                            <span class="sb-label">Catégories</span>
                        </a>
                        <a class="sb-link @(controller == "Produit" ? "active" : "")" href="/Produit/Index" title="Produits">
                            <i class="fas fa-box-open"></i>
                            <span class="sb-label">Produits</span>
                        </a>
                        <a class="sb-link @(controller == "Combo" ? "active" : "")" href="/Combo/Index" title="Combos">
                            <i class="fas fa-layer-group"></i>
                            <span class="sb-label">Combos</span>
                        </a>
                    </div>
                    @* Synchronisation du mode hors ligne : pastille = postes qui ont des opérations à envoyer. *@
                    var postesEnAttente = DbContext.PostesHorsLigne.Count(p => p.EnAttente > 0);
                    <a class="sb-link @(controller == "Synchro" ? "active" : "")" href="/Synchro/Index" title="Synchronisation">
                        <i class="fas fa-arrows-rotate"></i>
                        <span class="sb-label">Synchronisation</span>
                        @if (postesEnAttente > 0)
                        {
                            <span class="sb-badge" title="Postes avec des opérations à envoyer">@postesEnAttente</span>
                        }
                    </a>
                }
            </div>
            }

            @if (isAdmin)
            {

            <div class="sb-section">
                <div class="sb-section-title">Administration</div>
                @{
                    var parametresActif = controller is "Utilisateur" or "Motif" or "ModePaiement" or "Taxe" or "Unite" or "Depot" or "Livreur" or "Societe";
                }
                <button type="button" class="sb-link sb-parent @(parametresActif ? "parent-actif" : "")" title="Paramètres"
                        aria-expanded="@(parametresActif ? "true" : "false")" aria-controls="sbParametres" onclick="basculerSousMenu(this)">
                    <i class="fas fa-gear"></i>
                    <span class="sb-label">Paramètres</span>
                    <i class="fas fa-chevron-down sb-chevron"></i>
                </button>
                <div class="sb-sub @(parametresActif ? "open" : "")" id="sbParametres">
                    @if (TenantProvider.TenantId > 0)
                    {
                    <a class="sb-link @(controller == "Societe" ? "active" : "")" href="/Societe/Index" title="Ma société">
                        <i class="fas fa-building-circle-check"></i>
                        <span class="sb-label">Ma société</span>
                    </a>
                    }
                    <a class="sb-link @(controller == "Utilisateur" ? "active" : "")" href="/Utilisateur/Index" title="Utilisateurs">
                        <i class="fas fa-user-shield"></i>
                        <span class="sb-label">Utilisateurs</span>
                    </a>
                    <a class="sb-link @(controller == "Motif" ? "active" : "")" href="/Motif/Index" title="Motifs">
                        <i class="fas fa-list-ul"></i>
                        <span class="sb-label">Motifs</span>
                    </a>
                    <a class="sb-link @(controller == "ModePaiement" ? "active" : "")" href="/ModePaiement/Index" title="Modes de paiement">
                        <i class="fas fa-money-check-dollar"></i>
                        <span class="sb-label">Modes de paiement</span>
                    </a>
                    @if (modulePointVente)
                    {
                    <a class="sb-link @(controller == "Taxe" ? "active" : "")" href="/Taxe/Index" title="Taxes">
                        <i class="fas fa-percent"></i>
                        <span class="sb-label">Taxes</span>
                    </a>
                    <a class="sb-link @(controller == "Unite" ? "active" : "")" href="/Unite/Index" title="Unités de vente">
                        <i class="fas fa-scale-balanced"></i>
                        <span class="sb-label">Unités de vente</span>
                    </a>
                    <a class="sb-link @(controller == "Depot" ? "active" : "")" href="/Depot/Index" title="Dépôts">
                        <i class="fas fa-warehouse"></i>
                        <span class="sb-label">Dépôts</span>
                    </a>
                    <a class="sb-link @(controller == "Livreur" ? "active" : "")" href="/Livreur/Index" title="Livreurs">
                        <i class="fas fa-motorcycle"></i>
                        <span class="sb-label">Livreurs</span>
                    </a>
                    }
                </div>
                @if (isSuperAdmin)
                {
                    <a class="sb-link @(controller == "Tenant" ? "active" : "")" href="/Tenant/Index" title="Sociétés">
                    <i class="fas fa-building"></i>
                    <span class="sb-label">Sociétés</span>
                </a>
                }
            </div>
            }

        </nav>

        <div class="sb-footer">
            <button type="button" class="sb-toggle" onclick="basculerMenu()" aria-label="Réduire ou agrandir le menu">
                <i class="fas fa-angles-left" id="sbToggleIcone"></i>
                <span class="sb-toggle-texte">Réduire le menu</span>
            </button>
        </div>

    </aside>

    <div class="content">

        <header class="topbar">
            <div class="topbar-titre">
                @if (rubrique != null)
                {
                    <div class="topbar-fil">@rubrique › <strong>@titrePage</strong></div>
                }
                <h1>@titrePage</h1>
            </div>
            @if (isSuperAdmin && societeConsultee != null)
            {
                <div class="topbar-societe">Consultation : <strong>@societeConsultee</strong></div>
            }
            @{
                var notifications = EasytransitCaisse.Data.Notifications.Lister(DbContext, isAdmin, modulePointVente);
                var nbNotifications = notifications.Sum(n => n.N);
            }
            <span class="gc-connexion"></span>
            <button type="button" class="topbar-icone d-none" id="gcInstaller" title="Installer l'application sur ce poste" aria-label="Installer l'application"><i class="fas fa-download"></i></button>
            <div class="dropdown">
                <button type="button" class="topbar-icone@(nbNotifications > 0 ? " topbar-alerte" : "")" data-bs-toggle="dropdown" aria-expanded="false" id="cloche"
                        title="@(nbNotifications > 0 ? nbNotifications + " notification" + (nbNotifications > 1 ? "s" : "") : "Aucune notification")" aria-label="Notifications">
                    <i class="fas fa-bell"></i>@if (nbNotifications > 0) {<span class="topbar-pastille">@(nbNotifications > 99 ? "99+" : nbNotifications.ToString())</span>}
                </button>
                <div class="dropdown-menu dropdown-menu-end shadow cloche-menu" aria-labelledby="cloche">
                    <div class="cloche-titre">Notifications</div>
                    @foreach (var no in notifications)
                    {
                        <a class="dropdown-item cloche-item" href="@no.Url">
                            <span class="cloche-icone" style="background: @no.Couleur"><i class="fas @no.Icone"></i></span>
                            <span class="flex-grow-1">@no.Texte</span>
                            <i class="fas fa-chevron-right text-muted small"></i>
                        </a>
                    }
                    @if (!notifications.Any())
                    {
                        <div class="cloche-vide"><i class="fas fa-circle-check text-success"></i> Rien à traiter pour le moment.</div>
                    }
                </div>
            </div>
            <div class="topbar-user dropdown">
                @* Menu de l'utilisateur (comme Odoo) : installer l'application sur le poste, se déconnecter. *@
                <button type="button" class="topbar-user-bouton" data-bs-toggle="dropdown" aria-expanded="false" title="Menu de @nomUtilisateur">
                    <span class="topbar-avatar">@initiales</span>
                    <span class="topbar-user-text">
                        <strong>@nomUtilisateur</strong>
                        <small>@libelleProfil</small>
                    </span>
                    <i class="fas fa-chevron-down topbar-user-chevron"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end shadow">
                    <button type="button" class="dropdown-item" data-gc-installer><i class="fas fa-desktop fa-fw me-2"></i><span>Installer l'application</span></button>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" href="/Auth/Logout"><i class="fas fa-right-from-bracket fa-fw me-2"></i>Se déconnecter</a>
                </div>
                <a class="topbar-logout" href="/Auth/Logout" title="Se déconnecter" aria-label="Se déconnecter">
                    <i class="fas fa-right-from-bracket"></i>
                </a>
            </div>
        </header>

        <div class="page-content">
            <partial name="_Messages" />
            @RenderBody()
        </div>

    </div>

    @* Bibliothèques servies par l'application (aucune dépendance à Internet) : wwwroot/vendor. *@
    <script src="~/vendor/bootstrap/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/vendor/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/vendor/jquery/jquery-3.7.0.min.js" asp-append-version="true"></script>
    <script src="~/vendor/datatables/jquery.dataTables.min.js" asp-append-version="true"></script>
    <script src="~/vendor/datatables/dataTables.bootstrap5.min.js" asp-append-version="true"></script>

    <script>
            // Menu latéral replié / déplié, mémorisé dans le navigateur.
            function basculerMenu() {
                const replie = document.documentElement.classList.toggle('sidebar-replie');
                try { localStorage.setItem('sidebarReplie', replie ? '1' : '0'); } catch (e) { }
                majIconeMenu();
            }

            function majIconeMenu() {
                const icone = document.getElementById('sbToggleIcone');
                if (!icone) return;
                const replie = document.documentElement.classList.contains('sidebar-replie');
                icone.className = 'fas ' + (replie ? 'fa-angles-right' : 'fa-angles-left');
            }

            majIconeMenu();

            // Ouvre / ferme un sous-menu (ex. « Paramètres »).
            function basculerSousMenu(bouton) {
                const sous = document.getElementById(bouton.getAttribute('aria-controls'));
                const ouvert = sous.classList.toggle('open');
                bouton.setAttribute('aria-expanded', ouvert ? 'true' : 'false');
            }
    </script>

    <script src="~/js/modale-creation.js" asp-append-version="true"></script>
    <script src="~/js/vues.js" asp-append-version="true"></script>
    <script src="~/js/hors-ligne.js" asp-append-version="true" data-sw="/sw.js" data-rapport="@(modulePointVente ? "/Synchro/Rapport" : null)" data-jeton="@(modulePointVente ? "/Pos/Jeton" : null)"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>