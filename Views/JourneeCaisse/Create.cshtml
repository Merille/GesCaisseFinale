@{
    ViewData["Title"] = "Journées de caisse";
}
<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header bg-brand text-white">
            Ouvrir une nouvelle journée
        </div>

        <div class="card-body">
            @if (TempData["Erreur"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Erreur"]
                </div>
            }
            <form method="post">

                <input type="hidden"
                       name="caisseId"
                       value="@ViewBag.CaisseId" />

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Date de la journée
                        </label>

                        <input type="date"
                               name="dateJournee"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               class="form-control"
                               required />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Montant initial
                        </label>

                        <input type="number"
                               step="1"
                               name="soldeInitial"
                               value="@(((decimal)ViewBag.SoldeInitialSuggere).ToString("0", System.Globalization.CultureInfo.InvariantCulture))"
                               class="form-control"
                               required />

                        <div class="form-text">
                            Solde actuel de la dernière journée — modifiable si besoin.
                        </div>

                    </div>

                </div>

                <div class="text-end">

                    <button class="btn btn-success">
                        Ouvrir la journée
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>