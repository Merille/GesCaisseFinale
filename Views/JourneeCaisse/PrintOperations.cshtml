@model EasytransitCaisse.Models.ViewModels.PrintOperationsVM
    @{
    Layout = "_PdfLayout";
}
<style>
    body { font-family: Arial; }
    table { border-collapse: collapse; }
    th { background: #333; color: white; }
</style>
<div style="display:flex; justify-content:space-between; margin-bottom:20px;">

    <!-- Gauche -->
    <div>
        <h3 style="margin:0;">EASYTRANSIT CAISSE</h3>
        <p style="margin:0;">BP : 1234</p>
        <p style="margin:0;">Tel : +242 06 000 0000</p>
        <p style="margin:0;">Email : contact@easytransit.com</p>
    </div>

    <!-- Droite -->
    <div style="text-align:right;">
        <h4 style="margin:0;">
            RÉPUBLIQUE GABONAISE
        </h4>
        <p style="margin:0;">Union - Travail - Justice</p>
    </div>

</div>

<hr />

<h2>Opérations de Caisse — Journée @Model.NumeroJournee</h2>

<table border="1" width="100%" cellpadding="5">

    <tr>
        <th>Solde Initial</th>
        <th>Encaissements</th>
        <th>Décaissements</th>
        <th>Solde Actuel</th>
    </tr>
    <tr>
        <td>@Model.SoldeInitial.ToString("N0")</td>
        <td>@Model.TotalEncaisse.ToString("N0")</td>
        <td>@Model.TotalDecaisse.ToString("N0")</td>
        <td>@Model.SoldeActuel.ToString("N0")</td>
    </tr>

</table>

<table border="1" width="100%" cellpadding="5" style="margin-top:20px;">

    <tr>
        <th>Date</th>
        <th>Type</th>
        @* <th>Motif</th> *@
        <th>Libellé</th>
        <th>Mode de paiement</th>
        <th>Montant</th>
    </tr>

    @foreach (var o in Model.Operations)
    {
        <tr>
            <td>@o.DateOperation.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@o.TypeOperation</td>
            @* <td>@o.MotifLibelle</td> *@
            <td>@o.Libelle</td>
            <td>@(o.ModePaiement?.Libelle ?? "-")</td>
            <td>@o.Montant</td>
        </tr>
    }

</table>

<h2 style="margin-top:30px;">Totaux par mode de paiement</h2>

<table border="1" width="100%" cellpadding="5">

    <tr>
        <th>Mode de paiement</th>
        <th>Encaissements</th>
        <th>Décaissements</th>
        <th>Net</th>
    </tr>

    @foreach (var t in Model.TotauxParModePaiement)
    {
        <tr>
            <td>@t.Libelle</td>
            <td>@t.Encaisse.ToString("N0")</td>
            <td>@t.Decaisse.ToString("N0")</td>
            <td>@t.Net.ToString("N0")</td>
        </tr>
    }

</table>