@model EasytransitCaisse.Models.ViewModels.PrintOperationsVM
@using EasytransitCaisse.Data
@{
    Layout = "_ImpressionLayout";
    ViewData["Pdf"] = true;
    ViewData["Republique"] = true;
    ViewData["TitreImpression"] = "Opérations " + Model.NumeroJournee;
}
<h1>Opérations de caisse — Journée @Model.NumeroJournee</h1>
<p class="muted">@(Model.CaisseCode + " · " + Model.CaisseDescription) — @Model.DateJournee.ToString("dd/MM/yyyy") — @(Model.Statut == "Ouverte" ? "Ouverte" : "Clôturée")</p>
<table>
    <tr><th class="r">Solde initial</th><th class="r">Encaissements</th><th class="r">Décaissements</th><th class="r">Solde actuel</th></tr>
    <tr><td class="r">@Model.SoldeInitial.ToString("N0")</td><td class="r">@Model.TotalEncaisse.ToString("N0")</td><td class="r">@Model.TotalDecaisse.ToString("N0")</td><td class="r">@Model.SoldeActuel.ToString("N0")</td></tr>
</table>

<h2>Totaux par mode de paiement</h2>
<table>
    <tr><th>Mode de paiement</th><th class="r">Encaissements</th><th class="r">Décaissements</th><th class="r">Net</th></tr>
    @foreach (var t in Model.TotauxParModePaiement)
    {
        <tr><td>@t.Libelle</td><td class="r">@t.Encaisse.ToString("N0")</td><td class="r">@t.Decaisse.ToString("N0")</td><td class="r">@t.Net.ToString("N0")</td></tr>
    }
</table>

<h2>Détail des opérations</h2>
<table>
    <tr><th>Date</th><th>Type</th><th>Libellé</th><th>Mode de paiement</th><th>Statut</th><th class="r">Montant</th></tr>
    @foreach (var o in Model.Operations)
    {
        <tr>
            <td>@o.DateOperation.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@o.TypeOperation</td>
            <td>@o.Libelle</td>
            <td>@(o.ModePaiement?.Libelle ?? "-")</td>
            <td>@o.StatutValidation</td>
            <td class="r">@if (o.StatutValidation == OperationCaisseQueries.StatutRejete)
            {<s>@o.Montant.ToString("N0")</s> <small>(rejetée, exclue des totaux)</small>}
            else
            {@o.Montant.ToString("N0")}</td>
        </tr>
    }
</table>
