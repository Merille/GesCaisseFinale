@model EasytransitCaisse.Models.ViewModels.PrintJourneesVM

@{
    Layout = "_PdfLayout";
}
<style>
    body { font-family: Arial; }
    table { border-collapse: collapse; }
    th { background: #333; color: white; }
</style>

<div style="display:flex; justify-content:space-between; margin-bottom:20px;">

    <!-- Gauche -->
    <div>
        <h3 style="margin:0;">EASYTRANSIT CAISSE</h3>
        <p style="margin:0;">BP : 1234</p>
        <p style="margin:0;">Tel : +242 06 000 0000</p>
        <p style="margin:0;">Email : contact@easytransit.com</p>
    </div>

    <!-- Droite -->
    <div style="text-align:right;">
        <h4 style="margin:0;">
            RÉPUBLIQUE GABONAISE
        </h4>
        <p style="margin:0;">Union - Travail - Justice</p>
    </div>

</div>

<hr />
<!-- TITRE CAISSE -->
<h2 style="text-align:center;">
    CAISSE : @Model.CaisseName
</h2>

<br />

<table border="1" width="100%" cellpadding="6">

    <thead>
        <tr>
            <th>Date</th>
            <th>Montant Initial</th>
            <th>Encaisse</th>
            <th>Décaisse</th>
            <th>Solde</th>
            <th>Statut</th>
        </tr>
    </thead>

    <tbody>

    @foreach(var j in Model.Journees)
    {
        <tr>
            <td>@j.DateJournee.ToString("dd/MM/yyyy")</td>
            <td>@j.SoldeInitial</td>
            <td>@j.Encaisse</td>
            <td>@j.Decaisse</td>
            <td>@j.Solde</td>
            <td>@j.Statut</td>
        </tr>
    }

    </tbody>

    @{
        var totalSoldeInitial = Model.Journees.Sum(j => j.SoldeInitial);
        var totalEncaisse = Model.Journees.Sum(j => j.Encaisse);
        var totalDecaisse = Model.Journees.Sum(j => j.Decaisse);
        var soldeActuel = totalSoldeInitial + totalEncaisse - totalDecaisse;
    }

    <tfoot>
        <tr style="font-weight:bold; background:#eee;">
            <td>Totaux</td>
            <td>@totalSoldeInitial.ToString("N0")</td>
            <td>@totalEncaisse.ToString("N0")</td>
            <td>@totalDecaisse.ToString("N0")</td>
            <td>@soldeActuel.ToString("N0")</td>
            <td></td>
        </tr>
    </tfoot>

</table>
