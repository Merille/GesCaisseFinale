@model EasytransitCaisse.Models.ViewModels.PrintJourneesVM
@{
    Layout = "_ImpressionLayout";
    ViewData["Pdf"] = true;
    ViewData["Republique"] = true;
    ViewData["TitreImpression"] = "Journées " + Model.CaisseCode;
    decimal ti = 0, te = 0, td = 0;
}
<h1>Journées de caisse — @Model.CaisseName</h1>
<table>
    <tr><th>Date</th><th>N° journée</th><th class="r">Solde initial</th><th class="r">Encaissé</th><th class="r">Décaissé</th><th class="r">Solde</th><th>Statut</th></tr>
    @foreach (var j in Model.Journees)
    {
        ti += j.SoldeInitial; te += j.Encaisse; td += j.Decaisse;
        <tr>
            <td>@j.DateJournee.ToString("dd/MM/yyyy")</td>
            <td>@j.NumeroJournee</td>
            <td class="r">@j.SoldeInitial.ToString("N0")</td>
            <td class="r">@j.Encaisse.ToString("N0")</td>
            <td class="r">@j.Decaisse.ToString("N0")</td>
            <td class="r">@j.Solde.ToString("N0")</td>
            <td>@(j.Statut == "Ouverte" ? "Ouverte" : "Clôturée")</td>
        </tr>
    }
    <tr class="total"><td colspan="2">Total</td><td class="r">@ti.ToString("N0")</td><td class="r">@te.ToString("N0")</td><td class="r">@td.ToString("N0")</td><td class="r">@((ti + te - td).ToString("N0"))</td><td></td></tr>
</table>
<p class="muted">Les opérations rejetées sont exclues des montants.</p>
