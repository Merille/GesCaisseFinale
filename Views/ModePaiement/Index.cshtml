@model List<EasytransitCaisse.Models.ModePaiement>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        ✅ @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Liste des Modes de paiement</h3>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCreate">
            + Nouveau mode de paiement
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table id="modesPaiementTable" class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Code</th>
                        <th>Libellé</th>
                        <th>Statut</th>
                        <th width="180">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td>@m.Code</td>
                            <td>@m.Libelle</td>
                            <td>
                                @if (m.Actif)
                                {
                                    <span class="badge bg-success">Actif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactif</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-warning btn-sm"
                                            onclick="ouvrirEdit(@m.Id, '@m.Code', '@m.Libelle', @(m.Actif ? "true" : "false"))">
                                        Modifier
                                    </button>
                                    <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Supprimer ce mode de paiement ?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            Supprimer
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL CREATE -->
<div class="modal fade" id="modalCreate" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-brand text-white">
                <h5 class="modal-title">Nouveau mode de paiement</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="Create" asp-controller="ModePaiement">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Code</label>
                        <input name="Code" class="form-control" placeholder="Ex: ESP" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Libellé</label>
                        <input name="Libelle" class="form-control" placeholder="Ex: Espèces" />
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="true"
                               name="Actif" id="createActif" checked>
                        <input type="hidden" name="Actif" value="false" />
                        <label class="form-check-label" for="createActif">Actif</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-success">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL EDIT -->
<div class="modal fade" id="modalEdit" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-brand text-white">
                <h5 class="modal-title">Modifier le mode de paiement</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-action="Edit" asp-controller="ModePaiement">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editId" name="Id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Code</label>
                        <input id="editCode" name="Code" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Libellé</label>
                        <input id="editLibelle" name="Libelle" class="form-control" />
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="true"
                               name="Actif" id="editActif">
                        <input type="hidden" name="Actif" value="false" />
                        <label class="form-check-label" for="editActif">Actif</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-success">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function ouvrirEdit(id, code, libelle, actif) {
            document.getElementById('editId').value = id;
            document.getElementById('editCode').value = code;
            document.getElementById('editLibelle').value = libelle;
            document.getElementById('editActif').checked = actif;

            new bootstrap.Modal(document.getElementById('modalEdit')).show();
        }

        $(document).ready(function() {
            $('#modesPaiementTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/fr-FR.json'
                },
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                order: [[0, 'asc']],
                columnDefs: [
                    { orderable: false, targets: 3 }
                ],
                dom: '<"d-flex justify-content-between align-items-center mb-3"lf>rtip'
            });
        });
    </script>
}
