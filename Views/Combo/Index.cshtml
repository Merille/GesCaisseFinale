@model List<EasytransitCaisse.Models.Combo>
@{
    ViewData["Title"] = "Combos";
    var choix = (Dictionary<int, string>)ViewBag.Choix;
    var produits = (Dictionary<int, List<string>>)ViewBag.Produits;
    // Données du bouton « Modifier » : la fenêtre modale sert aussi à la modification.
    var edition = Model.ToDictionary(c => c.Id, c => System.Text.Json.JsonSerializer.Serialize(new
    {
        id = c.Id, action = "/Combo/Save", nom = c.Nom, quantite = c.Quantite,
        choix = c.Choix.OrderBy(x => x.Ordre).ThenBy(x => x.Id).Select(x => new { produitId = x.ProduitId, supplement = x.Supplement })
    }));
}


<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Combos</h4>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCombo"><i class="fas fa-plus"></i> Nouveau combo</button>
</div>
<p class="small text-muted">
    Comme dans Odoo, un combo regroupe les produits proposés au choix (ex. <strong>Plats</strong> : Poulet, Poisson + 500 ;
    <strong>Boissons</strong> : Coca, Eau). Un produit combo (ex. <strong>Menu midi</strong>) se compose ensuite de plusieurs combos, choisis sur sa fiche
    (Configuration › Produits). À la caisse, le serveur choisit un article dans chaque combo.
</p>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr><th>Combo</th><th class="text-center">À choisir</th><th>Produits proposés</th><th>Utilisé dans</th><th class="text-center">Actions</th></tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Aucun combo. Créez-en un, par exemple « Plats » ou « Boissons ».</td></tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.Nom</td>
                        <td class="text-center">@c.Quantite</td>
                        <td>@choix[c.Id]</td>
                        <td>
                            @if (produits[c.Id].Any())
                            {
                                @string.Join(", ", produits[c.Id])
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="d-inline-flex gap-1">
                                <a href="/Combo/Edit/@c.Id" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#modalCombo"
                                   data-combo="@edition[c.Id]">Modifier</a>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Supprimer ce combo ?')">
                                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="modalCombo" tabindex="-1" aria-labelledby="comboTitre" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <form class="modal-content" method="post" action="/Combo/Save">
            <div class="modal-header bg-brand text-white">
                <h5 class="modal-title" id="comboTitre">Nouveau combo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="0" />
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label" for="Nom">Nom du combo</label>
                        <input class="form-control" id="Nom" name="Nom" maxlength="50" placeholder="Ex : Plats, Boissons, Desserts" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="Quantite">Articles à choisir</label>
                        <input class="form-control" id="Quantite" name="Quantite" type="number" min="1" max="10" value="1" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Produits proposés</label>
                        <input type="hidden" name="choix" id="combo-json" />
                        <div id="combo-editeur"></div>
                        <script id="combo-donnees" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize((object)ViewBag.Donnees))</script>
                        <div class="form-text">Le supplément s'ajoute au prix du produit combo quand ce produit est choisi.</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/combo.js" asp-append-version="true"></script>
}
